#!/usr/bin/env bash
#
# Per-Mac choices. macos/local.sh is shared between the Macs through the
# private repo (dotfiles private), so anything that differs per Mac lives here
# instead:
#
#   cp macos/machine.local.sh.example macos/machine.local.sh
#
# macos/machine.local.sh is gitignored and never linked or synced. Sourced,
# never executed.

# Which launcher this Mac uses: tinycast (the default) or raycast. Read by
# `dotfiles install --packages` (which cask) and `dotfiles configure` (whether
# to set Tinycast's Cmd-Space). The environment wins over this file, which wins
# over macos/local.sh.
DOTFILES_LAUNCHER="raycast"

# This Mac's name; also sets LocalHostName, HostName and the SMB NetBIOS name.
# Set it here rather than in macos/local.sh, which both Macs share.
# DOTFILES_COMPUTER_NAME="my-mac"
