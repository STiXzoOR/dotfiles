#!/usr/bin/env bash
#
# Pre-commit hook for the dotfiles repository.
#
# For every staged file: a syntax check in the dialect the file declares, a
# lint pass with shellcheck for bash files, and a credential scan. gitleaks is
# the primary secret detector when installed; the pattern list below is the
# fallback. `--print-secret-patterns` prints exactly what that fallback uses,
# so the test suite exercises the real thing rather than a copy of it.
#
# Bash 3.2 (macOS /bin/bash): no mapfile, no associative arrays. Never
# `((x++))` -- it returns 1 when the old value was 0, which under errexit on
# bash 4.4+ aborts the hook and silently skips every later check.

set -uo pipefail

#############################################################################
# Secret patterns
#############################################################################

# One extended regular expression per line, matched case-SENSITIVELY.
#
# The previous list matched nothing real: `password.*=.*['"]` and friends all
# required a quote after `=`, which no token assignment has, while
# case-insensitive `PRIVATE.KEY` fired on prose such as "server private key
# (string)" in a tracked config file. False positives are not free -- they
# train people into `--no-verify`. These are prefix-anchored credential
# formats instead, so a hit is worth stopping for.
secret_patterns() {
  cat << 'PATTERNS'
AKIA[0-9A-Z]{16}
gh[pousr]_[A-Za-z0-9]{36}
github_pat_[A-Za-z0-9_]{60,}
sk-ant-[A-Za-z0-9_-]{24,}
sk-proj-[A-Za-z0-9_-]{24,}
sk-[A-Za-z0-9]{32,}
sk_live_[0-9A-Za-z]{16,}
xox[baprse]-[0-9A-Za-z-]{12,}
eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}
glpat-[A-Za-z0-9_-]{20,}
AIza[0-9A-Za-z_-]{35}
-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----
PATTERNS
}

case "${1:-}" in
  --print-secret-patterns)
    secret_patterns
    exit 0
    ;;
esac

#############################################################################
# Setup
#############################################################################

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
NC=$'\033[0m'

SHELLCHECK_EXCLUDES='SC1090,SC1091,SC2034,SC2119,SC2154'

ERRORS=0
err() {
  printf '%s✗ %s%s\n' "$RED" "$1" "$NC"
  ERRORS=$((ERRORS + 1))
}
warn() { printf '%s⚠ %s%s\n' "$YELLOW" "$1" "$NC"; }
ok() { printf '%s✓ %s%s\n' "$GREEN" "$1" "$NC"; }

echo "Running pre-commit checks..."

# NUL-delimited. Read as a plain string, any staged path containing a space
# was word-split into fragments and then silently skipped by every check.
STAGED=()
while IFS= read -r -d '' file; do
  STAGED+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -z)

#############################################################################
# Shell dialect detection
#############################################################################

# Both syntax checks and the shellcheck pass used to carry hardcoded file
# lists, which silently went stale: bin/plistbuddy is zsh and was missing from
# the exclusion list, so it got `bash -n`; scripts/lib/, tests/ and claude/
# matched no allowlist arm at all and were checked by nothing. Ask the file.
#
# Prints: zsh | bash | none
shell_dialect() {
  local file="$1" first directive
  [[ -f "$file" ]] || {
    echo none
    return
  }

  # A shebang settles it. Match on the `#!` prefix rather than on the word
  # anywhere in line 1: a file whose opening comment merely mentions bash is
  # not thereby a bash script.
  first=$(head -1 "$file" 2> /dev/null)
  if [[ "$first" == '#!'* ]]; then
    case "$first" in
      *zsh*) echo zsh ;;
      *bash* | *"/bin/sh"*) echo bash ;;
      *) echo none ;;
    esac
    return
  fi

  # No shebang. A `shellcheck shell=` directive is the file's own
  # declaration; sourced fragments such as tests/lib.sh carry one.
  directive=$(head -20 "$file" 2> /dev/null | grep -m1 'shellcheck shell=')
  case "$directive" in
    *shell=bash*)
      echo bash
      return
      ;;
    *shell=zsh*)
      echo zsh
      return
      ;;
  esac

  # Otherwise: dotfiles under runcom/ and system/ are zsh fragments, since
  # the zsh startup files source them.
  case "$file" in
    runcom/.* | system/.*) echo zsh ;;
    *) echo none ;;
  esac
}

#############################################################################
# Syntax
#############################################################################

check_syntax() {
  local file dialect have_zsh=1
  command -v zsh > /dev/null 2>&1 || have_zsh=0

  local announced=0
  for file in "${STAGED[@]}"; do
    dialect=$(shell_dialect "$file")
    [[ "$dialect" == "none" ]] && continue
    if [[ "$dialect" == "zsh" && "$have_zsh" -eq 0 ]]; then
      warn "zsh not installed, skipping zsh syntax check for $file"
      continue
    fi
    if [[ "$announced" -eq 0 ]]; then
      echo "Checking shell syntax..."
      announced=1
    fi
    if [[ "$dialect" == "zsh" ]]; then
      zsh -n "$file" 2> /dev/null || err "Syntax error: $file"
    else
      bash -n "$file" 2> /dev/null || err "Syntax error: $file"
    fi
  done
}

#############################################################################
# Shellcheck
#############################################################################

check_shellcheck() {
  if ! command -v shellcheck > /dev/null 2>&1; then
    warn "shellcheck not installed, skipping lint"
    return 0
  fi

  local file announced=0
  for file in "${STAGED[@]}"; do
    [[ "$(shell_dialect "$file")" == "bash" ]] || continue
    if [[ "$announced" -eq 0 ]]; then
      echo "Checking bash scripts with shellcheck..."
      announced=1
    fi
    if shellcheck -e "$SHELLCHECK_EXCLUDES" -s bash "$file"; then
      ok "$file"
    else
      err "Shellcheck failed: $file"
    fi
  done
}

#############################################################################
# Secrets
#############################################################################

# Only files that must contain credential-shaped text are exempt: this hook,
# which defines the patterns, and the generator that produces fake ones for
# the tests. The secrets tool and the test runner used to be exempt wholesale,
# so the two files most likely to hold a real secret were the two nobody
# scanned.
scan_exempt() {
  case "$1" in
    .githooks/pre-commit | tests/fixtures/make-secrets.sh) return 0 ;;
    *) return 1 ;;
  esac
}

check_secrets() {
  echo "Checking for potential secrets..."

  if command -v gitleaks > /dev/null 2>&1; then
    local out rc
    out=$(gitleaks protect --staged --redact --no-banner 2>&1)
    rc=$?
    if [[ "$rc" -ne 0 ]]; then
      err "gitleaks found a credential in the staged changes"
      printf '%s\n' "$out" | sed 's/^/  /'
      return 0
    fi
    ok "gitleaks: clean"
    return 0
  fi

  warn "gitleaks not installed, falling back to the built-in patterns"
  local file pattern
  for file in "${STAGED[@]}"; do
    scan_exempt "$file" && continue
    [[ -f "$file" ]] || continue
    while IFS= read -r pattern; do
      [[ -n "$pattern" ]] || continue
      if grep -aqE "$pattern" "$file" 2> /dev/null; then
        err "Potential secret found in: $file"
        echo "  Pattern: $pattern"
      fi
    done < <(secret_patterns)
  done
}

#############################################################################
# Main
#############################################################################

if [[ "${#STAGED[@]}" -eq 0 ]]; then
  echo "No staged files to check."
  exit 0
fi

check_syntax
check_shellcheck
check_secrets

if [[ "$ERRORS" -gt 0 ]]; then
  echo ""
  printf '%sPre-commit check failed with %d error(s)%s\n' "$RED" "$ERRORS" "$NC"
  echo "Fix the issues above and try again."
  echo "To skip this check (not recommended): git commit --no-verify"
  exit 1
fi

printf '%sAll pre-commit checks passed!%s\n' "$GREEN" "$NC"
exit 0
