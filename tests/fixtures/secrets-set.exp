#!/usr/bin/env expect
#
# Drives `dotfiles-secrets set <name>` with no value, over a pseudo-terminal.
#
# That path is the whole point of the tool's design -- `security -w` placed
# last so the OS prompts and the plaintext never enters any argv -- and it is
# unreachable without a terminal, so nothing tested it before.
#
# Usage: secrets-set.exp <sandbox> <keychain|-> <name> <value> [confirm]
# <confirm> defaults to <value>; pass a different one to exercise the
# mismatch path that security itself owns.
# Exits with the tool's own status, or 90 if a prompt never arrived.
set timeout 20
set box  [lindex $argv 0]
set kc   [lindex $argv 1]
set name [lindex $argv 2]
set val  [lindex $argv 3]
set conf [lindex $argv 4]
if {$conf eq ""} { set conf $val }

set env(PATH) "$box/bin:$env(PATH)"
set env(DOTFILES_SECURITY_STUB_DIR) "$box/store"
if {$kc eq "-"} {
  unset -nocomplain env(DOTFILES_KEYCHAIN)
} else {
  set env(DOTFILES_KEYCHAIN) $kc
}

spawn -noecho ./bin/dotfiles-secrets set $name

# The tool may refuse before prompting; that is an outcome the caller asserts
# on, so eof exits with the tool's own status instead of the timeout code.
expect {
  -re {(?i)(password data for new item|enter value for)} { send -- "$val\r" }
  eof { catch wait result; exit [lindex $result 3] }
  timeout { exit 90 }
}
expect {
  -re {(?i)(retype|confirm)} { send -- "$conf\r" }
  eof { catch wait result; exit [lindex $result 3] }
  timeout { exit 90 }
}

expect eof
catch wait result
exit [lindex $result 3]
