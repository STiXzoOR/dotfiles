#!/usr/bin/env expect
#
# Drives `dotfiles-secrets export` or `import` through its passphrase prompts
# over a pseudo-terminal, so the suite can round-trip a real encrypted file
# instead of only asserting things about the source.
#
# Usage: secrets-roundtrip.exp <export|import> <sandbox> <keychain|-> <file> <pass>
#
# <sandbox> is a directory holding bin/security (the stub) and store/. Putting
# it first on PATH is what keeps the spawned tool off the real keychain, so it
# is set here rather than left to the caller's environment.
#
# Exits with the tool's own status, or 90 if a prompt never arrived.
set timeout 60
set mode    [lindex $argv 0]
set box     [lindex $argv 1]
set kc      [lindex $argv 2]
set file    [lindex $argv 3]
set pass    [lindex $argv 4]

set env(PATH) "$box/bin:$env(PATH)"
set env(DOTFILES_SECURITY_STUB_DIR) "$box/store"
if {$kc eq "-"} {
  unset -nocomplain env(DOTFILES_KEYCHAIN)
} else {
  set env(DOTFILES_KEYCHAIN) $kc
}

spawn -noecho ./bin/dotfiles-secrets $mode $file

# age asks "Enter passphrase" then "Confirm passphrase"; the openssl fallback
# asks "Enter encryption password" then "Confirm". Import asks once. An eof
# here means the tool refused before prompting, which is a legitimate outcome
# the caller asserts on, so it is passed through rather than reported as 90.
expect {
  -re {(?i)(passphrase|password)} { send -- "$pass\r" }
  eof { catch wait result; exit [lindex $result 3] }
  timeout { exit 90 }
}
if {$mode eq "export"} {
  expect {
    -re {(?i)(confirm|again|retype)} { send -- "$pass\r" }
    eof { catch wait result; exit [lindex $result 3] }
    timeout { exit 90 }
  }
}

expect eof
catch wait result
exit [lindex $result 3]
