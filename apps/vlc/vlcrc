###############################################################################
# vlcrc -- only the settings this machine actually changes.
#
# VLC rewrites this file on exit and re-emits every default it knows as a
# comment, which is how the tracked copy reached 4,726 lines to carry 19
# real settings. Keeping it minimal means a VLC upgrade produces a diff
# someone can read. VLC fills in every omitted option with its default.
###############################################################################

[core] # core program
audio-filter=compressor
audio-resampler=any
vout=any
repeat=1
# 0: never fetch metadata for played media over the network. This file is
# public; the default of 1 shipped an outbound lookup to everyone cloning it.
metadata-network-access=0

[macosx] # Mac OS X interface
macosx-interfacestyle=1

[macosx] # Mac OS X OpenGL video output
glconv=any

[auhal] # HAL AudioUnit output
auhal-volume=128
auhal-audio-device=0

[compressor] # Dynamic range compressor
compressor-rms-peak=0.000000
compressor-attack=1.500000
compressor-release=300.000000
compressor-threshold=-10.000000
compressor-knee=1.000000
compressor-makeup-gain=20.000000

[avcodec] # FFmpeg audio/video decoder
avcodec-skiploopfilter=4

[subsdec] # Text subtitle decoder
subsdec-encoding=Windows-1253

[x264] # H.264/MPEG-4 Part 10/AVC encoder (x264)
sout-x264-preset=ultrafast
sout-x264-tune=film
