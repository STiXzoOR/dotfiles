#!/usr/bin/env bash
#
# dotfiles-sync - keep this Mac current with the other one
#
# Usage: dotfiles-sync [--scheduled]
#
# For the public repo and then the private companion repo:
#   - `git fetch`; fast-forward only, and only when the tracked files are clean
#     and the branch is behind. Never merge, rebase or stash.
#   - report what needs the owner, with the exact command: unpushed commits,
#     behind-but-dirty, diverged.
# When anything moved: `stow --restow` both packages, then `dotfiles private
# link`. Then the actions the change calls for:
#   mise install               when config/mise/ changed
#   brew bundle install        when Brewfile / Brewfile.local are not satisfied
#   install --claude / --codex when claude/ or codex/ changed
# Interactively each one is offered (confirm). `secrets.age` changing upstream
# is only reported: importing prompts for the age passphrase, so it is never
# automatic. Finally, packages installed here but declared in neither the
# public nor the private lists are listed, each with the line to add.
#
# --scheduled (the daily LaunchAgent): logs to ~/Library/Logs/dotfiles-sync.log,
# never prompts, never runs sudo, never installs or upgrades anything (no
# `brew bundle`/`brew install`, no `mise install`), and posts ONE macOS
# notification, only when something needs the owner. The read-only package
# queries for the drift report (`brew leaves`, `brew list --cask`, `mas list`,
# `code --list-extensions`) do run; pending installs are remembered in
# ~/.local/state/dotfiles/sync-pending until an interactive run does them.
# With the Jev `drift` point not off, undeclared packages, changed macOS
# defaults and unmanaged ~/.config dirs are also classified (one batched request
# per kind); `on` offers the pre-filled line behind a strict prompt (a terminal
# and a typed y; DOTFILES_YES does not answer it), nothing is ever written
# unconfirmed, committed, uninstalled or moved. See docs/agents/jev.md.
#
# Bash 3.2 (macOS /bin/bash): no mapfile, no associative arrays, and never
# `((x++))`. GNU tools are not on PATH under launchd, so only BSD-safe flags.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$SELF_DIR/.." && pwd)}"
PRIVATE_DIR="${DOTFILES_PRIVATE_DIR:-$HOME/.dotfiles-private}"
DOTFILES_BIN="${DOTFILES_BIN:-$SELF_DIR/dotfiles}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
PENDING_FILE="$STATE_DIR/sync-pending"
LOG="${DOTFILES_SYNC_LOG:-$HOME/Library/Logs/dotfiles-sync.log}"
JEV_BIN="${DOTFILES_JEV_BIN:-$SELF_DIR/dotfiles-jev}"
APPS_BIN="${DOTFILES_APPS_BIN:-$SELF_DIR/dotfiles-apps}"

export DOTFILES_DIR DOTFILES_PRIVATE_DIR="$PRIVATE_DIR"

# launchd's PATH is /usr/bin:/bin:/usr/sbin:/sbin. Homebrew goes first, but
# only when brew is not already resolvable, so an interactive shell (and a
# test with stubs) keeps its own order. The mise shims come last.
if ! command -v brew >/dev/null 2>&1; then
  PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="$PATH:$HOME/.local/share/mise/shims" ;;
esac
export PATH

# shellcheck source=../scripts/echos.sh
source "$SELF_DIR/../scripts/echos.sh"
# shellcheck source=../scripts/lib/lists.sh
source "$SELF_DIR/../scripts/lib/lists.sh"
# shellcheck source=../scripts/lib/fs.sh
source "$SELF_DIR/../scripts/lib/fs.sh"
# shellcheck source=../scripts/lib/machine.sh
source "$SELF_DIR/../scripts/lib/machine.sh"
# shellcheck source=../scripts/lib/jev.sh
source "$SELF_DIR/../scripts/lib/jev.sh"

SCHEDULED=0
ATTN=""    # one line per thing that needs the owner
CHANGED="" # "<repo>|<path>" for every file a fast-forward brought in
MOVED=0
PENDING="" # actions still to do: mise brew claude codex
FAILED=0

say() { printf '%s\n' "$*"; }
attn() { ATTN="${ATTN}$1"$'\n'; }

usage() {
  cat <<'USAGE'
Usage: dotfiles sync [--scheduled]

  Fetch the public and private repos, fast-forward what is safe, restow, and
  report (or, interactively, offer) what the change calls for.

  --scheduled   No prompts, no sudo, no installs; logs to
                ~/Library/Logs/dotfiles-sync.log and notifies once when
                something needs you.
USAGE
}

#############################################################################
# Git
#############################################################################

# changed <repo> <pattern>...: did the last fast-forward of <repo> touch a
# path matching one of the shell patterns?
changed() {
  local repo="$1" r p pat
  shift
  while IFS='|' read -r r p; do
    [ "$r" = "$repo" ] || continue
    for pat in "$@"; do
      # shellcheck disable=SC2254
      case "$p" in $pat) return 0 ;; esac
    done
  done <<EOF
$CHANGED
EOF
  return 1
}

# repo_dirty <label> <dir> <no|all>: porcelain status lines (untracked files
# only with "all"). In the private repo jev/apps-declined.list, which the app
# suggestions write and the owner commits when convenient, does not count:
# it must not stop a fast-forward or raise a notification by itself.
repo_dirty() {
  local u=no
  [ "$3" = all ] && u=all
  git -C "$2" status --porcelain --untracked-files="$u" 2>/dev/null |
    awk -v l="$1" '!(l == "private" && $0 ~ /^.. jev\/apps-declined\.list$/)'
}

# repo_sync <label> <dir>
repo_sync() {
  local label="$1" dir="$2" up counts ahead behind old new f
  say "== $label repo: $dir"

  if ! git -C "$dir" fetch -q 2>/dev/null; then
    # Offline is normal for a laptop: say so, do not notify.
    say "  could not fetch (offline, or no access); nothing compared"
    return 0
  fi
  if ! up=$(git -C "$dir" rev-parse --abbrev-ref '@{u}' 2>/dev/null); then
    say "  no upstream branch, nothing to compare (git -C \"$dir\" push -u origin <branch>)"
    return 0
  fi
  counts=$(git -C "$dir" rev-list --left-right --count "HEAD...$up")
  ahead=${counts%%[[:space:]]*}
  behind=${counts##*[[:space:]]}

  if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
    say "  diverged from $up: $ahead local commit(s), $behind upstream. Nothing was changed. Resolve it by hand:"
    say "    git -C \"$dir\" rebase $up    (replay your commits on top of upstream)"
    say "    git -C \"$dir\" merge $up     (or merge)"
    attn "$label repo has diverged from $up (git -C $dir rebase $up)"
  elif [ "$behind" -gt 0 ]; then
    if [ -n "$(repo_dirty "$label" "$dir" no)" ]; then
      say "  behind $up by $behind commit(s) but has uncommitted changes, so it was left alone."
      say "    Commit or discard them, then: git -C \"$dir\" pull --ff-only"
      attn "$label repo is behind but has local changes (commit them, then git -C $dir pull --ff-only)"
    else
      old=$(git -C "$dir" rev-parse HEAD)
      if git -C "$dir" merge --ff-only -q "$up" >/dev/null 2>&1; then
        new=$(git -C "$dir" rev-parse HEAD)
        say "  fast-forwarded $behind commit(s)"
        while IFS= read -r f; do
          [ -n "$f" ] && CHANGED="${CHANGED}${label}|${f}"$'\n'
        done <<EOF
$(git -C "$dir" diff --name-only "$old" "$new")
EOF
        MOVED=1
        # A moved submodule pointer (mode 160000) leaves the checkout behind
        # HEAD, which reads as dirty and blocks the next fast-forward. The
        # shallow setting in .gitmodules applies to this update as well.
        if git -C "$dir" diff --raw "$old" "$new" | awk '$1 == ":160000" || $2 == "160000" { found = 1 } END { exit !found }'; then
          say "  submodule pointer moved; updating submodules"
          git -C "$dir" submodule update --init --recursive -q >/dev/null 2>&1 ||
            attn "$label repo: submodules could not be updated (git -C $dir submodule update --init --recursive)"
        fi
      else
        say "  could not fast-forward; try: git -C \"$dir\" pull --ff-only"
        attn "$label repo could not be fast-forwarded (git -C $dir pull --ff-only)"
      fi
    fi
  elif [ "$ahead" -gt 0 ]; then
    say "  $ahead unpushed commit(s): git -C \"$dir\" push"
    attn "$label repo has $ahead unpushed commit(s) (git -C $dir push)"
  else
    say "  up to date with $up"
  fi

  # New files in the private repo are untracked, and untracked means they stay
  # on this Mac.
  if [ "$label" = private ] && [ -n "$(repo_dirty "$label" "$dir" all)" ]; then
    say "  uncommitted changes: they will not reach the other Mac until committed and pushed"
    attn "private repo has uncommitted changes"
  fi
}

#############################################################################
# After a change: restow and relink
#############################################################################

restow() {
  say "== restow"
  if ! command -v stow >/dev/null 2>&1; then
    say "  stow is not installed; run: dotfiles install --packages"
    attn "stow is missing, so the new files were not linked"
    return 0
  fi
  # Simulate both packages first: a conflict must not leave $HOME half-linked,
  # and this runs unattended. On a conflict nothing is touched.
  local out first
  if ! out=$(dotfiles_stow_all -n "$DOTFILES_DIR" "$HOME" "$XDG_CONFIG_HOME" 2>&1); then
    # The first line of stow's report is a generic "would cause conflicts";
    # the line that names the file is the useful one.
    first=$(printf '%s\n' "$out" | grep -m1 'cannot stow' | sed 's/^[ *]*//' || true)
    [ -n "$first" ] || first=$(printf '%s\n' "$out" | sed -n 1p)
    say "  stow would conflict; nothing was relinked: $first"
    say "  run: dotfiles link"
    attn "stow conflict: $first -- run dotfiles link"
    FAILED=1
  elif out=$(dotfiles_stow_all - "$DOTFILES_DIR" "$HOME" "$XDG_CONFIG_HOME" 2>&1); then
    say "  restowed runcom and config"
  else
    say "  stow reported a problem; run: dotfiles link"
    attn "stow failed while relinking (run dotfiles link)"
    FAILED=1
  fi
  if [ -d "$PRIVATE_DIR/.git" ]; then
    "$SELF_DIR/dotfiles-private" link || { attn "dotfiles private link failed"; FAILED=1; }
  fi
}

#############################################################################
# Pending actions
#############################################################################

pending_add() {
  case "$PENDING" in
    *"$1"$'\n'*) ;;
    *) PENDING="${PENDING}$1"$'\n' ;;
  esac
}
pending_has() { case "$PENDING" in *"$1"$'\n'*) return 0 ;; esac; return 1; }
pending_drop() {
  local out="" l
  while IFS= read -r l; do
    [ -n "$l" ] && [ "$l" != "$1" ] && out="${out}${l}"$'\n'
  done <<EOF
$PENDING
EOF
  PENDING="$out"
}
pending_save() {
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  printf '%s' "$PENDING" >"$PENDING_FILE" 2>/dev/null || true
}

collect_pending() {
  local l
  if [ -f "$PENDING_FILE" ]; then
    while IFS= read -r l; do
      case "$l" in mise | brew | claude | codex) pending_add "$l" ;; esac
    done <"$PENDING_FILE"
  fi
  if changed public 'config/mise/*'; then pending_add mise; fi
  if changed public 'Brewfile' || changed private 'Brewfile.local'; then pending_add brew; fi
  if changed public 'claude/*' || changed private 'claude/*'; then pending_add claude; fi
  if changed public 'codex/*' || changed private 'codex/*'; then pending_add codex; fi
  if changed private 'secrets.age'; then
    say "secrets.age changed upstream: run 'dotfiles secrets import $PRIVATE_DIR/secrets.age' (it asks for the age passphrase, so sync never does it)"
    attn "secrets.age changed: run dotfiles secrets import"
  fi
}

brewfiles() {
  local f
  for f in "$DOTFILES_DIR/Brewfile" "$DOTFILES_DIR/Brewfile.local"; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
}

# Interactive only: is the Brewfile satisfied on this Mac right now?
brew_unsatisfied() {
  local f rc=1
  command -v brew >/dev/null 2>&1 || return 1
  dotfiles_export_launcher "$DOTFILES_DIR"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    brew bundle check --file="$f" >/dev/null 2>&1 || { printf '%s\n' "$f"; rc=0; }
  done <<EOF
$(brewfiles)
EOF
  return "$rc"
}

run_action() { # run_action <name> <description> <command...>
  local name="$1" desc="$2"
  shift 2
  if confirm "Run: $desc?"; then
    if "$@"; then
      pending_drop "$name"
    else
      say "  $desc failed"
      attn "$desc failed"
      FAILED=1
    fi
  else
    say "  skipped: $desc (still pending)"
  fi
}

install_brew_bundle() {
  local f rc=0
  dotfiles_export_launcher "$DOTFILES_DIR"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    brew bundle install --file="$f" || rc=1
  done <<EOF
$(brew_unsatisfied)
EOF
  return "$rc"
}

do_pending() {
  say "== pending actions"
  # Interactively the Brewfiles themselves are the truth: satisfied means
  # nothing to do (whatever an earlier run remembered), unsatisfied means offer
  # it. Scheduled never runs `brew bundle`, so it goes by what changed.
  if [ "$SCHEDULED" -eq 0 ] && command -v brew >/dev/null 2>&1; then
    if brew_unsatisfied >/dev/null; then pending_add brew; else pending_drop brew; fi
  fi
  if [ -z "$PENDING" ]; then
    say "  none"
    return 0
  fi

  local name desc cmd
  for name in mise brew claude codex; do
    pending_has "$name" || continue
    case "$name" in
      mise) desc="mise install (config/mise changed)"; cmd="mise install" ;;
      brew) desc="brew bundle install (the Brewfiles are not satisfied)"; cmd="brew bundle install --file=<Brewfile>" ;;
      claude) desc="dotfiles install --claude (claude/ changed)"; cmd="dotfiles install --claude" ;;
      codex) desc="dotfiles install --codex (codex/ changed)"; cmd="dotfiles install --codex" ;;
    esac
    if [ "$SCHEDULED" -eq 1 ]; then
      say "  pending: $cmd"
      attn "pending: $cmd"
      continue
    fi
    case "$name" in
      mise) run_action mise "$desc" mise install ;;
      brew) run_action brew "$desc" install_brew_bundle ;;
      claude) run_action claude "$desc" "$DOTFILES_BIN" install --claude ;;
      codex) run_action codex "$desc" "$DOTFILES_BIN" install --codex ;;
    esac
  done
  pending_save
}

#############################################################################
# Drift: installed here, declared nowhere
#############################################################################

declared_brewfile_names() { # declared_brewfile_names <kind>
  local f
  while IFS= read -r f; do
    [ -n "$f" ] && sed -n -E "s/^[[:space:]]*$1 \"([^\"]+)\".*/\\1/p" "$f"
  done <<EOF
$(brewfiles)
EOF
}

declared_mas_ids() {
  local f
  while IFS= read -r f; do
    [ -n "$f" ] && sed -n -E 's/^[[:space:]]*mas .*id:[[:space:]]*([0-9]+).*/\1/p' "$f"
  done <<EOF
$(brewfiles)
EOF
}

# in_list <needle> <newline list>: exact, case-insensitive match.
in_list() { printf '%s\n' "$2" | grep -qixF -- "$1"; }

report_drift() {
  say "== drift: installed on this Mac, declared in no list"
  local n=0 decl item base line id name
  drift_jev_setup

  if command -v brew >/dev/null 2>&1; then
    decl=$(declared_brewfile_names brew)
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      base=${item##*/}
      if ! in_list "$item" "$decl" && ! in_list "$base" "$decl"; then
        say "  brew \"$item\"      (add to Brewfile, or Brewfile.local for private ones)"
        [ "$DRIFT_JEV" -eq 1 ] && add_pkg_fact brew "$item"
        n=$((n + 1))
      fi
    done <<EOF
$(brew leaves --installed-on-request 2>/dev/null)
EOF
    decl=$(declared_brewfile_names cask)
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      base=${item##*/}
      if ! in_list "$item" "$decl" && ! in_list "$base" "$decl"; then
        say "  cask \"$item\"      (add to Brewfile, or Brewfile.local)"
        [ "$DRIFT_JEV" -eq 1 ] && add_pkg_fact cask "$item"
        n=$((n + 1))
      fi
    done <<EOF
$(brew list --cask -1 2>/dev/null)
EOF
  fi

  if command -v mas >/dev/null 2>&1; then
    decl=$(declared_mas_ids)
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      id=$(printf '%s' "$line" | awk '{ print $1 }')
      name=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//; s/[[:space:]]+\([^)]*\)[[:space:]]*$//')
      if [ -n "$id" ] && ! in_list "$id" "$decl"; then
        say "  mas \"$name\", id: $id      (add to Brewfile, or Brewfile.local)"
        [ "$DRIFT_JEV" -eq 1 ] && add_mas_fact "$id" "$name"
        n=$((n + 1))
      fi
    done <<EOF
$(mas list 2>/dev/null)
EOF
  fi

  local code_bin
  code_bin=$(command -v code || true)
  [ -n "$code_bin" ] || code_bin="${DOTFILES_CODE_BIN_FALLBACK:-/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code}"
  if [ -x "$code_bin" ]; then
    decl=$(read_list "$DOTFILES_DIR/packages" code)
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      if ! in_list "$item" "$decl"; then
        say "  $item      (add to packages/code.list, or packages/code.local.list)"
        [ "$DRIFT_JEV" -eq 1 ] && add_code_fact "$item"
        n=$((n + 1))
      fi
    done <<EOF
$("$code_bin" --list-extensions </dev/null 2>/dev/null)
EOF
  fi

  # Setapp apps: the folder is the truth, there is no CLI to list them. Not
  # sent to Jev (no facts for them).
  local setapp_dir app
  setapp_dir="${DOTFILES_SETAPP_APPS_DIR:-/Applications/Setapp}"
  if [ -d "$setapp_dir" ]; then
    decl=$(read_list "$DOTFILES_DIR/packages" setapp)
    for app in "$setapp_dir"/*.app; do
      [ -d "$app" ] || continue
      item=$(basename "$app" .app)
      if ! in_list "$item" "$decl"; then
        say "  $item      (add to packages/setapp.list, or packages/setapp.local.list)"
        n=$((n + 1))
      fi
    done
  fi

  if [ "$n" -eq 0 ]; then
    say "  none"
  else
    attn "$n installed package(s) are declared nowhere (dotfiles sync lists them)"
  fi
}

#############################################################################
# Drift, second half: Jev classifies what the report above only lists
#############################################################################
#
# Facts are computed here, in shell, and go to `dotfiles-jev drift <kind>` as
# one batched request per kind: installed packages (brew, casks, App Store, VS
# Code extensions), macOS defaults that read back differently from the last
# baseline snapshot, and directories under ~/.config the repo does not manage.
# Jev only picks a choice per item; the line offered is built here from the
# fact, never taken from Jev, only from a conservative character set, and an
# item Jev names that was not in the facts is ignored. A line is appended only
# after a STRICT prompt (a terminal and a typed y or yes; DOTFILES_YES does not
# answer it, so nothing model-chosen is ever written unattended). Nothing is
# committed, uninstalled or moved. Scheduled runs only notify. In shadow mode
# Jev is asked and logs, and nothing here acts. One failed request (no key,
# timeout, HTTP error) or a 401 stops the remaining kinds of this run.

DRIFT_SEEN="$STATE_DIR/drift-first-seen"
BASELINE_BIN="${DOTFILES_BASELINE_BIN:-$SELF_DIR/dotfiles-baseline}"
DRIFT_JEV=0    # 1 when Jev is to be asked (jq present, point not off)
DRIFT_MODE=off
DRIFT_PKG=""   # "key<TAB>facts" per undeclared package
DRIFT_LINES="" # "key<TAB>line<TAB>display" per package; line is "-" when unsafe to write
DRIFT_PKG_N=0
DRIFT_MAX="${JEV_DRIFT_MAX_ITEMS:-40}"
SHADOW_MAX=10
DRIFT_HEADER=0
DRIFT_SUGGESTED=0
DRIFT_ABORT=0
DRIFT_OUT=""
STRICT_FD_OPEN=0

drift_jev_setup() {
  DRIFT_JEV=0
  command -v jq >/dev/null 2>&1 || return 0
  DRIFT_MODE=$(jev_mode drift)
  [ "$DRIFT_MODE" = off ] && return 0
  [ -x "$JEV_BIN" ] || return 0
  # No key: every request would fail, so gather nothing.
  jev_key >/dev/null 2>&1 || return 0
  # Shadow results are never shown: keep the fact gathering small.
  if [ "$DRIFT_MODE" = shadow ] && [ "$DRIFT_MAX" -gt "$SHADOW_MAX" ]; then DRIFT_MAX=$SHADOW_MAX; fi
  DRIFT_JEV=1
}

# matches <regex> <string>: the string is non-empty and all of it fits.
matches() { [[ $2 =~ $1 ]]; }
RE_BREW='^[A-Za-z0-9@._+/-]+$'
RE_MAS_NAME="^[A-Za-z0-9 ._+&:'-]+\$"
RE_EXT='^[A-Za-z0-9][A-Za-z0-9-]*\.[A-Za-z0-9][A-Za-z0-9._-]*$'

# first_seen <key>: the date this item was first seen undeclared. Recorded
# now when new, so "how long has this been here" is a fact, not a guess.
first_seen() {
  local d
  d=$(awk -F'\t' -v k="$1" '$1 == k { print $2; exit }' "$DRIFT_SEEN" 2>/dev/null)
  if [ -z "$d" ]; then
    d=$(date +%Y-%m-%d)
    mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\t%s\n' "$1" "$d" >>"$DRIFT_SEEN" 2>/dev/null
  fi
  printf '%s' "$d"
}

one_line() { printf '%s' "$1" | tr '\t\n' '  ' | cut -c 1-160; }

# room_for_fact: false once JEV_DRIFT_MAX_ITEMS package facts are gathered, so
# brew is not asked about hundreds of items that would not be sent anyway.
room_for_fact() {
  [ "$DRIFT_PKG_N" -lt "$DRIFT_MAX" ] || return 1
  DRIFT_PKG_N=$((DRIFT_PKG_N + 1))
}

# record_pkg <key> <facts> <line-or-> <display>
record_pkg() {
  DRIFT_PKG="${DRIFT_PKG}$1"$'\t'"$2"$'\n'
  DRIFT_LINES="${DRIFT_LINES}$1"$'\t'"$3"$'\t'"$(one_line "$4")"$'\n'
}

# add_pkg_fact <brew|cask> <name>
add_pkg_fact() {
  local key="$1:$2" desc dep=no kind line=-
  room_for_fact || return 0
  if [ "$1" = cask ]; then
    kind=cask
    desc=$(brew desc --cask "$2" 2>/dev/null)
  else
    kind="brew formula"
    desc=$(brew desc "$2" 2>/dev/null)
    [ -n "$(brew uses --installed "$2" 2>/dev/null)" ] && dep=yes
  fi
  desc=$(one_line "$(printf '%s' "$desc" | sed 's/^[^:]*: *//')")
  matches "$RE_BREW" "$2" && line="$1 \"$2\""
  record_pkg "$key" "kind=$kind;${desc:+ description=$desc;} dependency=$dep; first seen $(first_seen "$key")" "$line" "$1 \"$2\""
}

add_mas_fact() { # add_mas_fact <id> <name>
  local key="mas:$1" line=-
  room_for_fact || return 0
  matches '^[0-9]+$' "$1" && matches "$RE_MAS_NAME" "$2" && line="mas \"$2\", id: $1"
  record_pkg "$key" "kind=App Store app \"$(one_line "$2")\"; dependency=no; first seen $(first_seen "$key")" "$line" "mas \"$2\", id: $1"
}

add_code_fact() { # add_code_fact <extension id>
  local key="code:$1" line=-
  room_for_fact || return 0
  matches "$RE_EXT" "$1" && line="$1"
  record_pkg "$key" "kind=VS Code extension; dependency=no; first seen $(first_seen "$key")" "$line" "$1"
}

# ask_jev <kind> <facts>: sets DRIFT_OUT to the SUGGEST lines Jev returns.
# A non-zero exit from dotfiles-jev drift (the request failed) sets DRIFT_ABORT
# so the remaining kinds are not asked. Interactive `on` gets a longer timeout
# than the 2 s default (a batch is bigger than one hunk); shadow keeps 2 s so
# a slow API never delays an interactive sync for a decision nobody acts on;
# scheduled uses the 10 s scheduled default.
ask_jev() {
  local t="" f rc
  [ "$SCHEDULED" -eq 0 ] && [ "$DRIFT_MODE" = on ] && t=6
  f=$(mktemp "${TMPDIR:-/tmp}/sync-drift.XXXXXX") || { DRIFT_OUT=""; return 0; }
  printf '%s' "$2" | JEV_SCHEDULED="$([ "$SCHEDULED" -eq 1 ] && echo 1)" JEV_TIMEOUT="${JEV_TIMEOUT:-$t}" "$JEV_BIN" drift "$1" >"$f" 2>/dev/null
  rc=$?
  DRIFT_OUT=$(cat "$f")
  rm -f "$f"
  [ "$rc" -eq 0 ] || DRIFT_ABORT=1
  return 0
}

drift_header() {
  [ "$DRIFT_HEADER" -eq 1 ] && return 0
  DRIFT_HEADER=1
  say "== drift: what Jev suggests (nothing is written until you confirm)"
}

# strict_confirm <prompt>: yes only from a person. It needs a terminal and a
# typed y or yes, and ignores DOTFILES_YES, which answers the ordinary
# confirm. The test harness (tests/lib.sh) may script the answers, but only
# with no terminal, inside its own marked sandbox and from a file under it.
strict_confirm() {
  strict_answer "$1" && return 0
  return 1
}

# strict_answer <prompt>: strict_confirm's answer in three states, for a caller
# that remembers a "no": 0 an explicit yes, 1 an explicit no (n, no), 2 nothing
# was decided (end of input, an empty line, anything else, no terminal).
strict_answer() {
  local a
  if [ ! -t 0 ] && scripted_answers_ok; then
    if [ "$STRICT_FD_OPEN" -eq 0 ]; then
      exec 4<"$DOTFILES_STRICT_ANSWERS" || return 2
      STRICT_FD_OPEN=1
    fi
    read -r a <&4 || return 2
  elif have_terminal; then
    read -r -p "$1 [y|N] " a <&5 || return 2
  else
    return 2
  fi
  case "$a" in
    [yY] | [yY]es | YES) return 0 ;;
    [nN] | [nN]o | NO) return 1 ;;
  esac
  return 2
}

# have_terminal: fd 5 is the terminal captured at the start of an interactive
# run. The prompts sit inside `while read ... <<EOF` loops, where stdin is the
# heredoc, so they must read the captured fd. A scheduled run never has one.
have_terminal() { [ -t 5 ] 2>/dev/null; }

scripted_answers_ok() {
  local root="${DOTFILES_TEST_SANDBOX:-}" f="${DOTFILES_STRICT_ANSWERS:-}"
  case "$root" in /?*) ;; *) return 1 ;; esac
  case "$f" in "$root"/*) ;; *) return 1 ;; esac
  case "/$f/" in */../*) return 1 ;; esac
  [ -f "$f" ]
}

close_strict_answers() {
  [ "$STRICT_FD_OPEN" -eq 1 ] || return 0
  exec 4<&-
  STRICT_FD_OPEN=0
}

# append_line <file> <line>: never twice, and never onto an unterminated line.
append_line() {
  local f="$1"
  grep -qxF -- "$2" "$f" 2>/dev/null && return 0
  if [ -s "$f" ] && [ "$(tail -c 1 "$f" | wc -l | tr -d ' ')" -eq 0 ]; then
    printf '\n' >>"$f"
  fi
  printf '%s\n' "$2" >>"$f"
}

suggested() { drift_header; DRIFT_SUGGESTED=$((DRIFT_SUGGESTED + 1)); }

# offer_line <choice-label> <line> <file> <what>: show it, and only after a
# strict yes on a terminal append it.
offer_line() {
  local label="$1" line="$2" file="$3" what="$4"
  suggested
  say "  Jev suggests $label: $line      (add to $what)"
  [ "$SCHEDULED" -eq 1 ] && return 0
  if strict_confirm "Add $line to $what?"; then
    append_line "$file" "$line" && say "    added to $what (not committed)"
  else
    say "    not added"
  fi
}

by_hand() { # by_hand <choice> <display> <why>
  suggested
  say "  Jev suggests $1: $2      (add by hand: $3)"
}

drift_pkg() {
  local tag key choice p c rec line display name
  [ -n "$DRIFT_PKG" ] || return 0
  ask_jev pkg "$DRIFT_PKG"
  [ "$DRIFT_MODE" = on ] || return 0
  while IFS=$'\t' read -r tag key choice p c; do
    [ "$tag" = SUGGEST ] || continue
    rec=$(printf '%s' "$DRIFT_LINES" | awk -F'\t' -v k="$key" '$1 == k { print; exit }')
    [ -n "$rec" ] || continue
    IFS=$'\t' read -r _ line display <<EOF
$rec
EOF
    case "$choice" in
      public | private)
        if [ "$line" = - ]; then
          by_hand "$choice" "$display" "the name has characters that are not safe to write into a list file"
          continue
        fi
        case "$key" in
          code:*)
            if [ "$choice" = public ]; then offer_line public "$line" "$DOTFILES_DIR/packages/code.list" packages/code.list
            else offer_line private "$line" "$DOTFILES_DIR/packages/code.local.list" packages/code.local.list; fi
            ;;
          *)
            if [ "$choice" = public ]; then offer_line public "$line" "$DOTFILES_DIR/Brewfile" Brewfile
            else offer_line private "$line" "$DOTFILES_DIR/Brewfile.local" Brewfile.local; fi
            ;;
        esac
        ;;
      ignore)
        suggested
        say "  Jev suggests ignore: $display      (an experiment, a dependency or transient; nothing to write)"
        ;;
      remove)
        suggested
        name=${key#*:}
        if [ "$line" = - ]; then
          say "  Jev suggests remove (two calls agreed): $display      (remove it by hand)"
        else
          case "$key" in
            brew:*) say "  Jev suggests remove (two calls agreed): $display      (run yourself: brew uninstall $name)" ;;
            cask:*) say "  Jev suggests remove (two calls agreed): $display      (run yourself: brew uninstall --cask $name)" ;;
            code:*) say "  Jev suggests remove (two calls agreed): $display      (run yourself: code --uninstall-extension $name)" ;;
            *) say "  Jev suggests remove (two calls agreed): $display      (remove it by hand)" ;;
          esac
        fi
        ;;
    esac
  done <<EOF
$DRIFT_OUT
EOF
}

# defaults_line <domain> <key> <new value>: the `defaults write` line, typed by
# `defaults read-type`, or nothing when it cannot be written safely: domain,
# key and value are held to a conservative character set.
defaults_line() {
  local dom="$1" key="$2" val="$3" type k
  matches '^[A-Za-z0-9._-]+$' "$dom" || return 1
  matches '^[A-Za-z0-9._ -]+$' "$key" || return 1
  type=$(defaults read-type "$dom" "$key" 2>/dev/null | sed -n 's/^Type is //p')
  k="$key"
  case "$key" in *[!A-Za-z0-9._-]*) k="\"$key\"" ;; esac
  case "$type" in
    boolean)
      case "$val" in
        1 | true | YES) printf 'defaults write %s %s -bool true' "$dom" "$k" ;;
        0 | false | NO) printf 'defaults write %s %s -bool false' "$dom" "$k" ;;
        *) return 1 ;;
      esac
      ;;
    integer) matches '^-?[0-9]+$' "$val" || return 1; printf 'defaults write %s %s -int %s' "$dom" "$k" "$val" ;;
    float) matches '^-?[0-9]+(\.[0-9]+)?$' "$val" || return 1; printf 'defaults write %s %s -float %s' "$dom" "$k" "$val" ;;
    string)
      matches '^[A-Za-z0-9 ._/:+,@=-]+$' "$val" || return 1
      printf 'defaults write %s %s -string "%s"' "$dom" "$k" "$val"
      ;;
    *) return 1 ;;
  esac
}

drift_defaults() {
  local changed facts="" dom key old new k tag choice p c line vals="" n=0
  [ "$DRIFT_ABORT" -eq 0 ] || return 0
  changed=$("$BASELINE_BIN" changed 2>/dev/null) || true
  [ -n "$changed" ] || return 0
  while IFS=$'\t' read -r dom key old new; do
    [ -n "$dom" ] && [ -n "$key" ] || continue
    [ "$n" -lt "$DRIFT_MAX" ] || break
    n=$((n + 1))
    k="$dom $key"
    facts="${facts}${k}"$'\t'"setting=$k; was $(one_line "$old"); now $(one_line "$new"); first seen $(first_seen "defaults:$k")"$'\n'
    vals="${vals}${k}"$'\t'"$dom"$'\t'"$key"$'\t'"$new"$'\n'
  done <<EOF
$changed
EOF
  [ -n "$facts" ] || return 0
  ask_jev defaults "$facts"
  [ "$DRIFT_MODE" = on ] || return 0
  while IFS=$'\t' read -r tag k choice p c; do
    [ "$tag" = SUGGEST ] || continue
    dom=""
    IFS=$'\t' read -r _ dom key new <<EOF
$(printf '%s' "$vals" | awk -F'\t' -v k="$k" '$1 == k { print; exit }')
EOF
    [ -n "$dom" ] || continue
    case "$choice" in
      public | local-only)
        if line=$(defaults_line "$dom" "$key" "$new"); then
          if [ "$choice" = public ]; then
            offer_line public "$line" "$DOTFILES_DIR/macos/defaults.sh" macos/defaults.sh
          else
            # macos/local.sh is a link into the private repo shared by both
            # Macs and is sourced as variable assignments: appending would
            # dirty that tree. Show the line; the owner places it.
            suggested
            say "  Jev suggests local-only: $line      (place it by hand where this Mac's own settings live; sync writes nothing for local-only)"
          fi
        else
          by_hand "$choice" "$k" "a defaults write line that is safe to append could not be built"
        fi
        ;;
      transient)
        suggested
        say "  Jev suggests transient: $k      (application state or a one-off change; nothing to write)"
        ;;
    esac
  done <<EOF
$DRIFT_OUT
EOF
}

drift_config() {
  local facts="" d name n kb tag key choice p c count=0
  [ "$DRIFT_ABORT" -eq 0 ] || return 0
  [ -d "$XDG_CONFIG_HOME" ] || return 0
  for d in "$XDG_CONFIG_HOME"/*; do
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    name=${d##*/}
    [ -e "$DOTFILES_DIR/config/$name" ] && continue
    [ "$count" -lt "$DRIFT_MAX" ] || break
    count=$((count + 1))
    n=$(find "$d" -type f 2>/dev/null | wc -l | tr -d ' ')
    kb=$(du -sk "$d" 2>/dev/null | cut -f1)
    facts="${facts}${name}"$'\t'"directory ~/.config/$name; files=$n; size=${kb:-?} KB; first seen $(first_seen "config:$name")"$'\n'
  done
  [ -n "$facts" ] || return 0
  ask_jev config "$facts"
  [ "$DRIFT_MODE" = on ] || return 0
  while IFS=$'\t' read -r tag key choice p c; do
    [ "$tag" = SUGGEST ] || continue
    printf '%s' "$facts" | awk -F'\t' -v k="$key" '$1 == k { f = 1 } END { exit !f }' || continue
    suggested
    case "$choice" in
      capture)
        say "  Jev suggests capture: ~/.config/$key      (move it into the repo, then link: mv \"$XDG_CONFIG_HOME/$key\" \"$DOTFILES_DIR/config/$key\" && dotfiles link)"
        ;;
      ignore) say "  Jev suggests ignore: ~/.config/$key      (cache, state or application data; nothing to do)" ;;
    esac
  done <<EOF
$DRIFT_OUT
EOF
}

jev_drift() {
  [ "$DRIFT_JEV" -eq 1 ] || return 0
  # One run directory for all three kinds: the request cap and the 401 marker
  # span the whole sync run, and dotfiles-jev leaves a directory it was given.
  jev_init || return 0
  drift_pkg
  drift_defaults
  drift_config
  close_strict_answers
  jev_cleanup
  if [ "$DRIFT_SUGGESTED" -gt 0 ] && [ "$SCHEDULED" -eq 1 ]; then
    attn "Jev suggests $DRIFT_SUGGESTED drift item(s) to classify (run dotfiles sync)"
  fi
}

#############################################################################
# App-backup suggestions: apps mackup supports that nobody has decided on
#############################################################################
#
# `dotfiles-apps candidates` computes the facts in shell (mackup's paths,
# Setapp / App Store / direct build, sandbox container) for installed apps that
# mackup supports and that are neither allowlisted, ignored nor declined. They
# go to `dotfiles-jev apps` as ONE batched request per run. The name Jev is
# shown for must be one of the facts and fit a conservative character set; the
# text shown is built here, never taken from Jev. Nothing is written into the
# allowlist: an allowlisted app also needs a process line in processes.list
# (`dotfiles apps check` enforces it), so the owner adds both by hand. The one
# thing written is the owner's "no": the app's name goes on a list in the
# private repo (not committed) so it is not asked about again, and only after a
# STRICT prompt on a terminal. Shadow mode asks and logs and shows nothing;
# scheduled runs only notify. A failed drift request stops this too.

APPS_MODE=off
APPS_FACTS=""
APPS_SUGGESTED=0
APPS_MAX="${JEV_APPS_MAX_ITEMS:-25}"
RE_APP='^[a-z0-9][a-z0-9.+-]*$'

apps_declined_file() { printf '%s/jev/apps-declined.list' "$PRIVATE_DIR"; }

# apps_gather: APPS_FACTS = the candidate lines with a safe name, at most APPS_MAX.
apps_gather() {
  local line name n=0
  APPS_FACTS=""
  while IFS= read -r line; do
    [ "$n" -lt "$APPS_MAX" ] || break
    name=${line%%$'\t'*}
    matches "$RE_APP" "$name" || continue
    APPS_FACTS="${APPS_FACTS}${line}"$'\n'
    n=$((n + 1))
  done <<EOF
$(DOTFILES_APPS_DECLINED="$(apps_declined_file)" "$APPS_BIN" candidates 2>/dev/null)
EOF
  [ "$n" -gt 0 ]
}

# apps_decline <name>: remember the owner's "no" in the private repo.
apps_decline() {
  local f
  if [ ! -d "$PRIVATE_DIR" ]; then
    say "    not remembered (no private repo at $PRIVATE_DIR)"
    return 0
  fi
  f=$(apps_declined_file)
  mkdir -p "$(dirname "$f")" 2>/dev/null && append_line "$f" "$1" && say "    recorded in jev/apps-declined.list in the private repo (left uncommitted for you to commit)"
}

# apps_process <name>: the process name from the candidate facts (computed by
# dotfiles-apps from the bundle, never from Jev) when it fits the charset.
apps_process() {
  local p
  p=$(printf '%s' "$APPS_FACTS" | awk -F'\t' -v k="$1" '$1 == k { i = index($2, "; process="); if (i) print substr($2, i + 10); exit }')
  matches '^[A-Za-z0-9][A-Za-z0-9 ._+()-]*$' "$p" && printf '%s' "$p"
  return 0
}

# apps_offer <name> <choice>: show the suggestion; on a terminal (or the test
# seam) ask, and remember only an explicit decision that means "stop asking".
apps_offer() {
  local name="$1" choice="$2" proc rc
  if [ "$APPS_SUGGESTED" -eq 0 ]; then
    say "== apps: what Jev suggests (nothing is written except your no)"
  fi
  APPS_SUGGESTED=$((APPS_SUGGESTED + 1))
  case "$choice" in
    backup)
      proc=$(apps_process "$name")
      say "  Jev suggests backup: $name"
      say "    add to config/mackup/mackup.cfg under [applications_to_sync]:  $name"
      if [ -n "$proc" ]; then
        say "    add to config/mackup/processes.list:  $name|$proc"
      else
        say "    add its process name to config/mackup/processes.list by hand (app|process); dotfiles apps check needs both"
      fi
      ;;
    own-sync) say "  Jev suggests own-sync: $name      (the app syncs its own settings; nothing to back up)" ;;
    not-worth-it) say "  Jev suggests not-worth-it: $name      (little to lose; nothing to back up)" ;;
  esac
  [ "$SCHEDULED" -eq 1 ] && return 0
  # No terminal and no seam means nobody answered: that is not a "no".
  have_terminal || scripted_answers_ok || return 0
  case "$choice" in
    backup) strict_answer "Will you add $name to the mackup allowlist? (no: stop suggesting it)" ;;
    *) strict_answer "Agree? Stop suggesting $name" ;;
  esac
  rc=$?
  # backup: an explicit no declines. own-sync / not-worth-it: an explicit yes does.
  if [ "$rc" -eq 2 ]; then
    say "    not decided, will ask again"
  elif { [ "$choice" = backup ] && [ "$rc" -eq 1 ]; } || { [ "$choice" != backup ] && [ "$rc" -eq 0 ]; }; then
    apps_decline "$name"
  elif [ "$choice" != backup ]; then
    say "    kept: it may be suggested again"
  fi
}

# apps_ask: sets DRIFT_OUT to the SUGGEST lines Jev returns; a failed request
# sets DRIFT_ABORT. Timeouts as in ask_jev (6 s interactive `on`, 2 s shadow).
apps_ask() {
  local t="" f rc
  [ "$SCHEDULED" -eq 0 ] && [ "$APPS_MODE" = on ] && t=6
  f=$(mktemp "${TMPDIR:-/tmp}/sync-apps.XXXXXX") || { DRIFT_OUT=""; return 0; }
  printf '%s' "$APPS_FACTS" | JEV_SCHEDULED="$([ "$SCHEDULED" -eq 1 ] && echo 1)" JEV_TIMEOUT="${JEV_TIMEOUT:-$t}" "$JEV_BIN" apps >"$f" 2>/dev/null
  rc=$?
  DRIFT_OUT=$(cat "$f")
  rm -f "$f"
  # A failed request acts on nothing, whatever it printed.
  [ "$rc" -eq 0 ] || { DRIFT_ABORT=1; DRIFT_OUT=""; }
  return 0
}

jev_apps() {
  local tag key choice p c
  [ "$DRIFT_ABORT" -eq 0 ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  APPS_MODE=$(jev_mode apps)
  [ "$APPS_MODE" = off ] && return 0
  [ -x "$JEV_BIN" ] && [ -x "$APPS_BIN" ] || return 0
  jev_key >/dev/null 2>&1 || return 0
  if [ "$APPS_MODE" = shadow ] && [ "$APPS_MAX" -gt "$SHADOW_MAX" ]; then APPS_MAX=$SHADOW_MAX; fi
  apps_gather || return 0
  jev_init || return 0
  apps_ask
  jev_cleanup
  if [ "$APPS_MODE" = on ]; then
    while IFS=$'\t' read -r tag key choice p c; do
      [ "$tag" = SUGGEST ] || continue
      printf '%s' "$APPS_FACTS" | awk -F'\t' -v k="$key" '$1 == k { f = 1 } END { exit !f }' || continue
      matches "$RE_APP" "$key" || continue
      case "$choice" in backup | own-sync | not-worth-it) apps_offer "$key" "$choice" ;; esac
    done <<EOF
$DRIFT_OUT
EOF
  fi
  close_strict_answers
  if [ "$APPS_SUGGESTED" -gt 0 ] && [ "$SCHEDULED" -eq 1 ]; then
    attn "Jev suggests $APPS_SUGGESTED app(s) for settings backup (run dotfiles sync)"
  fi
}

#############################################################################
# The skip gate: should the daily run do its work at all?
#############################################################################
#
# Scheduled runs only. Facts are computed here in shell: upstream commits per
# repo and the paths they touch, the hash of the lockfiles, the hours since the
# last run (added by dotfiles-jev). A deterministic fact that work exists is
# passed as --work and always runs, with no request: upstream touching a
# package list, the lockfiles, claude/ codex/ or secrets.age; unpushed commits;
# actions still pending; a first run. Otherwise `dotfiles-jev skip sync` asks
# one question. Only its literal SKIP (`on` mode, P(useful) < 0.2, fewer than 3
# skips in a row) skips; a failure, a timeout or shadow mode runs the job.

SKIP_MAX_PATHS=30
SKIP_HASH=""

skip_upstream_facts() { # skip_upstream_facts <label> <dir>: appends to SKIP_FACTS / SKIP_WORK
  local label="$1" dir="$2" behind ahead all paths p fetch_ssh
  [ -d "$dir/.git" ] || return 0
  # A hung network must not stall the scheduled job: bound the connect and
  # abort a transfer that has all but stopped. A failed fetch is work: the
  # counts below would be stale, so the gate must not judge on them.
  fetch_ssh="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes} -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2"
  if ! GIT_SSH_COMMAND="$fetch_ssh" git -C "$dir" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=15 fetch --quiet 2>/dev/null; then
    SKIP_WORK="${SKIP_WORK}${label} fetch failed"$'\n'
    SKIP_FACTS="${SKIP_FACTS}${label} repo: fetch failed"$'\n'
  fi
  behind=$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null) || behind=0
  ahead=$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null) || ahead=0
  # The work scan sees the whole diff; only the copy sent as a fact is capped.
  all=$(git -C "$dir" diff --name-only 'HEAD..@{u}' 2>/dev/null)
  paths=$(printf '%s\n' "$all" | sed -n "1,${SKIP_MAX_PATHS}p" | paste -sd' ' -)
  SKIP_FACTS="${SKIP_FACTS}${label} repo: upstream commits since last run: ${behind}; unpushed commits: ${ahead}"$'\n'
  # Private file names can name clients or hosts: only the public repo's paths
  # leave the machine.
  [ -n "$paths" ] && [ "$label" = public ] && SKIP_FACTS="${SKIP_FACTS}${label} repo: paths touched upstream: ${paths}"$'\n'
  [ "$ahead" -gt 0 ] && SKIP_WORK="${SKIP_WORK}${label} repo has unpushed commits"$'\n'
  while IFS= read -r p; do
    case "$p" in
      Brewfile* | config/mise/* | *.lock | *lock*.json | packages/* | claude/* | codex/* | secrets.age)
        if [ "$label" = public ]; then
          SKIP_WORK="${SKIP_WORK}upstream ${label} commits touch ${p}"$'\n'
        else
          SKIP_WORK="${SKIP_WORK}upstream ${label} commits touch a package list, lockfile, claude/, codex/ or secrets"$'\n'
        fi
        break
        ;;
    esac
  done <<EOF
$all
EOF
  [ "$behind" -gt 0 ] && SKIP_WORK="${SKIP_WORK}${label} repo is behind upstream"$'\n'
}

skip_lock_hash() {
  { cat "$DOTFILES_DIR"/config/mise/mise.lock "$DOTFILES_DIR"/config/mise/locks/* "$DOTFILES_DIR"/Brewfile.lock.json 2>/dev/null; } | shasum | cut -d' ' -f1
}

skip_gate() {
  local out hash prev w
  SKIP_FACTS="" SKIP_WORK=""
  [ -x "$JEV_BIN" ] || return 0
  [ "$(jev_mode skip)" = off ] && return 0
  jev_key >/dev/null 2>&1 || return 0
  skip_upstream_facts public "$DOTFILES_DIR"
  skip_upstream_facts private "$PRIVATE_DIR"
  hash=$(skip_lock_hash)
  prev=$(cat "$STATE_DIR/skip-sync.lockhash" 2>/dev/null)
  SKIP_FACTS="${SKIP_FACTS}lockfile hash changed since last run: $([ "$hash" = "$prev" ] && echo no || echo yes)"$'\n'
  [ "$hash" = "$prev" ] || SKIP_WORK="${SKIP_WORK}lockfiles changed or first run"$'\n'
  [ -s "$PENDING_FILE" ] && SKIP_WORK="${SKIP_WORK}pending actions from an earlier run"$'\n'
  SKIP_HASH="$hash" # stamped by main, and only after a run that succeeded
  w=$(printf '%s' "$SKIP_WORK" | sed -n 1p)
  if [ -n "$w" ]; then
    out=$(printf '%s' "$SKIP_FACTS" | JEV_SCHEDULED=1 "$JEV_BIN" skip sync --work "$w" 2>/dev/null) || return 0
  else
    out=$(printf '%s' "$SKIP_FACTS" | JEV_SCHEDULED=1 "$JEV_BIN" skip sync 2>/dev/null) || return 0
  fi
  say "== skip gate: $out"
  case "$out" in SKIP*) return 1 ;; esac
  return 0
}

#############################################################################
# Notification and logging
#############################################################################

notify() {
  local msg line total=0 shown=0 text=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    total=$((total + 1))
    if [ "$shown" -lt 3 ]; then
      text="${text:+$text; }$line"
      shown=$((shown + 1))
    fi
  done <<EOF
$ATTN
EOF
  [ "$total" -gt "$shown" ] && text="$text (+$((total - shown)) more)"
  msg=$(printf '%s' "$text" | tr -d '\042\134' | cut -c 1-220)
  osascript -e "display notification \"$msg\" with title \"dotfiles sync\" subtitle \"run: dotfiles sync\"" >/dev/null 2>&1 || true
}

setup_scheduled() {
  mkdir -p "$(dirname "$LOG")" 2>/dev/null
  # One megabyte is years of daily runs; keep one previous file.
  if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" | tr -d ' ')" -gt 1048576 ]; then
    mv -f "$LOG" "$LOG.1"
  fi
  exec >>"$LOG" 2>&1 </dev/null
  say "=== $(date '+%Y-%m-%d %H:%M:%S') dotfiles sync (scheduled)"
  # Nothing may wait at a prompt: no credential prompt, no ssh passphrase
  # prompt, and Homebrew must not update itself for a read-only query.
  export GIT_TERMINAL_PROMPT=0
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes}"
  export HOMEBREW_NO_AUTO_UPDATE=1
  unset DOTFILES_YES
}

main() {
  case "${1:-}" in
    "") ;;
    --scheduled) SCHEDULED=1 ;;
    -h | --help | help)
      usage
      return 0
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
  # setup_scheduled sets the scheduled GIT_SSH_COMMAND (BatchMode); either way
  # it is exported before the gate, whose fetch needs it too. A first-seen
  # GitHub host key must not stop a fetch at a prompt.
  [ "$SCHEDULED" -eq 1 ] && setup_scheduled
  # Interactive: keep the terminal for the strict prompts (see have_terminal).
  if [ "$SCHEDULED" -eq 0 ] && [ -t 0 ]; then exec 5<&0; fi
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o StrictHostKeyChecking=accept-new}"
  if [ "$SCHEDULED" -eq 1 ]; then
    skip_gate || {
      say "=== skipped (Jev gate)"
      return 0
    }
  fi

  if [ -d "$DOTFILES_DIR/.git" ]; then
    repo_sync public "$DOTFILES_DIR"
  else
    say "== public repo: $DOTFILES_DIR is not a git checkout; skipped"
  fi
  if [ -d "$PRIVATE_DIR/.git" ]; then
    repo_sync private "$PRIVATE_DIR"
  else
    say "== private repo: none at $PRIVATE_DIR (dotfiles private clone, or dotfiles private init)"
  fi

  [ "$MOVED" -eq 1 ] && restow
  collect_pending
  do_pending
  report_drift
  jev_drift
  jev_apps

  if [ "$SCHEDULED" -eq 1 ]; then
    [ -n "$ATTN" ] && notify
    if [ "$FAILED" -eq 0 ] && [ -n "$SKIP_HASH" ]; then
      mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\n' "$SKIP_HASH" >"$STATE_DIR/skip-sync.lockhash" 2>/dev/null
    fi
    say "=== done"
    return 0
  fi
  [ -z "$ATTN" ] && say "Everything is in sync."
  return "$FAILED"
}

main "$@"
