#!/usr/bin/env bash
#
# dotfiles-sync - keep this Mac current with the other one
#
# Usage: dotfiles-sync [--scheduled]
#
# For the public repo and then the private companion repo:
#   - `git fetch`; fast-forward only, and only when the tracked files are clean
#     and the branch is behind. Never merge, rebase or stash.
#   - report what needs the owner, with the exact command: unpushed commits,
#     behind-but-dirty, diverged.
# When anything moved: `stow --restow` both packages, then `dotfiles private
# link`. Then the actions the change calls for:
#   mise install               when config/mise/ changed
#   brew bundle install        when Brewfile / Brewfile.local are not satisfied
#   install --claude / --codex when claude/ or codex/ changed
# Interactively each one is offered (confirm). `secrets.age` changing upstream
# is only reported: importing prompts for the age passphrase, so it is never
# automatic. Finally, packages installed here but declared in neither the
# public nor the private lists are listed, each with the line to add.
#
# --scheduled (the daily LaunchAgent): logs to ~/Library/Logs/dotfiles-sync.log,
# never prompts, never runs sudo, never installs or upgrades anything (no
# `brew bundle`/`brew install`, no `mise install`), and posts ONE macOS
# notification, only when something needs the owner. The read-only package
# queries for the drift report (`brew leaves`, `brew list --cask`, `mas list`,
# `code --list-extensions`) do run; pending installs are remembered in
# ~/.local/state/dotfiles/sync-pending until an interactive run does them.
# With the Jev `drift` point not off, undeclared packages, changed macOS
# defaults and unmanaged ~/.config dirs are also classified (one batched request
# per kind); `on` offers the pre-filled line behind a confirm, nothing is ever
# written unconfirmed, committed, uninstalled or moved. See docs/agents/jev.md.
# Once a day it also runs `dotfiles jev scan-vault` over the vault's
# Claude-Sessions notes (they sync through iCloud, and a token pasted into a
# session lands there) and notifies on hits: file and line, never the value.
# Report-only: nothing in the vault is edited, moved or deleted.
#
# Bash 3.2 (macOS /bin/bash): no mapfile, no associative arrays, and never
# `((x++))`. GNU tools are not on PATH under launchd, so only BSD-safe flags.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$SELF_DIR/.." && pwd)}"
PRIVATE_DIR="${DOTFILES_PRIVATE_DIR:-$HOME/.dotfiles-private}"
DOTFILES_BIN="${DOTFILES_BIN:-$SELF_DIR/dotfiles}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
PENDING_FILE="$STATE_DIR/sync-pending"
LOG="${DOTFILES_SYNC_LOG:-$HOME/Library/Logs/dotfiles-sync.log}"
JEV_BIN="${DOTFILES_JEV_BIN:-$SELF_DIR/dotfiles-jev}"
VAULT_SCAN_STAMP="$STATE_DIR/vault-scan-last"

export DOTFILES_DIR DOTFILES_PRIVATE_DIR="$PRIVATE_DIR"

# launchd's PATH is /usr/bin:/bin:/usr/sbin:/sbin. Homebrew goes first, but
# only when brew is not already resolvable, so an interactive shell (and a
# test with stubs) keeps its own order. The mise shims come last.
if ! command -v brew >/dev/null 2>&1; then
  PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="$PATH:$HOME/.local/share/mise/shims" ;;
esac
export PATH

# shellcheck source=../scripts/echos.sh
source "$SELF_DIR/../scripts/echos.sh"
# shellcheck source=../scripts/lib/lists.sh
source "$SELF_DIR/../scripts/lib/lists.sh"
# shellcheck source=../scripts/lib/fs.sh
source "$SELF_DIR/../scripts/lib/fs.sh"
# shellcheck source=../scripts/lib/jev.sh
source "$SELF_DIR/../scripts/lib/jev.sh"

SCHEDULED=0
ATTN=""    # one line per thing that needs the owner
CHANGED="" # "<repo>|<path>" for every file a fast-forward brought in
MOVED=0
PENDING="" # actions still to do: mise brew claude codex
FAILED=0

say() { printf '%s\n' "$*"; }
attn() { ATTN="${ATTN}$1"$'\n'; }

usage() {
  cat <<'USAGE'
Usage: dotfiles sync [--scheduled]

  Fetch the public and private repos, fast-forward what is safe, restow, and
  report (or, interactively, offer) what the change calls for.

  --scheduled   No prompts, no sudo, no installs; logs to
                ~/Library/Logs/dotfiles-sync.log and notifies once when
                something needs you.
USAGE
}

#############################################################################
# Git
#############################################################################

# changed <repo> <pattern>...: did the last fast-forward of <repo> touch a
# path matching one of the shell patterns?
changed() {
  local repo="$1" r p pat
  shift
  while IFS='|' read -r r p; do
    [ "$r" = "$repo" ] || continue
    for pat in "$@"; do
      # shellcheck disable=SC2254
      case "$p" in $pat) return 0 ;; esac
    done
  done <<EOF
$CHANGED
EOF
  return 1
}

# repo_sync <label> <dir>
repo_sync() {
  local label="$1" dir="$2" up counts ahead behind old new f
  say "== $label repo: $dir"

  if ! git -C "$dir" fetch -q 2>/dev/null; then
    # Offline is normal for a laptop: say so, do not notify.
    say "  could not fetch (offline, or no access); nothing compared"
    return 0
  fi
  if ! up=$(git -C "$dir" rev-parse --abbrev-ref '@{u}' 2>/dev/null); then
    say "  no upstream branch, nothing to compare (git -C \"$dir\" push -u origin <branch>)"
    return 0
  fi
  counts=$(git -C "$dir" rev-list --left-right --count "HEAD...$up")
  ahead=${counts%%[[:space:]]*}
  behind=${counts##*[[:space:]]}

  if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
    say "  diverged from $up: $ahead local commit(s), $behind upstream. Nothing was changed. Resolve it by hand:"
    say "    git -C \"$dir\" rebase $up    (replay your commits on top of upstream)"
    say "    git -C \"$dir\" merge $up     (or merge)"
    attn "$label repo has diverged from $up (git -C $dir rebase $up)"
  elif [ "$behind" -gt 0 ]; then
    if [ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]; then
      say "  behind $up by $behind commit(s) but has uncommitted changes, so it was left alone."
      say "    Commit or discard them, then: git -C \"$dir\" pull --ff-only"
      attn "$label repo is behind but has local changes (commit them, then git -C $dir pull --ff-only)"
    else
      old=$(git -C "$dir" rev-parse HEAD)
      if git -C "$dir" merge --ff-only -q "$up" >/dev/null 2>&1; then
        new=$(git -C "$dir" rev-parse HEAD)
        say "  fast-forwarded $behind commit(s)"
        while IFS= read -r f; do
          [ -n "$f" ] && CHANGED="${CHANGED}${label}|${f}"$'\n'
        done <<EOF
$(git -C "$dir" diff --name-only "$old" "$new")
EOF
        MOVED=1
      else
        say "  could not fast-forward; try: git -C \"$dir\" pull --ff-only"
        attn "$label repo could not be fast-forwarded (git -C $dir pull --ff-only)"
      fi
    fi
  elif [ "$ahead" -gt 0 ]; then
    say "  $ahead unpushed commit(s): git -C \"$dir\" push"
    attn "$label repo has $ahead unpushed commit(s) (git -C $dir push)"
  else
    say "  up to date with $up"
  fi

  # New files in the private repo are untracked, and untracked means they stay
  # on this Mac.
  if [ "$label" = private ] && [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
    say "  uncommitted changes: they will not reach the other Mac until committed and pushed"
    attn "private repo has uncommitted changes"
  fi
}

#############################################################################
# After a change: restow and relink
#############################################################################

restow() {
  say "== restow"
  if ! command -v stow >/dev/null 2>&1; then
    say "  stow is not installed; run: dotfiles install --packages"
    attn "stow is missing, so the new files were not linked"
    return 0
  fi
  # Simulate both packages first: a conflict must not leave $HOME half-linked,
  # and this runs unattended. On a conflict nothing is touched.
  local out first
  if ! out=$(dotfiles_stow_all -n "$DOTFILES_DIR" "$HOME" "$XDG_CONFIG_HOME" 2>&1); then
    # The first line of stow's report is a generic "would cause conflicts";
    # the line that names the file is the useful one.
    first=$(printf '%s\n' "$out" | grep -m1 'cannot stow' | sed 's/^[ *]*//' || true)
    [ -n "$first" ] || first=$(printf '%s\n' "$out" | sed -n 1p)
    say "  stow would conflict; nothing was relinked: $first"
    say "  run: dotfiles link"
    attn "stow conflict: $first -- run dotfiles link"
    FAILED=1
  elif out=$(dotfiles_stow_all - "$DOTFILES_DIR" "$HOME" "$XDG_CONFIG_HOME" 2>&1); then
    say "  restowed runcom and config"
  else
    say "  stow reported a problem; run: dotfiles link"
    attn "stow failed while relinking (run dotfiles link)"
    FAILED=1
  fi
  if [ -d "$PRIVATE_DIR/.git" ]; then
    "$SELF_DIR/dotfiles-private" link || { attn "dotfiles private link failed"; FAILED=1; }
  fi
}

#############################################################################
# Pending actions
#############################################################################

pending_add() {
  case "$PENDING" in
    *"$1"$'\n'*) ;;
    *) PENDING="${PENDING}$1"$'\n' ;;
  esac
}
pending_has() { case "$PENDING" in *"$1"$'\n'*) return 0 ;; esac; return 1; }
pending_drop() {
  local out="" l
  while IFS= read -r l; do
    [ -n "$l" ] && [ "$l" != "$1" ] && out="${out}${l}"$'\n'
  done <<EOF
$PENDING
EOF
  PENDING="$out"
}
pending_save() {
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  printf '%s' "$PENDING" >"$PENDING_FILE" 2>/dev/null || true
}

collect_pending() {
  local l
  if [ -f "$PENDING_FILE" ]; then
    while IFS= read -r l; do
      case "$l" in mise | brew | claude | codex) pending_add "$l" ;; esac
    done <"$PENDING_FILE"
  fi
  if changed public 'config/mise/*'; then pending_add mise; fi
  if changed public 'Brewfile' || changed private 'Brewfile.local'; then pending_add brew; fi
  if changed public 'claude/*' || changed private 'claude/*'; then pending_add claude; fi
  if changed public 'codex/*' || changed private 'codex/*'; then pending_add codex; fi
  if changed private 'secrets.age'; then
    say "secrets.age changed upstream: run 'dotfiles secrets import $PRIVATE_DIR/secrets.age' (it asks for the age passphrase, so sync never does it)"
    attn "secrets.age changed: run dotfiles secrets import"
  fi
}

brewfiles() {
  local f
  for f in "$DOTFILES_DIR/Brewfile" "$DOTFILES_DIR/Brewfile.local"; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
}

# Interactive only: is the Brewfile satisfied on this Mac right now?
brew_unsatisfied() {
  local f rc=1
  command -v brew >/dev/null 2>&1 || return 1
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    brew bundle check --file="$f" >/dev/null 2>&1 || { printf '%s\n' "$f"; rc=0; }
  done <<EOF
$(brewfiles)
EOF
  return "$rc"
}

run_action() { # run_action <name> <description> <command...>
  local name="$1" desc="$2"
  shift 2
  if confirm "Run: $desc?"; then
    if "$@"; then
      pending_drop "$name"
    else
      say "  $desc failed"
      attn "$desc failed"
      FAILED=1
    fi
  else
    say "  skipped: $desc (still pending)"
  fi
}

install_brew_bundle() {
  local f rc=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    brew bundle install --file="$f" || rc=1
  done <<EOF
$(brew_unsatisfied)
EOF
  return "$rc"
}

do_pending() {
  say "== pending actions"
  # Interactively the Brewfiles themselves are the truth: satisfied means
  # nothing to do (whatever an earlier run remembered), unsatisfied means offer
  # it. Scheduled never runs `brew bundle`, so it goes by what changed.
  if [ "$SCHEDULED" -eq 0 ] && command -v brew >/dev/null 2>&1; then
    if brew_unsatisfied >/dev/null; then pending_add brew; else pending_drop brew; fi
  fi
  if [ -z "$PENDING" ]; then
    say "  none"
    return 0
  fi

  local name desc cmd
  for name in mise brew claude codex; do
    pending_has "$name" || continue
    case "$name" in
      mise) desc="mise install (config/mise changed)"; cmd="mise install" ;;
      brew) desc="brew bundle install (the Brewfiles are not satisfied)"; cmd="brew bundle install --file=<Brewfile>" ;;
      claude) desc="dotfiles install --claude (claude/ changed)"; cmd="dotfiles install --claude" ;;
      codex) desc="dotfiles install --codex (codex/ changed)"; cmd="dotfiles install --codex" ;;
    esac
    if [ "$SCHEDULED" -eq 1 ]; then
      say "  pending: $cmd"
      attn "pending: $cmd"
      continue
    fi
    case "$name" in
      mise) run_action mise "$desc" mise install ;;
      brew) run_action brew "$desc" install_brew_bundle ;;
      claude) run_action claude "$desc" "$DOTFILES_BIN" install --claude ;;
      codex) run_action codex "$desc" "$DOTFILES_BIN" install --codex ;;
    esac
  done
  pending_save
}

#############################################################################
# Drift: installed here, declared nowhere
#############################################################################

declared_brewfile_names() { # declared_brewfile_names <kind>
  local f
  while IFS= read -r f; do
    [ -n "$f" ] && sed -n -E "s/^[[:space:]]*$1 \"([^\"]+)\".*/\\1/p" "$f"
  done <<EOF
$(brewfiles)
EOF
}

declared_mas_ids() {
  local f
  while IFS= read -r f; do
    [ -n "$f" ] && sed -n -E 's/^[[:space:]]*mas .*id:[[:space:]]*([0-9]+).*/\1/p' "$f"
  done <<EOF
$(brewfiles)
EOF
}

# in_list <needle> <newline list>: exact, case-insensitive match.
in_list() { printf '%s\n' "$2" | grep -qixF -- "$1"; }

report_drift() {
  say "== drift: installed on this Mac, declared in no list"
  local n=0 decl item base line id name
  drift_jev_setup

  if command -v brew >/dev/null 2>&1; then
    decl=$(declared_brewfile_names brew)
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      base=${item##*/}
      if ! in_list "$item" "$decl" && ! in_list "$base" "$decl"; then
        say "  brew \"$item\"      (add to Brewfile, or Brewfile.local for private ones)"
        [ "$DRIFT_JEV" -eq 1 ] && add_pkg_fact brew "$item"
        n=$((n + 1))
      fi
    done <<EOF
$(brew leaves --installed-on-request 2>/dev/null)
EOF
    decl=$(declared_brewfile_names cask)
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      base=${item##*/}
      if ! in_list "$item" "$decl" && ! in_list "$base" "$decl"; then
        say "  cask \"$item\"      (add to Brewfile, or Brewfile.local)"
        [ "$DRIFT_JEV" -eq 1 ] && add_pkg_fact cask "$item"
        n=$((n + 1))
      fi
    done <<EOF
$(brew list --cask -1 2>/dev/null)
EOF
  fi

  if command -v mas >/dev/null 2>&1; then
    decl=$(declared_mas_ids)
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      id=$(printf '%s' "$line" | awk '{ print $1 }')
      name=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//; s/[[:space:]]+\([^)]*\)[[:space:]]*$//')
      if [ -n "$id" ] && ! in_list "$id" "$decl"; then
        say "  mas \"$name\", id: $id      (add to Brewfile, or Brewfile.local)"
        [ "$DRIFT_JEV" -eq 1 ] && add_mas_fact "$id" "$name"
        n=$((n + 1))
      fi
    done <<EOF
$(mas list 2>/dev/null)
EOF
  fi

  local code_bin
  code_bin=$(command -v code || true)
  [ -n "$code_bin" ] || code_bin="${DOTFILES_CODE_BIN_FALLBACK:-/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code}"
  if [ -x "$code_bin" ]; then
    decl=$(read_list "$DOTFILES_DIR/packages" code)
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      if ! in_list "$item" "$decl"; then
        say "  $item      (add to packages/code.list, or packages/code.local.list)"
        n=$((n + 1))
      fi
    done <<EOF
$("$code_bin" --list-extensions </dev/null 2>/dev/null)
EOF
  fi

  if [ "$n" -eq 0 ]; then
    say "  none"
  else
    attn "$n installed package(s) are declared nowhere (dotfiles sync lists them)"
  fi
}

#############################################################################
# Drift, second half: Jev classifies what the report above only lists
#############################################################################
#
# Facts are computed here, in shell, and go to `dotfiles-jev drift <kind>` as
# one batched request per kind: installed packages (brew, casks, App Store),
# macOS defaults that read back differently from the last baseline snapshot,
# and directories under ~/.config the repo does not manage. Jev only picks a
# choice per item; the line offered is built here from the fact, never taken
# from Jev, and an item Jev names that was not in the facts is ignored.
# Nothing is written without `confirm`, nothing is committed, nothing is
# uninstalled or moved. Scheduled runs only notify. In shadow mode Jev is
# asked and logs, and nothing here acts.

DRIFT_SEEN="$STATE_DIR/drift-first-seen"
BASELINE_BIN="${DOTFILES_BASELINE_BIN:-$SELF_DIR/dotfiles-baseline}"
DRIFT_JEV=0   # 1 when Jev is to be asked (jq present, point not off)
DRIFT_MODE=off
DRIFT_PKG=""  # "key<TAB>facts" per undeclared package
DRIFT_LINES="" # "key<TAB>line to add" per undeclared package
DRIFT_HEADER=0
DRIFT_SUGGESTED=0

drift_jev_setup() {
  DRIFT_JEV=0
  command -v jq >/dev/null 2>&1 || return 0
  DRIFT_MODE=$(jev_mode drift)
  [ "$DRIFT_MODE" = off ] && return 0
  [ -x "$JEV_BIN" ] || return 0
  DRIFT_JEV=1
}

# first_seen <key>: the date this item was first seen undeclared. Recorded
# now when new, so "how long has this been here" is a fact, not a guess.
first_seen() {
  local d
  d=$(awk -F'\t' -v k="$1" '$1 == k { print $2; exit }' "$DRIFT_SEEN" 2>/dev/null)
  if [ -z "$d" ]; then
    d=$(date +%Y-%m-%d)
    mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\t%s\n' "$1" "$d" >>"$DRIFT_SEEN" 2>/dev/null
  fi
  printf '%s' "$d"
}

one_line() { printf '%s' "$1" | tr '\t\n' '  ' | cut -c 1-160; }

# add_pkg_fact <brew|cask> <name>
add_pkg_fact() {
  local key="$1:$2" desc dep=no kind
  if [ "$1" = cask ]; then
    kind=cask
    desc=$(brew desc --cask "$2" 2>/dev/null)
  else
    kind="brew formula"
    desc=$(brew desc "$2" 2>/dev/null)
    [ -n "$(brew uses --installed "$2" 2>/dev/null)" ] && dep=yes
  fi
  desc=$(one_line "$(printf '%s' "$desc" | sed 's/^[^:]*: *//')")
  DRIFT_PKG="${DRIFT_PKG}${key}"$'\t'"kind=$kind;${desc:+ description=$desc;} dependency=$dep; first seen $(first_seen "$key")"$'\n'
  DRIFT_LINES="${DRIFT_LINES}${key}"$'\t'"$1 \"$2\""$'\n'
}

add_mas_fact() { # add_mas_fact <id> <name>
  local key="mas:$1"
  DRIFT_PKG="${DRIFT_PKG}${key}"$'\t'"kind=App Store app \"$(one_line "$2")\"; dependency=no; first seen $(first_seen "$key")"$'\n'
  DRIFT_LINES="${DRIFT_LINES}${key}"$'\t'"mas \"$2\", id: $1"$'\n'
}

# ask_jev <kind> <facts>: the SUGGEST lines Jev returns, nothing on any error.
# Interactive gets a longer timeout than the 2 s default (a batch is bigger
# than one hunk); scheduled uses the 10 s scheduled default.
ask_jev() {
  local t=6
  [ "$SCHEDULED" -eq 1 ] && t=""
  printf '%s' "$2" | JEV_SCHEDULED="$([ "$SCHEDULED" -eq 1 ] && echo 1)" JEV_TIMEOUT="${JEV_TIMEOUT:-$t}" "$JEV_BIN" drift "$1" 2>/dev/null || true
}

drift_header() {
  [ "$DRIFT_HEADER" -eq 1 ] && return 0
  DRIFT_HEADER=1
  say "== drift: what Jev suggests (nothing is written until you confirm)"
}

# append_line <file> <line>: never twice, and never onto an unterminated line.
append_line() {
  local f="$1"
  grep -qxF -- "$2" "$f" 2>/dev/null && return 0
  if [ -s "$f" ] && [ "$(tail -c 1 "$f" | wc -l | tr -d ' ')" -eq 0 ]; then
    printf '\n' >>"$f"
  fi
  printf '%s\n' "$2" >>"$f"
}

# offer_line <choice-label> <line> <file> <what>: show it, and when
# interactive and confirmed, append it.
offer_line() {
  local label="$1" line="$2" file="$3" what="$4"
  drift_header
  DRIFT_SUGGESTED=$((DRIFT_SUGGESTED + 1))
  say "  Jev suggests $label: $line      (add to $what)"
  [ "$SCHEDULED" -eq 1 ] && return 0
  if confirm "Add $line to $what?"; then
    append_line "$file" "$line" && say "    added to $what (not committed)"
  else
    say "    not added"
  fi
}

drift_pkg() {
  local out tag key choice p c line name
  [ -n "$DRIFT_PKG" ] || return 0
  out=$(ask_jev pkg "$DRIFT_PKG")
  [ "$DRIFT_MODE" = on ] || return 0
  while IFS=$'\t' read -r tag key choice p c; do
    [ "$tag" = SUGGEST ] || continue
    line=$(printf '%s' "$DRIFT_LINES" | awk -F'\t' -v k="$key" '$1 == k { print $2; exit }')
    [ -n "$line" ] || continue
    case "$choice" in
      public) offer_line public "$line" "$DOTFILES_DIR/Brewfile" Brewfile ;;
      private) offer_line private "$line" "$DOTFILES_DIR/Brewfile.local" Brewfile.local ;;
      ignore)
        drift_header
        DRIFT_SUGGESTED=$((DRIFT_SUGGESTED + 1))
        say "  Jev suggests ignore: $line      (an experiment, a dependency or transient; nothing to write)"
        ;;
      remove)
        drift_header
        DRIFT_SUGGESTED=$((DRIFT_SUGGESTED + 1))
        name=${key#*:}
        case "$key" in
          brew:*) say "  Jev suggests remove (two calls agreed): $line      (run yourself: brew uninstall $name)" ;;
          cask:*) say "  Jev suggests remove (two calls agreed): $line      (run yourself: brew uninstall --cask $name)" ;;
          *) say "  Jev suggests remove (two calls agreed): $line      (remove it by hand)" ;;
        esac
        ;;
    esac
  done <<EOF
$out
EOF
}

# defaults_line <domain> <key> <new value>: the `defaults write` line, typed by
# `defaults read-type`, or nothing when it cannot be written safely.
defaults_line() {
  local dom="$1" key="$2" val="$3" type k
  type=$(defaults read-type "$dom" "$key" 2>/dev/null | sed -n 's/^Type is //p')
  k="$key"
  case "$key" in *[!A-Za-z0-9._-]*) k="\"$key\"" ;; esac
  case "$key$dom" in *'"'* | *'$'* | *'`'* | *\\* | *"'"*) return 1 ;; esac
  case "$type" in
    boolean)
      case "$val" in 1 | true | YES) printf 'defaults write %s %s -bool true' "$dom" "$k" ;; 0 | false | NO) printf 'defaults write %s %s -bool false' "$dom" "$k" ;; *) return 1 ;; esac
      ;;
    integer) case "$val" in '' | *[!0-9-]*) return 1 ;; esac; printf 'defaults write %s %s -int %s' "$dom" "$k" "$val" ;;
    float) case "$val" in '' | *[!0-9.-]*) return 1 ;; esac; printf 'defaults write %s %s -float %s' "$dom" "$k" "$val" ;;
    string)
      case "$val" in '' | *[!A-Za-z0-9\ ._/:+,@=-]*) return 1 ;; esac
      printf 'defaults write %s %s -string "%s"' "$dom" "$k" "$val"
      ;;
    *) return 1 ;;
  esac
}

drift_defaults() {
  local changed facts="" dom key old new k out tag choice p c line vals=""
  changed=$("$BASELINE_BIN" changed 2>/dev/null) || true
  [ -n "$changed" ] || return 0
  while IFS=$'\t' read -r dom key old new; do
    [ -n "$dom" ] && [ -n "$key" ] || continue
    k="$dom $key"
    facts="${facts}${k}"$'\t'"setting=$k; was $(one_line "$old"); now $(one_line "$new"); first seen $(first_seen "defaults:$k")"$'\n'
    vals="${vals}${k}"$'\t'"$dom"$'\t'"$key"$'\t'"$new"$'\n'
  done <<EOF
$changed
EOF
  [ -n "$facts" ] || return 0
  out=$(ask_jev defaults "$facts")
  [ "$DRIFT_MODE" = on ] || return 0
  while IFS=$'\t' read -r tag k choice p c; do
    [ "$tag" = SUGGEST ] || continue
    IFS=$'\t' read -r _ dom key new <<EOF
$(printf '%s' "$vals" | awk -F'\t' -v k="$k" '$1 == k { print; exit }')
EOF
    [ -n "$dom" ] || continue
    case "$choice" in
      public | local-only)
        if line=$(defaults_line "$dom" "$key" "$new"); then
          if [ "$choice" = public ]; then
            offer_line public "$line" "$DOTFILES_DIR/macos/defaults.sh" macos/defaults.sh
          else
            offer_line local-only "$line" "$DOTFILES_DIR/macos/local.sh" macos/local.sh
          fi
        else
          drift_header
          DRIFT_SUGGESTED=$((DRIFT_SUGGESTED + 1))
          say "  Jev suggests $choice: $k      (review by hand: a defaults write line that is safe to append could not be built)"
        fi
        ;;
      transient)
        drift_header
        DRIFT_SUGGESTED=$((DRIFT_SUGGESTED + 1))
        say "  Jev suggests transient: $k      (application state or a one-off change; nothing to write)"
        ;;
    esac
    dom=""
  done <<EOF
$out
EOF
}

drift_config() {
  local facts="" d name n kb out tag key choice p c
  [ -d "$XDG_CONFIG_HOME" ] || return 0
  for d in "$XDG_CONFIG_HOME"/*; do
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    name=${d##*/}
    [ -e "$DOTFILES_DIR/config/$name" ] && continue
    n=$(find "$d" -type f 2>/dev/null | wc -l | tr -d ' ')
    kb=$(du -sk "$d" 2>/dev/null | cut -f1)
    facts="${facts}${name}"$'\t'"directory ~/.config/$name; files=$n; size=${kb:-?} KB; first seen $(first_seen "config:$name")"$'\n'
  done
  [ -n "$facts" ] || return 0
  out=$(ask_jev config "$facts")
  [ "$DRIFT_MODE" = on ] || return 0
  while IFS=$'\t' read -r tag key choice p c; do
    [ "$tag" = SUGGEST ] || continue
    printf '%s' "$facts" | awk -F'\t' -v k="$key" '$1 == k { f = 1 } END { exit !f }' || continue
    drift_header
    DRIFT_SUGGESTED=$((DRIFT_SUGGESTED + 1))
    case "$choice" in
      capture)
        say "  Jev suggests capture: ~/.config/$key      (move it into the repo, then link: mv \"$XDG_CONFIG_HOME/$key\" \"$DOTFILES_DIR/config/$key\" && dotfiles link)"
        ;;
      ignore) say "  Jev suggests ignore: ~/.config/$key      (cache, state or application data; nothing to do)" ;;
    esac
  done <<EOF
$out
EOF
}

jev_drift() {
  [ "$DRIFT_JEV" -eq 1 ] || return 0
  drift_pkg
  drift_defaults
  drift_config
  if [ "$DRIFT_SUGGESTED" -gt 0 ] && [ "$SCHEDULED" -eq 1 ]; then
    attn "Jev suggests $DRIFT_SUGGESTED drift item(s) to classify (run dotfiles sync)"
  fi
}

#############################################################################
# The daily vault scan
#############################################################################

# scan_vault_daily: scheduled runs only, once per calendar day (the stamp is
# written only when the scan actually ran, so a failed one is retried).
scan_vault_daily() {
  local dir today out rc hits n first
  dir="${DOTFILES_VAULT_DIR:-$HOME/Vault}/Claude-Sessions"
  say "== vault scan: $dir"
  if [ ! -d "$dir" ]; then
    say "  no such folder; skipped"
    return 0
  fi
  today=$(date +%Y-%m-%d)
  if [ "$(cat "$VAULT_SCAN_STAMP" 2>/dev/null)" = "$today" ]; then
    say "  already scanned today"
    return 0
  fi
  out=$(JEV_SCHEDULED=1 "$JEV_BIN" scan-vault "$dir" 2>&1)
  rc=$?
  printf '%s\n' "$out" | sed 's/^/  /'
  if [ "$rc" -gt 1 ]; then
    attn "vault scan could not run (exit $rc; see the log)"
    return 0
  fi
  mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\n' "$today" >"$VAULT_SCAN_STAMP" 2>/dev/null
  # FOUND is a definite hit, WARN an ambiguous one; both are file:line.
  hits=$(printf '%s\n' "$out" | sed -n -E 's/^(FOUND|WARN)[[:space:]]+(.+:[0-9]+): .*/\2/p')
  n=$(printf '%s\n' "$hits" | grep -c .)
  if [ "$n" -gt 0 ]; then
    first=$(printf '%s\n' "$hits" | sed -n '1,3p' | paste -sd, - | sed 's/,/, /g')
    [ "$n" -gt 3 ] && first="$first (+$((n - 3)) more)"
    attn "vault scan: $n possible credential(s) in Claude-Sessions: $first (dotfiles jev scan-vault)"
  fi
  # The scan's own exit status is the truth: never let an unparsed line hide a hit.
  if [ "$n" -eq 0 ] && [ "$rc" -eq 1 ]; then
    attn "vault scan: possible credential(s) in the vault, see the sync log (dotfiles jev scan-vault)"
  fi
}

#############################################################################
# Notification and logging
#############################################################################

notify() {
  local msg line total=0 shown=0 text=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    total=$((total + 1))
    if [ "$shown" -lt 3 ]; then
      text="${text:+$text; }$line"
      shown=$((shown + 1))
    fi
  done <<EOF
$ATTN
EOF
  [ "$total" -gt "$shown" ] && text="$text (+$((total - shown)) more)"
  msg=$(printf '%s' "$text" | tr -d '\042\134' | cut -c 1-220)
  osascript -e "display notification \"$msg\" with title \"dotfiles sync\" subtitle \"run: dotfiles sync\"" >/dev/null 2>&1 || true
}

setup_scheduled() {
  mkdir -p "$(dirname "$LOG")" 2>/dev/null
  # One megabyte is years of daily runs; keep one previous file.
  if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" | tr -d ' ')" -gt 1048576 ]; then
    mv -f "$LOG" "$LOG.1"
  fi
  exec >>"$LOG" 2>&1 </dev/null
  say "=== $(date '+%Y-%m-%d %H:%M:%S') dotfiles sync (scheduled)"
  # Nothing may wait at a prompt: no credential prompt, no ssh passphrase
  # prompt, and Homebrew must not update itself for a read-only query.
  export GIT_TERMINAL_PROMPT=0
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes}"
  export HOMEBREW_NO_AUTO_UPDATE=1
  unset DOTFILES_YES
}

main() {
  case "${1:-}" in
    "") ;;
    --scheduled) SCHEDULED=1 ;;
    -h | --help | help)
      usage
      return 0
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
  [ "$SCHEDULED" -eq 1 ] && setup_scheduled
  # A first-seen GitHub host key must not stop a fetch at a prompt.
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o StrictHostKeyChecking=accept-new}"

  if [ -d "$DOTFILES_DIR/.git" ]; then
    repo_sync public "$DOTFILES_DIR"
  else
    say "== public repo: $DOTFILES_DIR is not a git checkout; skipped"
  fi
  if [ -d "$PRIVATE_DIR/.git" ]; then
    repo_sync private "$PRIVATE_DIR"
  else
    say "== private repo: none at $PRIVATE_DIR (dotfiles private clone, or dotfiles private init)"
  fi

  [ "$MOVED" -eq 1 ] && restow
  collect_pending
  do_pending
  report_drift
  jev_drift
  [ "$SCHEDULED" -eq 1 ] && scan_vault_daily

  if [ "$SCHEDULED" -eq 1 ]; then
    [ -n "$ATTN" ] && notify
    say "=== done"
    return 0
  fi
  [ -z "$ATTN" ] && say "Everything is in sync."
  return "$FAILED"
}

main "$@"
