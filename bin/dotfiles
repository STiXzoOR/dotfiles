    return 1
  fi
  "$DOTFILES_DIR/bin/dotfiles-claude" "$@"
}

sub_baseline_help() {
  echo -e "\nUsage: $BIN_NAME baseline <command>"
  echo
  echo "Commands:"
  echo "   capture           Record the current value of every defaults key this repo writes"
  echo "   diff              Compare the live system against the recorded baseline"
}

sub_link_help() {
  echo -e "\nUsage: $BIN_NAME link"
  echo
  echo "Stow runcom/ into \$HOME and config/ into \$XDG_CONFIG_HOME."
  echo "Anything already in the way is moved to ~/.dotfiles_backup/<timestamp>"
  echo "and can be put back with: $BIN_NAME unlink <timestamp>"
}

sub_unlink_help() {
  echo -e "\nUsage: $BIN_NAME unlink <timestamp>"
  echo
  echo "Restore a ~/.dotfiles_backup/<timestamp> directory over \$HOME and"
  echo "\$XDG_CONFIG_HOME. Anything real in the way is renamed, never deleted."
}

sub_setup() {
  "$DOTFILES_DIR/bin/dotfiles-setup" "$@"
}


# Routing.
#
# This used to call the sub_* name and then test `[ $? = 127 ]` to decide
# whether it existed. 127 is also what a *defined* function returns when its
# last command is missing, so `dotfiles edit` (which ran an unset
# $DOTFILES_IDE) was reported as an unknown command, and `dotfiles link
# --help` printed "command not found" twice -- once for the missing
# sub_link_help, once for the 127 that sent it to cmd_error. `declare -F` asks
# the question directly and works in bash 3.2.
has_sub() { declare -F "$1" >/dev/null 2>&1; }

cmd_error() {
  error "'${COMMAND_NAME}' is not a known command or has errors." >&2
  sub_help
  exit 1
}

subcmd_error() {
  error "${COMMAND_NAME}: '${SUB_COMMAND_NAME}' is not a known command or has errors." >&2
  if has_sub "sub_${COMMAND_NAME}_help"; then
    "sub_${COMMAND_NAME}_help"
  else
    sub_help
  fi
  exit 1
}

case $COMMAND_NAME in
"" | "help")
  sub_help
  ;;
"unlink" | "test" | "doctor" | "profiler" | "cheatsheet" | "setup" | "secrets" | "baseline" | "claude")
  shift
  sub_"$COMMAND_NAME" "$@"
  ;;
*)
  if [[ -n $SUB_COMMAND_NAME ]]; then
    case $SUB_COMMAND_NAME in
    --"${STRIPPED_SUB_COMMAND_NAME}")
      if has_sub "sub_${COMMAND_NAME}_${STRIPPED_SUB_COMMAND_NAME}"; then
        "sub_${COMMAND_NAME}_${STRIPPED_SUB_COMMAND_NAME}"
      else
        subcmd_error
      fi
      ;;
    *)
      subcmd_error
      ;;
    esac
  else
    if has_sub "sub_${COMMAND_NAME}"; then
      "sub_${COMMAND_NAME}"
    else
      cmd_error
    fi
  fi
  ;;
esac
