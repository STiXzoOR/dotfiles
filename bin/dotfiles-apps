#!/usr/bin/env bash
#
# dotfiles-apps - back up and restore app settings that nothing else in the
#                 dotfiles manages, with mackup in COPY mode
#
# Usage: dotfiles-apps <command>
#
#   check                      Verify the allowlist never touches anything the
#                              dotfiles own (runs first in backup and restore)
#   backup [--scheduled]       Stage, validate, publish a snapshot to iCloud
#   restore [--from <machine>] [<snapshot>]
#                              Apply a snapshot (default: this Mac's latest)
#   list                       Snapshots of every Mac, and local rescue copies
#   undo                       Put back the latest rescue copy
#   candidates                 Installed apps mackup supports that nobody has
#                              decided on (facts for the Jev app suggestions)
#
# Ownership rule: the dotfiles own everything they stow, copy or
# `defaults write`; mackup owns only the apps listed in
# config/mackup/mackup.cfg. See docs/agents/app-settings.md.
#
# mackup is only ever called as `backup -f`, `restore -f`, `show` and `list`,
# never `link`: the symlink model clobbered settings. Nothing here is
# two-way sync -- copy mode is last-writer-wins, so restoring another Mac's
# snapshot is a deliberate `restore --from <machine>`.
#
# Bash 3.2 (macOS /bin/bash): no mapfile, no associative arrays, and never
# `((x++))`. GNU tools are not on PATH under launchd, so only BSD-safe flags.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$SELF_DIR/.." && pwd)}"
export DOTFILES_DIR

# dotfiles_machine_name: this Mac's name, shared with dotfiles-sync.
# shellcheck source=../scripts/lib/machine.sh
source "$SELF_DIR/../scripts/lib/machine.sh"

# launchd's PATH is /usr/bin:/bin:/usr/sbin:/sbin. Homebrew goes first, but
# only when mackup is not already resolvable, so an interactive shell (and a
# test with a stub) keeps its own order.
if ! command -v mackup >/dev/null 2>&1 && [ -z "${DOTFILES_APPS_NO_BREW_PATH:-}" ]; then
  PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi

#############################################################################
# Configuration (every path overridable so tests stay in a sandbox)
#############################################################################

CFG_SRC="${DOTFILES_APPS_CFG:-$DOTFILES_DIR/config/mackup/mackup.cfg}"
PROCS_FILE="${DOTFILES_APPS_PROCS:-$(dirname "$CFG_SRC")/processes.list}"
STORE="${DOTFILES_APPS_STORE:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/Mackup}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/mackup"
STAGE="$STATE/stage"
RUN_CFG="$STATE/mackup.cfg"

#############################################################################
# Output
#############################################################################

say() { printf '%s\n' "$*"; }
err() { printf 'dotfiles-apps: %s\n' "$*" >&2; }

#############################################################################
# Config, allowlist and what each app covers
#############################################################################

# The apps mackup may touch. An empty list would make mackup back up EVERY
# supported app, so callers treat "no entries" as an error.
allowlist() {
  awk '/^\[/ { s = ($0 == "[applications_to_sync]"); next }
       s && NF && $0 !~ /^[[:space:]]*[#;]/ { print $1 }' "$CFG_SRC"
}

# The runtime mackup config: the shipped one with [storage] path pointing at
# the real staging directory, relative to $HOME (mackup refuses anything else).
write_run_cfg() {
  local rel
  case "$STATE" in
    "$HOME"/*) rel="${STAGE#"$HOME"/}" ;;
    *)
      err "state directory $STATE is not inside $HOME; mackup refuses paths outside it"
      return 1
      ;;
  esac
  [ -f "$CFG_SRC" ] || { err "no mackup config at $CFG_SRC"; return 1; }
  # mackup (even `show`) refuses a storage path that does not exist.
  mkdir -p "$STAGE" || return 1
  awk -v rel="$rel" '
    /^\[/ { s = ($0 == "[storage]") }
    s && /^path[[:space:]]*=/ { print "path = " rel; next }
    { print }
  ' "$CFG_SRC" >"$RUN_CFG.tmp" && mv "$RUN_CFG.tmp" "$RUN_CFG"
}

run_mackup() { mackup -c "$RUN_CFG" "$@"; }

# The home-relative paths an app covers, one per line. Fails for an unknown app.
app_paths() {
  local out
  out=$(run_mackup show "$1" 2>&1) || return 1
  printf '%s\n' "$out" | sed -n 's/^ - //p'
}

# Process names for an app, from processes.list (`app|process`). `app|-` marks
# a CLI-only app: it is mapped, and has no process to wait for.
app_procs() {
  [ -f "$PROCS_FILE" ] || return 0
  awk -F'|' -v a="$1" '$1 == a && NF >= 2 && $2 != "-" { print $2 }' "$PROCS_FILE"
}

# Whether processes.list has any line for the app, `app|-` included.
app_mapped() {
  [ -f "$PROCS_FILE" ] || return 1
  awk -F'|' -v a="$1" '$1 == a && NF >= 2 { f = 1 } END { exit !f }' "$PROCS_FILE"
}

#############################################################################
# Overlap guard: what the dotfiles own
#############################################################################

# What each apps/* directory installs, as name<TAB>home-relative target.
# MAINTAINED BY HAND: install scripts compute these paths in shell variables,
# so there is nothing safe to parse. `check` fails when apps/ gains a
# directory that is not listed here, so a new target cannot slip past.
app_targets() {
  printf '%s\t%s\n' \
    gitkraken ".gitkraken" \
    terminal "Library/Preferences/com.apple.Terminal.plist" \
    vlc "Library/Preferences/org.videolan.vlc" \
    vscode "Library/Application Support/Code/User" \
    warp ".warp" \
    xcode "Library/Developer/Xcode/UserData/FontAndColorThemes" \
    claude ".claude" \
    codex ".codex"
}

# The defaults-domain listing the guard trusts. DOTFILES_APPS_BASELINE
# overrides the tool (tests).
baseline_list() { "${DOTFILES_APPS_BASELINE:-$SELF_DIR/dotfiles-baseline}" list; }

# The guard must fail CLOSED: an owned set that came back empty because a
# source is missing or broken would let every path through, and `check` gates
# the unattended daily backup. Sets BASELINE_OUT for owned_targets.
BASELINE_OUT=""
owned_sources_ok() {
  local rc=0 e n
  for e in runcom config; do
    n=0
    for f in "$DOTFILES_DIR/$e"/* "$DOTFILES_DIR/$e"/.[!.]*; do
      [ -e "$f" ] && n=$((n + 1))
    done
    if [ "$n" -eq 0 ]; then
      err "$e/ has no entries under $DOTFILES_DIR, so the guard would not know what it stows; refusing"
      rc=1
    fi
  done
  mkdir -p "$STATE" || return 1
  if ! BASELINE_OUT=$(baseline_list 2>"$STATE/baseline.err"); then
    err "dotfiles-baseline failed, so the defaults domains are unknown; refusing: $(head -n 3 "$STATE/baseline.err" | tr '\n' ' ')"
    BASELINE_OUT=""
    rc=1
  elif [ -z "$(printf '%s\n' "$BASELINE_OUT" | awk -F'\t' 'NF >= 2')" ]; then
    err "dotfiles-baseline found no defaults domains (is macos/defaults*.sh missing?); refusing"
    rc=1
  fi
  return "$rc"
}

has_copy_marker() {
  grep -Eq '^# dotfiles-apps: copies' "$DOTFILES_DIR/macos/defaults-$1.sh" 2>/dev/null
}

# A marked script that could link (any ln, LN or --symbolic on a code line).
marker_liars() {
  local name target code
  app_targets | while IFS=$'\t' read -r name target; do
    has_copy_marker "$name" || continue
    # The script and the files every defaults script sources. A variable, not
    # a pipe into grep -q: pipefail would turn grep's early exit into a miss.
    code=$(sed 's/#.*$//' "$DOTFILES_DIR/macos/defaults-$name.sh" "$DOTFILES_DIR/scripts/echos.sh" "$DOTFILES_DIR/scripts/requirers.sh" 2>/dev/null)
    if printf '%s\n' "$code" | grep -Eq '(^|[^[:alnum:]_])(ln|LN)([^[:alnum:]_]|$)|symbolic'; then
      printf '%s\n' "$name"
    fi
  done
}

# Every owned target as why<TAB>home-relative path.
owned_targets() {
  local e xdg rel name target domain flags
  for e in "$DOTFILES_DIR"/runcom/* "$DOTFILES_DIR"/runcom/.[!.]*; do
    [ -e "$e" ] || continue
    e=$(basename "$e")
    printf 'stowed from runcom/%s\t%s\n' "$e" "$e"
  done
  xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
  case "$xdg" in "$HOME"/*) rel="${xdg#"$HOME"/}" ;; *) rel=".config" ;; esac
  for e in "$DOTFILES_DIR"/config/* "$DOTFILES_DIR"/config/.[!.]*; do
    [ -e "$e" ] || continue
    e=$(basename "$e")
    printf 'stowed from config/%s\t%s/%s\n' "$e" "$rel" "$e"
  done
  # An apps/ target is soft only when its macos/defaults-<name>.sh says so with
  # a `# dotfiles-apps: copies` marker (`dotfiles configure --defaults` then
  # re-applies it after a restore). Everything else is hard: detecting links by
  # grep fails open, so an unmarked script is assumed to link. cmd_check fails
  # a marked script that mentions ln anywhere.
  app_targets | while IFS=$'\t' read -r name target; do
    if has_copy_marker "$name"; then
      printf 'a domain macos/defaults*.sh writes (apps/%s)\t%s\n' "$name" "$target"
    else
      printf 'installed from %s/\t%s\n' "$name" "$target"
    fi
  done
  # Preferences domains macos/defaults*.sh write, via the same key extraction
  # dotfiles-baseline uses. Domains under /Library are system-wide, not $HOME.
  printf '%s\n' "$BASELINE_OUT" | cut -f1,3 | sort -u |
    while IFS=$'\t' read -r domain flags; do
      case "$domain" in
        /*) continue ;;
        NSGlobalDomain) domain=".GlobalPreferences" ;;
      esac
      printf 'a domain macos/defaults*.sh writes (%s)\tLibrary/Preferences/%s\n' "$domain" "$domain"
      printf 'a domain macos/defaults*.sh writes (%s)\tLibrary/Containers/%s\n' "$domain" "$domain"
      [ "$flags" = "-currentHost" ] &&
        printf 'a domain macos/defaults*.sh writes (%s)\tLibrary/Preferences/ByHost/%s\n' "$domain" "$domain"
    done
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# overlaps <path> <target>, both lowercased (APFS is case-insensitive). A
# target ending in a name matches its children (T/), its plist and siblings
# (T.), and a path that is an ancestor of it.
overlaps() {
  case "$1" in "$2" | "$2"/* | "$2".*) return 0 ;; esac
  case "$2" in "$1"/*) return 0 ;; esac
  return 1
}

# apps/* directories with no entry in app_targets.
unmapped_apps() {
  local d name known
  known=$(app_targets | cut -f1)
  for d in "$DOTFILES_DIR"/apps/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    printf '%s\n' "$known" | grep -Fxq -- "$name" || printf '%s\n' "$name"
  done
}

# Apps whose files overlap a defaults domain (set by cmd_check, read by restore).
DOMAIN_OVERLAP_APPS=""

cmd_check() {
  local rc=0 apps app paths p pl why t tl targets u doms dom
  DOMAIN_OVERLAP_APPS=""
  apps=$(allowlist)
  if [ -z "$apps" ]; then
    err "the allowlist is empty; mackup would back up every supported app"
    return 1
  fi
  write_run_cfg || return 1

  for u in $(unmapped_apps); do
    err "apps/$u has no entry in the owned-target list in bin/dotfiles-apps (app_targets); add it so the overlap guard knows what it installs"
    rc=1
  done

  owned_sources_ok || return 1
  for u in $(marker_liars); do
    err "macos/defaults-$u.sh carries a 'dotfiles-apps: copies' marker but also mentions ln; the marker must not lie, so remove one of them"
    rc=1
  done
  # Lowercase once, in one awk each, not with a fork per path and target: the
  # owned list has hundreds of entries, and a tr per pair made every check
  # take seconds.
  targets=$(owned_targets | awk -F'\t' 'NF >= 2 { printf "%s\t%s\t%s\n", $1, $2, tolower($2) }')
  for app in $apps; do
    if ! app_mapped "$app"; then
      err "$app has no process mapping in $PROCS_FILE; restore could not tell whether it is running"
      rc=1
    fi
    if ! paths=$(app_paths "$app") || [ -z "$paths" ]; then
      err "unknown app or no paths for '$app' (mackup show failed)"
      rc=1
      continue
    fi
    doms=""
    while IFS=$'\t' read -r p pl; do
      [ -n "$p" ] || continue
      while IFS=$'\t' read -r why t tl; do
        [ -n "$t" ] || continue
        if overlaps "$pl" "$tl"; then
          case "$why" in
            "a domain macos/defaults*.sh writes ("*)
              # Allowed: `dotfiles configure --defaults` re-applies these keys
              # after a restore. Reported once per app, below.
              dom="${why#*\(}"; dom="${dom%\)}"
              case " $doms " in *" $dom "*) ;; *) doms="$doms $dom" ;; esac
              ;;
            *)
              err "OVERLAP: $app covers '$p', which the dotfiles own ($why: $t)"
              rc=1
              ;;
          esac
        fi
      done <<EOF
$targets
EOF
    done <<EOF
$(printf '%s\n' "$paths" | awk '{ l = tolower($0); sub(/\/$/, "", l); printf "%s\t%s\n", $0, l }')
EOF
    if [ -n "$doms" ]; then
      say "info: $app overlaps defaults domain(s):$doms (macos/defaults*.sh re-applies its keys via 'dotfiles configure --defaults')"
      DOMAIN_OVERLAP_APPS="$DOMAIN_OVERLAP_APPS $app"
    fi
  done
  return "$rc"
}

#############################################################################
# Machine, storage and lock
#############################################################################

# The store must already exist as iCloud Drive; it is never created for the
# user (an absent iCloud Drive means signed out or disabled).
ICLOUD_ROOT="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
icloud_missing() { [ -z "${DOTFILES_APPS_STORE:-}" ] && [ ! -d "$ICLOUD_ROOT" ]; }
store_ready() {
  local create="${1:-create}"
  if icloud_missing; then
    err "iCloud Drive is not available ($ICLOUD_ROOT is missing); sign in and turn on iCloud Drive"
    return 1
  fi
  if [ "$create" = no_create ]; then
    [ -d "$STORE" ] || { err "nothing to restore from: $STORE does not exist (has iCloud Drive synced?)"; return 1; }
  else
    mkdir -p "$STORE" || { err "cannot create $STORE"; return 1; }
  fi
}

LOCK="$STATE/lock.d"
LOCK_HELD=0

release_lock() {
  [ "$LOCK_HELD" -eq 1 ] || return 0
  rm -rf "$LOCK"
  LOCK_HELD=0
}

# One run at a time: mkdir is atomic. A lock older than an hour belongs to a
# run that died without cleaning up. Taking a stale lock over is itself a
# critical section, guarded by a second mkdir marker: two runs that both see
# the same stale lock must not both remove it, or the second removal would
# delete the lock the first run had just taken. The winner checks the age
# again once it holds the marker; a marker a killed run left behind is
# ignored after five minutes.
take_lock() {
  mkdir -p "$STATE" || return 1
  if ! mkdir "$LOCK" 2>/dev/null; then
    if [ -z "$(find "$LOCK" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
      err "another dotfiles-apps run holds the lock ($LOCK); if none is running it goes stale after 1 hour"
      return 1
    fi
    [ -n "$(find "$LOCK.steal" -maxdepth 0 -mmin +5 2>/dev/null)" ] && rmdir "$LOCK.steal" 2>/dev/null
    if ! mkdir "$LOCK.steal" 2>/dev/null; then
      err "another dotfiles-apps run is taking over the stale lock ($LOCK); try again"
      return 1
    fi
    if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
      err "removing a stale lock (older than 1 hour): $LOCK"
      rm -rf "$LOCK"
    fi
    if ! mkdir "$LOCK" 2>/dev/null; then
      rmdir "$LOCK.steal" 2>/dev/null
      err "another run holds the lock: $LOCK"
      return 1
    fi
    rmdir "$LOCK.steal" 2>/dev/null
  fi
  LOCK_HELD=1
  printf '%s\n' "$$" >"$LOCK/pid"
  trap release_lock EXIT
  trap 'exit 130' INT TERM
}

#############################################################################
# Validation: nothing reaches iCloud or $HOME unless it passes
#############################################################################

# plutil -lint also accepts plain text (a file holding the word "garbage"
# parses as an old-style ASCII plist string), so also require what preference
# files actually are: an XML plist or a binary one.
plist_format_ok() {
  case "$(head -c 6 "$1")" in bplist) return 0 ;; esac
  grep -q '<plist' "$1"
}

# validate_symlinks <dir>: copy mode never stores or restores a symlink.
validate_symlinks() {
  local dir="$1" f rc=0
  while IFS= read -r f; do
    err "refusing: '${f#"$dir"/}' is a symlink; copy mode never stores or restores symlinks"
    rc=1
  done < <(find "$dir" -type l)
  return "$rc"
}

# validate_plists <dir> [keep]: no zero-byte or invalid plists. With "keep"
# they are only reported: a rescue copy must hold whatever is on disk now,
# corrupt or not, because a corrupt local file is the usual reason to restore.
validate_plists() {
  local dir="$1" keep="${2:-}" f rc=0 what
  while IFS= read -r f; do
    what=""
    if [ ! -s "$f" ]; then
      what="a zero-byte plist"
    elif ! plutil -lint "$f" >/dev/null 2>&1 || ! plist_format_ok "$f"; then
      what="not a valid plist (plutil -lint failed)"
    fi
    [ -n "$what" ] || continue
    if [ -n "$keep" ]; then
      err "note: '${f#"$dir"/}' is $what; it is kept as it is in the rescue copy"
    else
      err "refusing: '${f#"$dir"/}' is $what"
      rc=1
    fi
  done < <(find "$dir" -type f -name '*.plist')
  return "$rc"
}

# validate_tree <dir>: both checks, reporting every problem before failing.
validate_tree() {
  local rc=0
  validate_symlinks "$1" || rc=1
  validate_plists "$1" || rc=1
  return "$rc"
}

# 6.5: the old link mode leaves covered paths as symlinks into the storage
# folder. Refuse to copy through them.
# A copy restore replaces a symlink with a file, so no covered path may
# resolve into the dotfiles repos. Every candidate (the covered path, each
# ancestor up to $HOME, every symlink found below it) is resolved fully and
# physically (relative links, chains, /var vs /private/var, symlinked parents)
# by one perl (it ships with macOS) and compared with the resolved repo roots.
guard_repo_links() {
  local app p full d rc=0 prc kind root real perl_bin="${DOTFILES_APPS_PERL:-perl}"
  local priv="${DOTFILES_PRIVATE_DIR:-$HOME/.dotfiles-private}"
  local cands="$STATE/repo-links.in" out="$STATE/repo-links.out"
  set -- "$DOTFILES_DIR"
  # The private repo is optional only when it does not exist at all.
  if [ -e "$priv" ] || [ -L "$priv" ]; then set -- "$@" "$priv"; fi
  if ! command -v "$perl_bin" >/dev/null 2>&1; then
    err "perl is missing, so the symlink guard cannot resolve paths; refusing"
    return 1
  fi
  # NUL-separated app, path pairs: a newline in a path cannot split a record.
  {
    for app in $(allowlist); do
      while IFS= read -r p; do
        [ -n "$p" ] || continue
        full="$HOME/${p%/}"
        { [ -L "$full" ] || [ -e "$full" ]; } || continue
        printf '%s\0%s\0' "$app" "$full"
        d=$(dirname "$full")
        while [ "$d" != "$HOME" ] && [ "$d" != / ] && [ "$d" != . ]; do
          printf '%s\0%s\0' "$app" "$d"
          d=$(dirname "$d")
        done
        find "$full" -type l -print0 2>/dev/null | while IFS= read -r -d '' l; do
          printf '%s\0%s\0' "$app" "$l"
        done
      done <<EOF
$(app_paths "$app")
EOF
    done
  } >"$cands" || { err "could not list the paths to check for repo symlinks; refusing"; return 1; }
  # shellcheck disable=SC2016
  "$perl_bin" -MCwd=realpath -e '
    $/ = "\0"; $\ = "";
    my @roots;
    for my $r (@ARGV) {
      my $x = realpath($r);
      if (!defined $x) { print "R\0$r\0\0\0"; exit 3 }
      push @roots, $x;
    }
    @ARGV = ();
    while (defined(my $app = <STDIN>)) {
      my $c = <STDIN>;
      if (!defined $c) { print "M\0\0\0\0"; exit 4 }
      chomp $app; chomp $c;
      my $r = realpath($c);
      if (!defined $r) { print "U\0$app\0$c\0\0"; next }
      for my $root (@roots) {
        if ($r eq $root || index($r, "$root/") == 0) { print "H\0$app\0$c\0$r\0"; last }
      }
    }' "$@" <"$cands" >"$out"
  prc=$?
  while IFS= read -r -d '' kind && IFS= read -r -d '' app && IFS= read -r -d '' p && IFS= read -r -d '' real; do
    case "$kind" in
      R) err "cannot resolve the repo directory '$app'; refusing"; rc=1 ;;
      H) err "SYMLINK: '$p' ($app) resolves into the dotfiles repo ($real); a copy would replace the link, so this app cannot cover it"; rc=1 ;;
      U) err "SYMLINK: '$p' ($app) cannot be resolved (a link loop or a missing target); refusing"; rc=1 ;;
      *) err "symlink guard: malformed record; refusing"; rc=1 ;;
    esac
  done <"$out"
  if [ "$prc" -ne 0 ]; then
    err "the symlink guard failed (perl exit $prc); refusing"
    rc=1
  fi
  return "$rc"
}

guard_symlinks() {
  local app p full l target rc=0
  for app in $(allowlist); do
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      full="$HOME/${p%/}"
      { [ -L "$full" ] || [ -e "$full" ]; } || continue
      # find -type l on a symlink itself reports it; inside a directory it
      # reports the links below it.
      while IFS= read -r l; do
        target=$(readlink "$l")
        case "$target" in
          "$STORE" | "$STORE"/* | "$STATE"/* | */Mackup | */Mackup/* | *com~apple~CloudDocs*)
            err "SYMLINK: '$l' ($app) is a symlink into cloud storage ($target), left by mackup's old link mode. Replace it with a real copy: rm '$l' && cp -R '$target' '$l' -- then run again"
            rc=1
            ;;
        esac
      done < <(find "$full" -type l 2>/dev/null)
    done <<EOF
$(app_paths "$app")
EOF
  done
  guard_repo_links || rc=1
  return "$rc"
}

#############################################################################
# Stage, publish, rotate
#############################################################################

strip_ansi() { sed "s/$(printf '\033')\[[0-9;]*m//g"; }

# Local files to a fresh staging tree with `mackup backup`, then validate.
# `stage_local rescue` is lenient about the plists' contents (see
# validate_plists) and still refuses symlinks and TCC denials.
stage_local() {
  local mode="${1:-}" out="$STATE/last-mackup.log" rc denials
  write_run_cfg || return 1
  case "$STAGE" in "$STATE"/*) ;; *) err "bad staging path"; return 1 ;; esac
  rm -rf "$STAGE"
  mkdir -p "$STAGE" || return 1

  run_mackup -f -v backup 2>&1 | strip_ansi >"$out"
  rc=${PIPESTATUS[0]}

  # A TCC denial is not a mackup failure: it prints the error and carries on.
  denials=$(awk '
    /^--- .* ---$/ { app = $0; sub(/^--- /, "", app); sub(/ ---$/, "", app); next }
    /Operation not permitted|permission issue|Permission denied/ { print (app == "" ? "?" : app) ": " $0 }
  ' "$out")
  if [ -n "$denials" ]; then
    err "macOS denied access (TCC / permissions); grant the terminal Full Disk Access or drop the app from the allowlist:"
    printf '%s\n' "$denials" | sed 's/^/  /' >&2
    return 1
  fi
  if [ "$rc" -ne 0 ]; then
    err "mackup backup failed (exit $rc); last output:"
    tail -n 10 "$out" | sed 's/^/  /' >&2
    return 1
  fi
  if [ -z "$(find "$STAGE" -type f | head -n 1)" ]; then
    err "nothing to back up: none of the allowlisted apps has files on this Mac, so no snapshot was published"
    return 3
  fi
  if [ "$mode" = rescue ]; then
    validate_symlinks "$STAGE" && validate_plists "$STAGE" keep
  else
    validate_tree "$STAGE"
  fi
}

# Snapshot directory names under <parent>, oldest first. Names are UTC
# timestamps, so a plain sort is chronological; .tmp-* copies never match.
snapshot_names() {
  local d
  for d in "$1"/[0-9]*; do
    [ -d "$d" ] && basename "$d"
  done | sort
}

# Manifest: a header line, then one line per file, "sha256<TAB>size<TAB>relative
# path", covering everything under <dir>. The header carries the file count and
# the SHA-256 of the body ("# dotfiles-apps manifest v1 files=N sha256=H"), so a
# manifest that iCloud truncated or half-synced is refused instead of trusted.
# iCloud can leave a file under its real name but not downloaded, so restore
# checks every byte against it. Only the root MANIFEST is left out of the
# listing: an app file called MANIFEST deeper in the tree is listed like any
# other.
sha_of() { shasum -a 256 "$1" | cut -d' ' -f1; }
write_manifest() { # write_manifest <tree> <out>
  local f n=0 body="$2.body"
  : >"$body" || return 1
  while IFS= read -r f; do
    printf '%s\t%s\t%s\n' "$(sha_of "$1/$f")" "$(wc -c <"$1/$f" | tr -d ' ')" "$f" >>"$body" || return 1
    n=$((n + 1))
  done < <(cd "$1" && find . -type f ! -path ./MANIFEST | sed 's|^\./||' | sort)
  { printf '# dotfiles-apps manifest v1 files=%s sha256=%s\n' "$n" "$(sha_of "$body")"; command cat "$body"; } >"$2" || return 1
  rm -f "$body"
}
verify_manifest() { # verify_manifest <snapshot dir>
  local dir="$1" sum size f rc=0 n=0 header want_n want_sha have_sha actual
  if [ ! -f "$dir/MANIFEST" ]; then
    err "no MANIFEST in $dir (a snapshot from before manifests, or not fully downloaded); refusing"
    return 1
  fi
  header=$(head -n 1 "$dir/MANIFEST")
  case "$header" in
    "# dotfiles-apps manifest v1 files="*" sha256="*) ;;
    *)
      err "manifest: $dir/MANIFEST has no valid header (an old or damaged manifest); refusing"
      return 1
      ;;
  esac
  want_n="${header#*files=}"
  want_n="${want_n%% *}"
  want_sha="${header##*sha256=}"
  have_sha=$(tail -n +2 "$dir/MANIFEST" | shasum -a 256 | cut -d' ' -f1)
  if [ "$have_sha" != "$want_sha" ]; then
    err "manifest: $dir/MANIFEST does not match the SHA-256 in its header (incomplete or altered); refusing"
    return 1
  fi
  while IFS=$'\t' read -r sum size f; do
    [ -n "$f" ] || continue
    n=$((n + 1))
    if [ ! -f "$dir/$f" ]; then
      err "manifest: '$f' is missing from the snapshot"
      rc=1
    elif [ "$(wc -c <"$dir/$f" | tr -d ' ')" != "$size" ]; then
      err "manifest: '$f' has the wrong size (not fully downloaded?)"
      rc=1
    elif [ "$(sha_of "$dir/$f")" != "$sum" ]; then
      err "manifest: '$f' does not match its SHA-256"
      rc=1
    fi
  done < <(tail -n +2 "$dir/MANIFEST")
  if [ "$n" -eq 0 ] || [ "$n" != "$want_n" ]; then
    err "manifest: $dir/MANIFEST lists $n file(s) but its header says $want_n; refusing"
    rc=1
  fi
  # Every file that is there must be listed: a file the manifest does not know
  # about was never verified.
  while IFS= read -r actual; do
    err "manifest: '$actual' is in the snapshot but not in the manifest"
    rc=1
  done < <(comm -13 <(tail -n +2 "$dir/MANIFEST" | awk -F'\t' '{ print $3 }' | LC_ALL=C sort) \
    <(cd "$dir" && find . -type f ! -path ./MANIFEST | sed 's|^\./||' | LC_ALL=C sort))
  return "$rc"
}

# publish <parent> <keep>: copy STAGE to <parent>/<UTC timestamp> under a
# temp name, rename when complete, then rotate. Echoes the snapshot name.
publish() {
  local parent="$1" keep="$2" ts name n=1 tmp count drop
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  name="$ts"
  mkdir -p "$parent" || { err "cannot create $parent"; return 1; }
  while [ -e "$parent/$name" ]; do n=$((n + 1)); name="$ts-$n"; done
  # Stale temp copies from a run that died; we hold the lock.
  rm -rf "$parent"/.tmp-* 2>/dev/null
  tmp="$parent/.tmp-$name"
  if ! mkdir "$tmp" || ! cp -R "$STAGE/." "$tmp/" || ! diff -r "$STAGE" "$tmp" >/dev/null 2>&1 ||
    ! write_manifest "$STAGE" "$tmp/MANIFEST" || ! verify_manifest "$tmp"; then
    rm -rf "$tmp"
    err "copying the snapshot to $parent failed or did not verify; nothing was published"
    return 1
  fi
  mv "$tmp" "$parent/$name" || { rm -rf "$tmp"; return 1; }

  count=$(snapshot_names "$parent" | grep -c .)
  if [ "$count" -gt "$keep" ]; then
    for drop in $(snapshot_names "$parent" | head -n "$((count - keep))"); do
      rm -rf "${parent:?}/$drop"
    done
  fi
  printf '%s' "$name"
}

#############################################################################
# The skip gate: should the daily backup do its work at all?
#############################################################################

# Scheduled runs only. A deterministic fact that work exists (no snapshot yet,
# or a file under an allowlisted app's prefs newer than the last snapshot) is
# passed as --work and always runs. Otherwise `dotfiles-jev skip apps` asks one
# question; only its literal SKIP skips, and a failure runs the backup.
skip_gate() { # skip_gate <machine>
  local jev="${DOTFILES_APPS_JEV:-$SELF_DIR/dotfiles-jev}" latest app p full changed="" facts="" work="" out n=0 unreadable=0 paths found
  [ -x "$jev" ] || return 0
  [ "${DOTFILES_JEV:-}" = off ] && return 0
  latest="$STORE/$1/latest"
  if [ ! -f "$latest" ]; then
    work="no snapshot has been published yet"
  else
    # Anything that stops the check from reading the prefs (mackup failing, no
    # run config, a find that is denied) must not look like "nothing changed":
    # it is a fact of work, so the job runs.
    write_run_cfg >/dev/null 2>&1 || unreadable=1
    for app in $(allowlist); do
      paths=$(app_paths "$app") || { unreadable=1; continue; }
      while IFS= read -r p; do
        [ -n "$p" ] || continue
        full="$HOME/${p%/}"
        [ -e "$full" ] || continue
        found=$(find "$full" -newer "$latest" 2>/dev/null) || unreadable=1
        if [ -n "$(printf '%s\n' "$found" | sed -n 1p)" ]; then
          n=$((n + 1))
          [ "$n" -le 20 ] && changed="${changed:+$changed, }$app"
          break
        fi
      done <<EOF2
$paths
EOF2
    done
    [ "$n" -gt 0 ] && work="app prefs changed since the last snapshot: $changed"
    if [ "$unreadable" -eq 1 ]; then work="${work:+$work; }could not read app prefs"; fi
  fi
  facts="allowlisted apps with prefs changed since the last snapshot: $n"
  if [ -n "$work" ]; then
    out=$(printf '%s\n' "$facts" | JEV_SCHEDULED=1 "$jev" skip apps --work "$work" 2>/dev/null) || return 0
  else
    out=$(printf '%s\n' "$facts" | JEV_SCHEDULED=1 "$jev" skip apps 2>/dev/null) || return 0
  fi
  printf '%s skip gate: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$out"
  case "$out" in SKIP*) return 1 ;; esac
  return 0
}

#############################################################################
# backup
#############################################################################

# rotate_log <file>: past DOTFILES_APPS_LOG_MAX bytes (256 KiB) the log moves
# to <file>.1, replacing the one before it, so the scheduled log holds at most
# about twice the cap however long the agent runs.
rotate_log() {
  local sz
  [ -f "$1" ] || return 0
  sz=$(wc -c <"$1" | tr -d ' ')
  [ "$sz" -gt "${DOTFILES_APPS_LOG_MAX:-262144}" ] && mv -f "$1" "$1.1"
  return 0
}

cmd_backup() {
  local scheduled=0 machine snap arg logf reason
  for arg in "$@"; do
    case "$arg" in
      --scheduled) scheduled=1 ;;
      *) err "backup: unknown option '$arg'"; return 2 ;;
    esac
  done

  if [ "$scheduled" -eq 1 ]; then
    logf="$HOME/Library/Logs/dotfiles-apps.log"
    mkdir -p "$(dirname "$logf")" && rotate_log "$logf" && exec >>"$logf" 2>&1
    printf '%s backup --scheduled\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fi

  # The daily agent runs on every Mac, including one with no mackup or no
  # iCloud Drive yet: that is nothing to report, so log one line and succeed.
  # An interactive run keeps failing loudly.
  if [ "$scheduled" -eq 1 ]; then
    reason=""
    if ! command -v mackup >/dev/null 2>&1; then
      reason="mackup is not installed"
    elif icloud_missing; then
      reason="iCloud Drive is not available"
    fi
    if [ -n "$reason" ]; then
      printf '%s skipped: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason"
      return 0
    fi
  fi

  machine=$(dotfiles_machine_name) || return 1
  store_ready || return 1
  if [ "$scheduled" -eq 1 ] && ! skip_gate "$machine"; then
    printf '%s skipped: the Jev skip gate judged there was nothing to back up\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    return 0
  fi
  take_lock || return 1
  cmd_check || return 1
  guard_symlinks || return 1
  stage_local || return 1
  snap=$(publish "$STORE/$machine/snapshots" 14) || return 1
  printf '%s\n' "$snap" >"$STORE/$machine/latest.tmp" && mv -f "$STORE/$machine/latest.tmp" "$STORE/$machine/latest" || return 1
  if [ "$scheduled" -eq 1 ]; then
    printf '%s ok: %s/%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$machine" "$snap"
  else
    say "backed up to $STORE/$machine/snapshots/$snap"
  fi
}

#############################################################################
# candidates: apps mackup could back up that nobody has decided on
#############################################################################

# The owner's "no" to a suggestion, remembered in the private repo so the app
# is not asked about again (one mackup app name per line).
DECLINED_FILE="${DOTFILES_APPS_DECLINED:-${DOTFILES_PRIVATE_DIR:-$HOME/.dotfiles-private}/jev/apps-declined.list}"

# Names under [applications_to_ignore] in the shipped config.
ignored_apps() {
  awk '/^\[/ { s = ($0 == "[applications_to_ignore]"); next }
       s && NF && $0 !~ /^[[:space:]]*[#;]/ { print $1 }' "$CFG_SRC"
}

# slug <name>: "Spark Mail.app" -> spark-mail, "-setapp" dropped, so a Setapp
# build and a direct one meet the same mackup definition.
slug() {
  printf '%s' "$1" | sed 's/\.app$//' | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-' |
    sed 's/--*/-/g; s/^-//; s/-$//; s/-setapp$//'
}

# app_build <bundle>: Setapp, App Store or direct, from code, not from a name.
app_build() {
  case "$1" in */Setapp/*) printf 'Setapp'; return ;; esac
  if [ -e "$1/Contents/_MASReceipt/receipt" ]; then printf 'App Store'; else printf 'direct'; fi
}

# app_process <bundle>: the executable name (CFBundleExecutable), which is what
# the restore guard looks for; empty unless it fits a strict charset, so it can
# be shown as a processes.list line. `|` and `;` never pass.
app_process() {
  local p
  p=$(defaults read "$1/Contents/Info" CFBundleExecutable 2>/dev/null) || return 0
  [[ $p =~ ^[A-Za-z0-9][A-Za-z0-9\ ._+()-]*$ ]] && printf '%s' "$p"
  return 0
}

# has_container <bundle>: the app's preferences live in a sandbox container.
has_container() {
  local id
  id=$(mdls -name kMDItemCFBundleIdentifier -raw "$1" 2>/dev/null)
  case "$id" in "" | "(null)" | */* | *..*) return 1 ;; esac
  [ -d "$HOME/Library/Containers/$id" ]
}

# cmd_candidates: "name<TAB>facts" per installed app (DOTFILES_APPS_APPDIR,
# default /Applications, plus its Setapp folder) that mackup supports and that
# is neither allowlisted, ignored nor declined. At most JEV_APPS_MAX_ITEMS
# (default 25). It only reads: no allowlist edit, no declined list, no request.
cmd_candidates() {
  local dir="${DOTFILES_APPS_APPDIR:-/Applications}" max="${JEV_APPS_MAX_ITEMS:-25}" n=0
  local supported skip bundle name paths np first build cont proc
  command -v mackup >/dev/null 2>&1 || return 0
  write_run_cfg || return 1
  supported=$(run_mackup list 2>/dev/null | sed -n 's/^ - //p')
  [ -n "$supported" ] || return 0
  skip=$( { allowlist; ignored_apps; cat "$DECLINED_FILE" 2>/dev/null; } | sed 's/-setapp$//')
  for bundle in "$dir"/*.app "$dir"/Setapp/*.app; do
    [ -d "$bundle" ] || continue
    [ "$n" -lt "$max" ] || break
    name=$(slug "$(basename "$bundle")")
    [ -n "$name" ] || continue
    # grep -c reads all of its input: -q would exit early and SIGPIPE the
    # printf of a list past the pipe buffer, which pipefail reports as "no match".
    [ "$(printf '%s\n' "$supported" | grep -cxF -- "$name")" -gt 0 ] || continue
    [ "$(printf '%s\n' "$skip" | grep -cxF -- "$name")" -eq 0 ] || continue
    paths=$(app_paths "$name") || continue
    np=$(printf '%s\n' "$paths" | grep -c .)
    first=$(printf '%s\n' "$paths" | awk 'NR <= 3 { gsub(/\t/, " "); printf "%s%s", (NR > 1 ? "; " : ""), $0 }' | cut -c 1-200)
    proc=$(app_process "$bundle")
    build=$(app_build "$bundle")
    cont=no
    has_container "$bundle" && cont=yes
    n=$((n + 1))
    printf '%s\tmackup covers a macOS app; paths=%s (%s); build=%s; sandbox container=%s%s\n' "$name" "$np" "$first" "$build" "$cont" "${proc:+; process=$proc}"
  done
}

#############################################################################
# restore, undo, list
#############################################################################

RESCUE_ROOT="$STATE/Mackup/rescue"

# Allowlisted apps whose processes are running, as "app (process)" lines.
# macOS truncates process names, so a long name is also tried at 15 and 16
# characters.
running_apps() {
  local app proc cand
  for app in $(allowlist); do
    while IFS= read -r proc; do
      [ -n "$proc" ] || continue
      # Electron and Chromium apps leave "<name> Helper" processes behind
      # after the main one quits; they hold the same preference files open.
      for cand in "$proc" "${proc:0:16}" "${proc:0:15}" "$proc Helper" "$proc Helper (Renderer)" "$proc Helper (GPU)"; do
        if pgrep -x "$cand" >/dev/null 2>&1; then
          printf '%s (%s)\n' "$app" "$proc"
          break
        fi
      done
    done <<EOF
$(app_procs "$app")
EOF
  done
}

# 6.4: after a restore no covered path may be a symlink.
restored_symlinks() {
  local app p full l rc=0
  for app in $(allowlist); do
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      full="$HOME/${p%/}"
      { [ -L "$full" ] || [ -e "$full" ]; } || continue
      while IFS= read -r l; do
        err "SYMLINK after restore: '$l' ($app) is a symlink; run 'dotfiles apps undo' to put the previous files back"
        rc=1
      done < <(find "$full" -type l 2>/dev/null)
    done <<EOF
$(app_paths "$app")
EOF
  done
  return "$rc"
}

# Ask iCloud for a snapshot and wait (DOTFILES_APPS_DL_WAIT seconds, default
# 60) until no *.icloud placeholder remains under it, polling every
# DOTFILES_APPS_DL_POLL seconds (default 2). Tests set both to 0.
materialise() {
  local dir="$1" wait="${DOTFILES_APPS_DL_WAIT:-60}" poll="${DOTFILES_APPS_DL_POLL:-2}" waited=0 left
  command -v brctl >/dev/null 2>&1 && brctl download "$dir" >/dev/null 2>&1
  while :; do
    left=$(placeholders "$dir")
    [ -z "$left" ] && return 0
    [ "$waited" -ge "$wait" ] && break
    sleep "$poll"
    waited=$((waited + 2))
  done
  err "iCloud has not finished downloading $dir; these placeholder(s) remain, so nothing was restored (try again shortly):"
  printf '%s\n' "$left" | head -n 10 | sed 's/^/  /' >&2
  return 1
}

# Placeholders for the snapshot: files under it, or the directory itself.
placeholders() {
  local dir="$1"
  [ -e "$(dirname "$dir")/.$(basename "$dir").icloud" ] && printf '%s\n' "$(dirname "$dir")/.$(basename "$dir").icloud"
  [ -d "$dir" ] && find "$dir" -name '*.icloud'
  return 0
}

# apply_snapshot <dir> [rescue]: validate, refuse while apps run, rescue,
# restore. <dir> holds the Mackup/ tree. Local files are only touched after
# every check has passed and the rescue copy exists. A rescue copy being put
# back (`undo`) is validated leniently, like the rescue that made it.
apply_snapshot() {
  local dir="$1" mode="${2:-}" running rc rescue
  if [ "$mode" = rescue ]; then
    validate_symlinks "$dir" && validate_plists "$dir" keep || return 1
  else
    validate_tree "$dir" || return 1
  fi

  verify_manifest "$dir" || return 1

  running=$(running_apps)
  if [ -n "$running" ]; then
    err "quit these apps first (restoring under a running app is overwritten on quit):"
    printf '%s\n' "$running" | sed 's/^/  /' >&2
    return 1
  fi

  stage_local rescue
  rc=$?
  if [ "$rc" -eq 0 ]; then
    rescue=$(publish "$RESCUE_ROOT" 14) || return 1
    say "rescue copy of the current settings: $RESCUE_ROOT/$rescue (undo with: dotfiles apps undo)"
  elif [ "$rc" -eq 3 ]; then
    say "nothing local to rescue (no covered files yet on this Mac)"
  else
    err "could not take a rescue copy of the current settings, so nothing was restored"
    return 1
  fi

  rm -rf "$STAGE"
  mkdir -p "$STAGE" || return 1
  cp -R "$dir/." "$STAGE/" || { err "could not stage the snapshot"; return 1; }
  # mackup restores from this copy, not from iCloud, and iCloud can change a
  # file between the check above and the copy: verify what will be applied.
  verify_manifest "$STAGE" || { err "the staged copy does not match the manifest, so nothing was restored"; return 1; }
  # From here local files may have changed, so the preferences daemon must be
  # flushed on EVERY path: it caches plists, and an app that starts now could
  # otherwise see, and later write back, the old values.
  local mrc=0 srcrc=0
  run_mackup -f restore >"$STATE/last-mackup.log" 2>&1 || mrc=$?
  restored_symlinks || srcrc=1
  killall cfprefsd >/dev/null 2>&1 || true
  if [ "$mrc" -ne 0 ]; then
    err "mackup restore failed (exit $mrc) after files may have changed; cfprefsd was flushed anyway. Run 'dotfiles apps undo' to put the previous files back. Output:"
    tail -n 10 "$STATE/last-mackup.log" | sed 's/^/  /' >&2
    return 1
  fi
  if [ "$srcrc" -ne 0 ]; then
    err "cfprefsd was flushed; run 'dotfiles apps undo' to put the previous files back"
    return 1
  fi
}

# Common front of restore and undo: store, lock, guards.
restore_preflight() {
  store_ready no_create || return 1
  take_lock || return 1
  cmd_check || return 1
  guard_symlinks || return 1
}

cmd_restore() {
  local from="" snap="" machine dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)
        [ $# -ge 2 ] || { err "restore: --from needs a machine name"; return 2; }
        from="$2"
        shift 2
        ;;
      -*) err "restore: unknown option '$1'"; return 2 ;;
      *) snap="$1"; shift ;;
    esac
  done

  machine="${from:-$(dotfiles_machine_name)}" || return 1
  printf '%s' "$machine" | grep -Eq '^[A-Za-z0-9-]+$' || { err "invalid machine name '$machine'"; return 2; }
  if [ -n "$snap" ]; then
    printf '%s' "$snap" | grep -Eq '^[0-9]{8}T[0-9]{6}Z(-[0-9]+)?$' || { err "invalid snapshot name '$snap'"; return 2; }
  fi

  restore_preflight || return 1
  machine_dirs | grep -Fxq -- "$machine" || { err "no snapshots for '$machine' in $STORE (see: dotfiles apps list)"; return 1; }
  if [ -z "$snap" ]; then
    snap=$(tr -d '[:space:]' <"$STORE/$machine/latest" 2>/dev/null)
    printf '%s' "$snap" | grep -Eq '^[0-9]{8}T[0-9]{6}Z(-[0-9]+)?$' || { err "no valid 'latest' for '$machine'; name a snapshot (see: dotfiles apps list)"; return 1; }
  fi
  dir="$STORE/$machine/snapshots/$snap"

  materialise "$dir" || return 1
  [ -d "$dir" ] || { err "no such snapshot: $machine/$snap (see: dotfiles apps list)"; return 1; }
  apply_snapshot "$dir" || return 1
  say "restored $machine/$snap"
  if [ -n "$DOMAIN_OVERLAP_APPS" ]; then
    say "run 'dotfiles configure --defaults' to re-apply the dotfiles' keys over the restored settings of:$DOMAIN_OVERLAP_APPS"
  fi
}

cmd_undo() {
  local last
  restore_preflight || return 1
  last=$(snapshot_names "$RESCUE_ROOT" | tail -n 1)
  [ -n "$last" ] || { err "no rescue copy to go back to (a restore takes one first)"; return 1; }
  apply_snapshot "$RESCUE_ROOT/$last" rescue || return 1
  say "put back the rescue copy $last"
}

# Machine folders in the store: a name in [A-Za-z0-9-] holding snapshots/.
# The store may also hold the old link-mode layout (.gitkraken, Library, ...);
# those are never machines and are never read, moved or deleted.
machine_dirs() {
  local d m
  for d in "$STORE"/*/; do
    [ -d "$d/snapshots" ] || continue
    m=$(basename "$d")
    printf '%s' "$m" | grep -Eq '^[A-Za-z0-9-]+$' && printf '%s\n' "$m"
  done
}

cmd_list() {
  local m d latest found=0
  if [ -d "$STORE" ]; then
    for m in $(machine_dirs); do
      latest=$(tr -d '[:space:]' <"$STORE/$m/latest" 2>/dev/null)
      for d in $(snapshot_names "$STORE/$m/snapshots"); do
        found=1
        if [ "$d" = "$latest" ]; then
          printf '%-24s %s  (latest)\n' "$m" "$d"
        else
          printf '%-24s %s\n' "$m" "$d"
        fi
      done
    done
  fi
  for d in $(snapshot_names "$RESCUE_ROOT"); do
    found=1
    printf '%-24s %s\n' "rescue (local)" "$d"
  done
  [ "$found" -eq 1 ] || say "no snapshots yet (dotfiles apps backup)"
}

#############################################################################
# Dispatch
#############################################################################

usage() {
  sed -n '3,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    check) cmd_check "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    undo) cmd_undo "$@" ;;
    list) cmd_list "$@" ;;
    candidates) cmd_candidates "$@" ;;
    "" | -h | --help | help) usage ;;
    *)
      err "unknown command '$cmd'"
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
