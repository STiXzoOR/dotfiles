#!/usr/bin/env bash
#
# dotfiles-secrets - secrets management on top of the macOS Keychain
#
# Usage: dotfiles-secrets <command> [options]
#
# Commands:
#   set <name> [value]    Store a secret (prompts for the value when none is given)
#   get <name>            Retrieve a secret
#   delete <name>         Delete a secret
#   list                  List stored secret names
#   export <file>         Export every secret to an encrypted file
#   import <file>         Import secrets from an encrypted file
#   env <name> <VARNAME>  Print an export statement for eval
#
# Bash 3.2 (macOS /bin/bash): no associative arrays, no mapfile, and never
# `((x++))` -- it returns 1 when the old value was 0, which aborts the script
# under errexit on bash 4.4+. That is why the import loop counted one secret
# and stopped on any newer bash.

set -euo pipefail

#############################################################################
# Configuration
#############################################################################

SERVICE_NAME="dotfiles"
ACCOUNT_PREFIX="dotfiles."

# Name of the index item. Secrets live in the data-protection keychain, which
# `security dump-keychain` cannot enumerate -- it only sees the legacy file
# keychain, so listing silently returned nothing and took `export` down with
# it. Keep our own index instead.
INDEX_ACCOUNT="${ACCOUNT_PREFIX}__index"

# The index is stored on ONE line, colon-delimited. `security -w` hex-encodes
# any value containing a control character, so a newline-delimited list reads
# back as unusable hex. Secret names therefore may not contain ':'.
INDEX_SEP=":"

# Every `security` call is scoped to $DOTFILES_KEYCHAIN when it is set, which
# is how the test suite exercises this tool without touching the login
# keychain. The ${a[@]+"${a[@]}"} form expands to nothing at all when the
# array is empty; a bare "${a[@]}" is an unbound-variable error under bash 3.2
# with set -u.
KEYCHAIN_ARGS=()
if [[ -n "${DOTFILES_KEYCHAIN:-}" ]]; then
  KEYCHAIN_ARGS=("$DOTFILES_KEYCHAIN")
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

#############################################################################
# Helper Functions
#############################################################################

print_usage() {
  cat << 'EOF'
Usage: dotfiles-secrets <command> [options]

Commands:
  set <name> [value]    Store a secret (prompts for the value when none given)
  get <name>            Retrieve a secret (outputs to stdout)
  delete <name>         Delete a secret
  list                  List all dotfiles secrets
  export <file>         Export secrets to an encrypted file
  import <file>         Import secrets from an encrypted file
  env <name> <VARNAME>  Output an export statement for shell eval

Options:
  -h, --help            Show this help message
  -q, --quiet           Suppress output messages

Examples:
  # Store a secret. security prompts on the terminal and reads the value
  # itself, so it never enters this process or any command line.
  dotfiles-secrets set github_token

  # Store a secret from a pipe, for scripted setup with no terminal to prompt
  # on. This keeps the value out of your shell history, but the value is still
  # passed to security on its command line, so it is visible in ps for the
  # length of that one call.
  printf '%s' "$TOKEN" | dotfiles-secrets set github_token

  # Retrieve a secret
  dotfiles-secrets get github_token

  # Use in shell config
  eval "$(dotfiles-secrets env github_token GITHUB_TOKEN)"

  # Delete, and list
  dotfiles-secrets delete github_token
  dotfiles-secrets list

  # Export every secret to an encrypted file, and read one back
  dotfiles-secrets export ~/secrets.age
  dotfiles-secrets import ~/secrets.age

Security notes:
  - Secrets live in the macOS Keychain, encrypted at rest and gated per item.
  - Only the interactive prompt -- `set <name>` with no value and nothing
    piped -- keeps the value off a command line. There, `security -w` reads it
    from the terminal itself.
  - Every other form of `set` execs `security add-generic-password -w <value>`,
    so the value is on that command line and readable out of `ps` by anything
    running as you, for as long as the call takes. A pipe avoids your shell
    history; it does not avoid `ps`. Use it for scripted setup, where there is
    no terminal to prompt on.
  - A value passed as an argument is exposed that same way AND recorded in
    your shell history. `set` warns when you do it.
  - A value containing a newline or a tab is rejected: `security -w`
    hex-encodes such a value on read, so it cannot round-trip. Base64-encode
    it first.
  - `export` writes a file that decrypts to every secret you own. It refuses
    to run non-interactively and refuses to write inside a git working tree.
  - Set DOTFILES_KEYCHAIN to a keychain path to scope every operation to it.
    It only appends that path to each `security` call, so it cannot be
    combined with the prompt: `security` prompts only when -w is its last
    argument. With it set, pipe the value to `set` instead, and accept the
    `ps` exposure described above.
  - Never commit secrets to git.
EOF
}

error() { echo -e "${RED}Error:${NC} $1" >&2; }
success() { [[ "${QUIET:-false}" == "true" ]] || echo -e "${GREEN}✓${NC} $1"; }
info() { [[ "${QUIET:-false}" == "true" ]] || echo -e "${BLUE}•${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1" >&2; }

check_macos() {
  if [[ "$(uname)" != "Darwin" ]]; then
    error "This tool requires macOS Keychain"
    echo "For Linux, consider using 'pass' or 'secret-tool'"
    exit 1
  fi
}

#############################################################################
# Validation
#############################################################################

_validate_name() {
  case "$1" in
    '')
      error "Secret name required"
      return 1
      ;;
    *"$INDEX_SEP"* | *=* | *[[:space:]]*)
      error "Invalid secret name '$1': no ':', '=' or whitespace"
      return 1
      ;;
  esac
  return 0
}

_validate_value() {
  case "$1" in
    '')
      error "Value cannot be empty"
      return 1
      ;;
    *[[:cntrl:]]*)
      error "Value contains a control character (a newline or a tab)."
      echo "  security -w hex-encodes such a value on read, so it would not" >&2
      echo "  round-trip. Base64-encode it and decode at the point of use." >&2
      return 1
      ;;
  esac
  return 0
}

# An unvalidated name reaches `eval` through `dotfiles-secrets env`:
# `env tok 'X; some-command'` emitted `export X; some-command=value`, and the
# documented usage is to eval that.
_validate_varname() {
  if [[ ! "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    error "Invalid variable name '$1': must match ^[A-Za-z_][A-Za-z0-9_]*$"
    return 1
  fi
  return 0
}

#############################################################################
# Keychain Functions
#############################################################################

# Reads one item's password.
#   0  value printed on stdout
#   1  no such item
#   2  the item exists but its data could not be read -- the keychain is
#      locked, or access was denied
#
# Every call used to send stderr to /dev/null and treat any failure as "not
# found", so a locked keychain was indistinguishable from an empty one and
# `export` reported "No secrets to export". `security` returns 44 for a
# missing item and 36, 45 or 128 for the locked and denied cases, but those
# codes are not documented as stable, so the state is established by asking
# twice: for the metadata, then for the password.
_read_item() {
  local account="$1" out rc
  out=$(security find-generic-password -s "$SERVICE_NAME" -a "$account" -w ${KEYCHAIN_ARGS[@]+"${KEYCHAIN_ARGS[@]}"} 2> /dev/null) && rc=0 || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    printf '%s\n' "$out"
    return 0
  fi
  if security find-generic-password -s "$SERVICE_NAME" -a "$account" ${KEYCHAIN_ARGS[@]+"${KEYCHAIN_ARGS[@]}"} > /dev/null 2>&1; then
    return 2
  fi
  return 1
}

keychain_set() {
  local name="$1" value="$2" account="${ACCOUNT_PREFIX}${1}"
  _validate_name "$name" || return 1
  _validate_value "$value" || return 1

  # The value goes on security's command line here, and so is visible in `ps`
  # for the length of this exec. That is true of a piped value exactly as it
  # is of one passed as an argument -- the pipe saves the shell history, not
  # the ps window. Only _set_prompting avoids it, by letting security read the
  # value off the terminal itself.
  #
  # No delete first: -U updates the item in place, so deleting bought nothing
  # and opened a window in which the old value was already gone if the add
  # then failed.
  security add-generic-password -s "$SERVICE_NAME" -a "$account" -U -w "$value" ${KEYCHAIN_ARGS[@]+"${KEYCHAIN_ARGS[@]}"} 2> /dev/null || return $?

  _index_add "$name"
}

keychain_delete() {
  local account="${ACCOUNT_PREFIX}${1}"
  security delete-generic-password -s "$SERVICE_NAME" -a "$account" ${KEYCHAIN_ARGS[@]+"${KEYCHAIN_ARGS[@]}"} > /dev/null 2>&1
}

_index_read() { _read_item "$INDEX_ACCOUNT"; }

# Emits one name per line. A locked keychain yields nothing here; callers that
# care about the difference ask _index_read for the status.
_index_names() {
  _index_read 2> /dev/null | tr "$INDEX_SEP" '\n' | grep -v '^$' | sort -u || true
}

_index_write() {
  security delete-generic-password -s "$SERVICE_NAME" -a "$INDEX_ACCOUNT" ${KEYCHAIN_ARGS[@]+"${KEYCHAIN_ARGS[@]}"} > /dev/null 2>&1 || true
  if [[ -z "$1" ]]; then
    return 0
  fi
  security add-generic-password -s "$SERVICE_NAME" -a "$INDEX_ACCOUNT" -w "$1" -U ${KEYCHAIN_ARGS[@]+"${KEYCHAIN_ARGS[@]}"} > /dev/null 2>&1
}

# stdin: one name per line -> a single colon-delimited line
_index_set_from_lines() {
  _index_write "$(grep -v '^$' | sort -u | paste -sd"$INDEX_SEP" -)"
}

_index_add() {
  {
    _index_names
    printf '%s\n' "$1"
  } | _index_set_from_lines
}

# Was defined and called from nowhere, so a deleted secret lingered in the
# index until the next `list` pruned it -- which meant `list`, a read command,
# wrote to the keychain on nearly every invocation and could raise an
# unexpected authorisation prompt.
_index_remove() {
  _index_names | grep -vxF "$1" | _index_set_from_lines
}

# All secret names. Self-healing: an indexed name that no longer resolves is
# dropped, so an item deleted by hand in Keychain Access cannot wedge the list.
keychain_list() {
  local name keep=()
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if _read_item "${ACCOUNT_PREFIX}${name}" > /dev/null 2>&1; then
      printf '%s\n' "$name"
      keep+=("$name")
    fi
  done < <(_index_names)

  # Rewrite only when the index actually drifted.
  local rebuilt current
  rebuilt=$(printf '%s\n' ${keep[@]+"${keep[@]}"} | grep -v '^$' | sort -u | paste -sd"$INDEX_SEP" - || true)
  current=$(_index_read 2> /dev/null || true)
  if [[ "$rebuilt" != "$current" ]]; then
    printf '%s\n' ${keep[@]+"${keep[@]}"} | _index_set_from_lines
  fi
}

#############################################################################
# Passphrase handling
#############################################################################

# Reads a passphrase into $SECRETS_PASSPHRASE without echoing it. openssl
# cannot prompt here: its stdin carries the plaintext stream, so the
# passphrase goes over fd 3 -- never a temp file, never argv.
_read_passphrase() {
  local prompt="$1" confirm="${2:-false}" p1 p2
  printf '%s: ' "$prompt" >&2
  IFS= read -rs p1 < /dev/tty
  printf '\n' >&2
  if [[ "$confirm" == true ]]; then
    printf 'Confirm: ' >&2
    IFS= read -rs p2 < /dev/tty
    printf '\n' >&2
    if [[ "$p1" != "$p2" ]]; then
      error "Passphrases do not match"
      return 1
    fi
  fi
  [[ -n "$p1" ]] || {
    error "Empty passphrase"
    return 1
  }
  SECRETS_PASSPHRASE="$p1"
}

#############################################################################
# Commands
#############################################################################

# `security add-generic-password -w` with no value makes security itself
# prompt on the terminal (twice, for confirmation), so the plaintext never
# enters this process and never appears in any argv.
#
# -w has to be the final argument for that, which leaves no room for the
# trailing keychain path, so DOTFILES_KEYCHAIN and the prompt cannot both
# apply. Reading the value here instead would give that one variable a second,
# weaker implementation of `set` -- the code a test exercises would not be the
# code a user runs, which is the whole reason this path went untested. Refuse
# and say what to do instead.
_set_prompting() {
  local name="$1" account="${ACCOUNT_PREFIX}${1}"

  if [[ -n "${DOTFILES_KEYCHAIN:-}" ]]; then
    error "DOTFILES_KEYCHAIN is set, and security prompts only when -w is its last argument, which leaves no room for a keychain path"
    echo "  Pipe the value instead: printf '%s' \"\$value\" | dotfiles-secrets set $name" >&2
    return 1
  fi

  # No delete first: -U updates in place, and deleting before an add that can
  # still fail -- a mistyped confirmation does exactly that -- threw away the
  # value that was already stored.
  security add-generic-password -s "$SERVICE_NAME" -a "$account" -U -w || return $?

  _index_add "$name"
}

cmd_set() {
  local name="${1:-}" value="${2:-}" have_value=false
  _validate_name "$name" || {
    echo "Usage: dotfiles-secrets set <name> [value]" >&2
    exit 1
  }

  if [[ -n "$value" ]]; then
    have_value=true
    warn "A value on the command line lands in your shell history. Run 'dotfiles-secrets set $name' with no value and let security prompt: that is the only form that keeps the value off a command line, and so out of ps."
  elif [[ ! -t 0 ]]; then
    # The whole of stdin, with trailing newlines stripped, so that
    # `printf '%s' "$tok" | dotfiles-secrets set tok` stores exactly $tok and
    # a multi-line stream is rejected rather than silently truncated.
    value=$(cat)
    have_value=true
  fi

  if [[ "$have_value" == true ]]; then
    _validate_value "$value" || exit 1
    keychain_set "$name" "$value" || {
      error "Failed to store secret"
      exit 1
    }
  else
    _set_prompting "$name" || {
      error "Failed to store secret"
      exit 1
    }
  fi

  success "Secret '$name' stored in Keychain"
}

cmd_get() {
  local name="${1:-}" value rc
  _validate_name "$name" || exit 1

  value=$(_read_item "${ACCOUNT_PREFIX}${name}") && rc=0 || rc=$?
  case "$rc" in
    0) printf '%s\n' "$value" ;;
    2)
      error "Secret '$name' exists but could not be read: the keychain is locked or access was denied"
      exit 1
      ;;
    *)
      error "Secret '$name' not found"
      exit 1
      ;;
  esac
}

cmd_delete() {
  local name="${1:-}"
  _validate_name "$name" || exit 1

  if keychain_delete "$name"; then
    _index_remove "$name"
    success "Secret '$name' deleted"
  else
    error "Secret '$name' not found"
    exit 1
  fi
}

# Prints the stored names, or explains why it cannot.
_list_or_explain() {
  local secrets rc
  secrets=$(keychain_list) || true
  if [[ -n "$secrets" ]]; then
    printf '%s\n' "$secrets"
    return 0
  fi
  _index_read > /dev/null 2>&1 && rc=0 || rc=$?
  if [[ "$rc" -eq 2 ]]; then
    error "The keychain is locked or access was denied, so the secret list could not be read"
    return 2
  fi
  return 1
}

cmd_list() {
  local secrets rc
  secrets=$(_list_or_explain) && rc=0 || rc=$?
  case "$rc" in
    0) ;;
    2) exit 1 ;;
    *)
      info "No secrets stored"
      return
      ;;
  esac

  echo -e "${CYAN}Stored secrets:${NC}"
  echo ""
  while IFS= read -r name; do
    echo "  • $name"
  done <<< "$secrets"
  echo ""
  info "Use 'dotfiles-secrets get <name>' to retrieve a value"
}

_emit_secrets() {
  local name
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    printf '%s=%s\n' "$name" "$(_read_item "${ACCOUNT_PREFIX}${name}")"
  done <<< "$1"
}

cmd_export() {
  local output_file="${1:-}"
  if [[ -z "$output_file" ]]; then
    error "Output file required"
    echo "Usage: dotfiles-secrets export <file>" >&2
    exit 1
  fi

  # Interactive only. A bulk-decrypt-everything helper documented in a public
  # repo is a ready-made exfiltration primitive for anything running as you;
  # requiring a terminal means a script or an agent cannot drive it.
  if [[ ! -t 0 ]]; then
    error "export must be run interactively; stdin is not a terminal"
    exit 1
  fi

  local out_dir
  out_dir=$(dirname "$output_file")
  if git -C "$out_dir" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    error "Refusing to write secrets inside a git working tree: $out_dir"
    exit 1
  fi

  local secrets rc
  secrets=$(_list_or_explain) && rc=0 || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    # Exit non-zero either way: a backup script must not read "nothing to do"
    # as success.
    [[ "$rc" -eq 2 ]] || error "No secrets to export"
    exit 1
  fi

  umask 077
  if command -v age > /dev/null 2>&1; then
    # age -p derives the key with scrypt and encrypts with ChaCha20-Poly1305,
    # so the file is authenticated. openssl enc has no usable AEAD mode: a
    # tampered CBC file decrypts to garbage with no integrity signal.
    if ! _emit_secrets "$secrets" | age -p -o "$output_file"; then
      error "Failed to export secrets"
      rm -f "$output_file"
      exit 1
    fi
  else
    warn "age is not installed; falling back to openssl, which gives no integrity guarantee"
    _read_passphrase "Enter encryption password" true || exit 1
    if ! _emit_secrets "$secrets" \
      | openssl enc -aes-256-cbc -salt -pbkdf2 -iter 600000 \
        -pass fd:3 -out "$output_file" 3< <(printf '%s' "$SECRETS_PASSPHRASE"); then
      error "Failed to export secrets"
      rm -f "$output_file"
      exit 1
    fi
  fi

  chmod 600 "$output_file" 2> /dev/null || true
  success "Secrets exported to $output_file"
  warn "$output_file decrypts to every secret you own. Move it off this machine or delete it."
}

_is_age_file() {
  head -c 21 "$1" 2> /dev/null | grep -q 'age-encryption.org'
}

cmd_import() {
  local input_file="${1:-}"
  if [[ -z "$input_file" ]]; then
    error "Input file required"
    echo "Usage: dotfiles-secrets import <file>" >&2
    exit 1
  fi
  if [[ ! -f "$input_file" ]]; then
    error "File not found: $input_file"
    exit 1
  fi

  local use_age=false
  if _is_age_file "$input_file"; then
    if ! command -v age > /dev/null 2>&1; then
      error "$input_file is an age file but age is not installed"
      exit 1
    fi
    use_age=true
  else
    _read_passphrase "Enter decryption password" || exit 1
  fi

  # Streamed, never staged. The previous version decrypted into a temp file
  # and read it once, which left every secret on disk in the clear for the
  # life of the loop for no benefit at all.
  local count=0 failed=0 name value
  while IFS='=' read -r name value; do
    [[ -n "$name" ]] || continue
    if keychain_set "$name" "$value" 2> /dev/null; then
      count=$((count + 1))
    else
      warn "Failed to import: $name"
      failed=$((failed + 1))
    fi
  done < <(
    if [[ "$use_age" == true ]]; then
      age -d "$input_file" 2> /dev/null
    else
      openssl enc -aes-256-cbc -d -pbkdf2 -iter 600000 -in "$input_file" \
        -pass fd:3 3< <(printf '%s' "$SECRETS_PASSPHRASE") 2> /dev/null
    fi
  )

  if [[ "$count" -eq 0 ]]; then
    error "Imported nothing: wrong passphrase, or the file is not a secrets export"
    exit 1
  fi
  [[ "$failed" -eq 0 ]] || warn "$failed entr(ies) could not be imported"
  success "Imported $count secret(s)"
}

# Uppercase, with the separators a secret name may carry mapped to '_', then
# validated like any explicit name.
_default_varname() {
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr '.-' '__'
}

cmd_env() {
  local name="${1:-}" varname="${2:-}" value rc
  _validate_name "$name" || exit 1
  [[ -n "$varname" ]] || varname=$(_default_varname "$name")
  _validate_varname "$varname" || exit 1

  value=$(_read_item "${ACCOUNT_PREFIX}${name}") && rc=0 || rc=$?
  case "$rc" in
    0) ;;
    2)
      error "Secret '$name' exists but could not be read: the keychain is locked or access was denied"
      exit 1
      ;;
    *)
      error "Secret '$name' not found"
      exit 1
      ;;
  esac

  # %q so that a value holding quotes, semicolons or spaces cannot execute
  # when the caller evals this line.
  printf 'export %s=%q\n' "$varname" "$value"
}

#############################################################################
# Shell Integration
#############################################################################

# Usage in .zshrc: eval "$(dotfiles-secrets load github_token:GITHUB_TOKEN)"
cmd_load() {
  local arg name varname value
  for arg in "$@"; do
    case "$arg" in
      *:*)
        name="${arg%%:*}"
        varname="${arg##*:}"
        ;;
      *)
        name="$arg"
        varname=$(_default_varname "$arg")
        ;;
    esac

    _validate_name "$name" 2> /dev/null || continue
    _validate_varname "$varname" || continue
    value=$(_read_item "${ACCOUNT_PREFIX}${name}" 2> /dev/null) || continue
    printf 'export %s=%q\n' "$varname" "$value"
  done
}

#############################################################################
# Main
#############################################################################

main() {
  check_macos

  local command="${1:-}"
  shift || true

  QUIET=false
  while [[ "${1:-}" == -* ]]; do
    case "$1" in
      -q | --quiet)
        QUIET=true
        shift
        ;;
      -h | --help)
        print_usage
        exit 0
        ;;
      *)
        error "Unknown option: $1"
        exit 1
        ;;
    esac
  done

  case "$command" in
    set) cmd_set "${1:-}" "${2:-}" ;;
    get) cmd_get "${1:-}" ;;
    delete | rm | remove) cmd_delete "${1:-}" ;;
    list | ls) cmd_list ;;
    export) cmd_export "${1:-}" ;;
    import) cmd_import "${1:-}" ;;
    env) cmd_env "${1:-}" "${2:-}" ;;
    load) cmd_load "$@" ;;
    -h | --help | help | "") print_usage ;;
    *)
      error "Unknown command: $command"
      echo "Run 'dotfiles-secrets --help' for usage" >&2
      exit 1
      ;;
  esac
}

main "$@"
