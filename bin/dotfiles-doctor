#!/usr/bin/env zsh
#
# dotfiles-doctor - Diagnose common dotfiles issues
#
# Usage: dotfiles-doctor [--fix]
#
# Options:
#   --fix    Attempt to automatically fix issues
#

set -o pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Options
FIX_MODE=false
case "${1:-}" in
  --help | -h)
    echo "Usage: dotfiles-doctor [--fix]"
    echo ""
    echo "Diagnose common dotfiles issues."
    echo ""
    echo "Options:"
    echo "  --fix         Attempt to automatically fix issues"
    echo "  --help, -h    Show this help message"
    exit 0
    ;;
  --fix)
    FIX_MODE=true
    ;;
esac

# Get dotfiles directory. Repair it BEFORE sourcing anything out of it: the
# source used to sit above this fallback, so exactly when the fallback was
# needed the source had already failed, and every dotfiles_age_days call in
# check_cache then reported "command not found".
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
if [[ ! -d "$DOTFILES_DIR" ]]; then
  DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
fi

# Shared stat(1) portability helpers (GNU vs BSD).
source "$DOTFILES_DIR/scripts/lib/fs.sh"

# The Homebrew major version this repo's install path assumes. 7 introduced
# tap trust, which `dotfiles install --packages` relies on.
BREW_MIN_MAJOR=7

# Counters
ISSUES=0
WARNINGS=0
FIXED=0

#############################################################################
# Helper Functions
#############################################################################

ok() {
  echo -e "${GREEN}✓${NC} $1"
}

warn() {
  echo -e "${YELLOW}⚠${NC} $1"
  ((WARNINGS++))
}

error() {
  echo -e "${RED}✗${NC} $1"
  ((ISSUES++))
}

fix() {
  echo -e "${BLUE}→${NC} $1"
  ((FIXED++))
}

section() {
  echo ""
  echo -e "${BLUE}━━━ $1 ━━━${NC}"
}

#############################################################################
# Checks
#############################################################################

check_dotfiles_linked() {
  section "Symlink Status"

  local files=(".zshrc" ".zprofile" ".zpreztorc" ".vimrc" ".gitconfig")
  local all_linked=true

  for file in "${files[@]}"; do
    if [[ -L "$HOME/$file" ]]; then
      local target=$(readlink "$HOME/$file")
      if [[ "$target" == *"$DOTFILES_DIR"* ]] || [[ "$target" == *".dotfiles"* ]]; then
        ok "$file → $target"
      else
        warn "$file linked to unexpected location: $target"
      fi
    elif [[ -f "$HOME/$file" ]]; then
      error "$file exists but is not a symlink (run: dotfiles link)"
      all_linked=false
    else
      warn "$file not found"
    fi
  done

  # Check .config directory
  if [[ -d "$HOME/.config" ]]; then
    local config_dirs=("git" "starship" "karabiner")
    for dir in "${config_dirs[@]}"; do
      if [[ -L "$HOME/.config/$dir" ]]; then
        ok ".config/$dir is linked"
      elif [[ -d "$HOME/.config/$dir" ]]; then
        warn ".config/$dir exists but is not a symlink"
      fi
    done
  fi
}

check_submodules() {
  section "Git Submodules"

  pushd "$DOTFILES_DIR" >/dev/null 2>&1

  local submodules=("modules/prezto" "modules/prezto-contrib" "modules/stevenblack-hosts")
  for submodule in "${submodules[@]}"; do
    if [[ -d "$submodule" && -n "$(ls -A "$submodule" 2>/dev/null)" ]]; then
      ok "$submodule initialized"
    else
      error "$submodule not initialized"
      if $FIX_MODE; then
        fix "Initializing submodules..."
        git submodule update --init --recursive
      fi
    fi
  done

  popd >/dev/null 2>&1
}

check_homebrew() {
  section "Homebrew"

  if command -v brew &>/dev/null; then
    local brew_version brew_major
    brew_version=$(brew --version | head -1 | sed -E 's/^Homebrew ([0-9]+\.[0-9]+\.[0-9]+).*/\1/')
    ok "Homebrew installed: $brew_version"

    # Homebrew 7 will not load a third-party tap's formulae, casks or commands
    # until the tap is trusted (`brew trust --tap`), which `install --packages`
    # now does. On an older Homebrew that command does not exist and a fresh
    # bootstrap silently skips the trust step.
    brew_major="${brew_version%%.*}"
    if [[ "$brew_major" =~ ^[0-9]+$ ]] && ((brew_major < BREW_MIN_MAJOR)); then
      warn "Homebrew $brew_version is older than $BREW_MIN_MAJOR (run: brew update)"
    fi

    # Check for issues
    local brew_issues=$(brew doctor 2>&1 | grep -c "Warning")
    if [[ $brew_issues -gt 0 ]]; then
      warn "brew doctor reports $brew_issues warning(s)"
    else
      ok "brew doctor: no issues"
    fi

    # Check outdated packages
    local outdated=$(brew outdated --quiet | wc -l | tr -d ' ')
    if [[ $outdated -gt 0 ]]; then
      warn "$outdated outdated package(s) (run: brew upgrade)"
    else
      ok "All packages up to date"
    fi
  else
    error "Homebrew not installed"
    if $FIX_MODE; then
      fix "Installing Homebrew..."
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
  fi
}

check_shell() {
  section "Shell Configuration"

  # Check default shell
  if [[ "$SHELL" == *"zsh"* ]]; then
    ok "Default shell is zsh"
  else
    warn "Default shell is not zsh: $SHELL"
    if $FIX_MODE; then
      fix "Changing default shell to zsh..."
      chsh -s $(which zsh)
    fi
  fi

  # Check ZDOTDIR
  if [[ -n "$ZDOTDIR" ]]; then
    ok "ZDOTDIR is set: $ZDOTDIR"
  fi

  # Check prezto
  if [[ -f "$DOTFILES_DIR/modules/prezto/init.zsh" ]]; then
    ok "Prezto is available"
  else
    error "Prezto init.zsh not found"
  fi

  # Check starship
  if command -v starship &>/dev/null; then
    ok "Starship installed: $(starship --version)"
  else
    warn "Starship not installed"
  fi
}

check_cache() {
  section "Cache Status"

  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
  # Only caches the shell config actually writes. One the doctor watches but
  # nothing produces is reported "missing (will be created on next shell
  # start)" on every run, forever.
  #
  # Dropped: the old command-correction alias cache (pay-respects replaced it
  # and prints its integration in a couple of milliseconds, so system/
  # deliberately caches nothing for it) and the old Node manager's env cache
  # (system/.mise only prepends a directory, so there is nothing to cache).
  # dircolors is cached per TERM.
  local caches=(
    "zoxide-init.zsh:zoxide"
    "fzf-init.zsh:fzf"
    "brew-shellenv.zsh:brew"
    "npm-completion.zsh:npm"
    "dircolors-${TERM:-dumb}.zsh:dircolors"
  )

  for cache_info in "${caches[@]}"; do
    local cache_file="${cache_info%%:*}"
    local tool="${cache_info##*:}"

    if [[ -f "$cache_dir/$cache_file" ]]; then
      local age="$(dotfiles_age_days "$cache_dir/$cache_file")"
      [[ -n "$age" ]] || age=0
      if [[ $age -gt 7 ]]; then
        warn "$cache_file is $age days old (consider refreshing)"
      else
        ok "$cache_file exists (${age}d old)"
      fi
    else
      if command -v "$tool" &>/dev/null; then
        warn "$cache_file missing (will be created on next shell start)"
      fi
    fi
  done

  if $FIX_MODE; then
    # zsh's `read -p` reads from a coprocess, not from a prompt: print it
    # ourselves. The old gate was an unanchored (y|yes|Y), so "Nay" cleared
    # the caches.
    printf "Regenerate all caches? [y|N] "
    read -r response || response=""
    if [[ "$response" =~ ^([Yy]|[Yy][Ee][Ss])$ ]]; then
      fix "Clearing caches..."
      rm -f "$cache_dir"/*.zsh
      echo "Caches cleared. Restart your shell to regenerate."
    fi
  fi
}

check_tools() {
  section "Essential Tools"

  local tools=(
    "git:Version control"
    "stow:Symlink manager"
    "fzf:Fuzzy finder"
    "zoxide:Smart cd"
    "eza:Modern ls"
    "bat:Better cat"
    "fd:Better find"
    "rg:Ripgrep"
    "jq:JSON processor"
    "mise:Toolchain manager"
  )

  for tool_info in "${tools[@]}"; do
    local tool="${tool_info%%:*}"
    local desc="${tool_info##*:}"

    if command -v "$tool" &>/dev/null; then
      ok "$tool ($desc)"
    else
      warn "$tool not installed ($desc)"
    fi
  done
}

check_node() {
  section "Node.js Environment"

  if ! command -v mise &>/dev/null; then
    warn "mise not installed (run: dotfiles install --node)"
    return
  fi
  ok "mise installed"

  # Not the raw exit status. `mise doctor` is non-zero on this setup for two
  # things the repo chooses on purpose: it reports "not activated" because the
  # login path uses shims instead of activation, and it recommends the vfox
  # yarn backend, which config.toml disables along with every other plugin
  # backend. Reporting the exit status would warn on every run, forever --
  # exactly the defect this doctor already removed for caches nothing writes.
  # So drop those two and report whatever is left.
  local doctor_left
  doctor_left=$(mise doctor 2>&1 |
    grep -E '^[0-9]+\. ' |
    grep -vE 'not activated|vfox:mise-plugins/vfox-yarn')
  if [[ -z "$doctor_left" ]]; then
    ok "mise doctor reports nothing this repo does not choose"
  else
    warn "mise doctor: $(echo "$doctor_left" | head -3) (run: mise doctor)"
  fi

  local shims="$HOME/.local/share/mise/shims"
  if [[ -d "$shims" ]]; then
    ok "shims present at ~/.local/share/mise/shims"
  else
    warn "no shims yet; hooks and GUI apps will not find node (run: dotfiles install --node)"
  fi

  # `mise which node` answers for the tool mise would run, which is the
  # question worth asking; `node --version` answers for whatever is on PATH.
  if mise which node &>/dev/null; then
    ok "node: $(mise exec -- node --version 2>/dev/null || echo unknown)"
  else
    warn "no node version installed (run: dotfiles install --node)"
  fi

  if command -v pnpm &>/dev/null; then
    ok "pnpm: $(pnpm --version)"
  else
    warn "pnpm not installed"
  fi
}

check_git_config() {
  section "Git Configuration"

  if [[ -n "$(git config --global user.name)" ]]; then
    ok "Git user.name: $(git config --global user.name)"
  else
    warn "Git user.name not configured"
  fi

  if [[ -n "$(git config --global user.email)" ]]; then
    ok "Git user.email: $(git config --global user.email)"
  else
    warn "Git user.email not configured"
  fi

  if [[ -f "$HOME/.ssh/id_ed25519" ]]; then
    ok "SSH key exists"
  elif [[ -f "$HOME/.ssh/id_rsa" ]]; then
    ok "SSH key exists (RSA - consider upgrading to ed25519)"
  else
    warn "No SSH key found (run: dotfiles install --ssh)"
  fi
}

check_macos() {
  section "macOS Settings"

  if [[ "$(uname)" != "Darwin" ]]; then
    ok "Not macOS - skipping"
    return
  fi

  # Check if Xcode CLI tools are installed
  if xcode-select -p &>/dev/null; then
    ok "Xcode CLI tools installed"
  else
    error "Xcode CLI tools not installed"
    if $FIX_MODE; then
      fix "Installing Xcode CLI tools..."
      xcode-select --install
    fi
  fi

}

check_touchid_sudo() {
  section "Touch ID for sudo"

  # This repo no longer ships a NOPASSWD sudoers writer (that rule granted
  # passwordless root over a user-writable brew binary), so Touch ID is the
  # supported way to stop retyping the password.
  #
  # sudo_local, not sudo: macOS replaces /etc/pam.d/sudo on every OS update,
  # which silently undoes an edit made there. Reported, never fixed -- a bad
  # PAM edit locks you out of sudo entirely, and recovery means a recovery boot.
  if grep -q "pam_tid.so" /etc/pam.d/sudo_local 2>/dev/null; then
    ok "Touch ID for sudo enabled (/etc/pam.d/sudo_local)"
    return
  fi

  if grep -q "pam_tid.so" /etc/pam.d/sudo 2>/dev/null; then
    warn "Touch ID is enabled in /etc/pam.d/sudo, which OS updates overwrite"
    echo "    Move it to the drop-in that survives updates:"
  else
    warn "Touch ID for sudo not enabled"
    echo "    Enable it with:"
  fi

  echo "      sudo cp /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local"
  echo "      sudo sed -i '' 's/^#auth/auth/' /etc/pam.d/sudo_local"
}

#############################################################################
# Main
#############################################################################

main() {
  echo ""
  echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║     Dotfiles Doctor                    ║${NC}"
  echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
  echo ""
  echo "Checking: $DOTFILES_DIR"
  $FIX_MODE && echo -e "${YELLOW}Fix mode enabled${NC}"

  check_dotfiles_linked
  check_submodules
  check_shell
  check_homebrew
  check_cache
  check_tools
  check_node
  check_git_config
  check_macos
  check_touchid_sudo

  # Summary
  echo ""
  echo -e "${BLUE}━━━ Summary ━━━${NC}"
  echo ""

  if [[ $ISSUES -eq 0 && $WARNINGS -eq 0 ]]; then
    echo -e "${GREEN}Everything looks good!${NC}"
  else
    [[ $ISSUES -gt 0 ]] && echo -e "${RED}Issues:${NC}   $ISSUES"
    [[ $WARNINGS -gt 0 ]] && echo -e "${YELLOW}Warnings:${NC} $WARNINGS"
    [[ $FIXED -gt 0 ]] && echo -e "${BLUE}Fixed:${NC}    $FIXED"
  fi

  echo ""

  if [[ $ISSUES -gt 0 ]]; then
    echo "Run with --fix to attempt automatic fixes."
    exit 1
  fi
}

main "$@"
