#!/usr/bin/env bash
#
# dotfiles codexbar — the CodexBar settings its own iCloud sync leaves behind.
#
# CodexBar syncs most of itself through iCloud (Settings → iCloud Sync): the
# global preferences, which providers are on, quota warnings, accent colours
# and, if you opt in, end-to-end encrypted API keys and cookies. Two kinds of
# setting deliberately stay on each Mac, and those are what this command keeps
# in apps/codexbar/settings.json:
#
#   providers  each provider's data source: `source`, `cookieSource`,
#              `claudeDesktopCookiesEnabled`. Claude reads its limits from the
#              Claude desktop app's session ("web"), because the OAuth source
#              breaks every time Claude Code rewrites its Keychain item.
#   defaults   menu-bar presentation (the layout, merged icons, account
#              stacking), the terminal it opens, and the iCloud Sync switch
#              itself, so a new Mac joins the sync instead of starting alone.
#
#   dotfiles codexbar apply     write the repo's settings into this Mac
#   dotfiles codexbar diff      compare this Mac against the repo; exit 1 on drift
#   dotfiles codexbar capture   record this Mac's settings into the repo file
#   dotfiles codexbar check     validate the repo file against the allowlists
#
# apply sets what the file names and never removes anything. Provider fields go
# into CodexBar's config under its own write lock (it reloads the file on
# change); preferences need CodexBar quit, so a running CodexBar is quit and
# reopened, and only when a preference actually differs. Secrets never pass
# through here: the allowlists below are the only keys read or written.
#
# Exit status: 0 done or clean, 1 failure or drift, 2 CodexBar has not written
# its config yet (open it once).
#
# Bash 3.2 (macOS /bin/bash): no mapfile, no associative arrays.

set -uo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SELF="$ROOT_DIR/bin/dotfiles-codexbar"
SETTINGS="${DOTFILES_CODEXBAR_SETTINGS:-$ROOT_DIR/apps/codexbar/settings.json}"
# A domain name, or (tests) an absolute path to a plist without its extension.
DOMAIN="${DOTFILES_CODEXBAR_DOMAIN:-com.steipete.codexbar}"
BUNDLE_ID="com.steipete.codexbar"
LOCK_TIMEOUT="${DOTFILES_CODEXBAR_LOCK_TIMEOUT:-10}"

# CodexBar's iCloud sync carries none of these (ProviderIntentPayload in
# CodexBar's Sources/CodexBarCore/Sync/SyncModels.swift), and none is a secret.
PROVIDER_FIELDS='["source","cookieSource","claudeDesktopCookiesEnabled"]'
# Preferences outside CodexBar's synced set (SettingsStore+Sync.swift). The
# menu-bar layout key carries a version (menuBarLayoutV6) and is matched by
# pattern; only the newest one present is recorded. Not here: launchAtLogin
# (writing it does not register the login item) and anything CodexBar keeps
# per machine on purpose (device ids, window frames, Keychain fingerprints).
DEFAULT_KEYS='["iCloudSyncEnabled","iCloudSyncIncludeSecrets","iCloudSyncSnapshotsEnabled","iCloudSyncShowFleetAccounts","limitResetNotificationsEnabled","menuBarColorByProvider","menuBarHidesCritters","menuBarShowsBrandIconWithPercent","mergedOverviewLayout","mergeIcons","mergeIconsStacked","multiAccountMenuLayout","switcherShowsIcons","terminalApp"]'
LAYOUT_RE='^menuBarLayoutV[0-9]+$'

if [ -f "$ROOT_DIR/scripts/echos.sh" ]; then
  # shellcheck source=/dev/null
  source "$ROOT_DIR/scripts/echos.sh"
else
  ok() { printf '  ok   %s\n' "$1"; }
  warn() { printf '  warn %s\n' "$1"; }
  error() { printf '  FAIL %s\n' "$1"; }
  action() { printf '\n%s\n' "$1"; }
fi

TMP_DIR=""
cleanup() { [ -n "$TMP_DIR" ] && rm -rf "$TMP_DIR"; }
trap cleanup EXIT

tmp_dir() {
  [ -n "$TMP_DIR" ] || TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-codexbar.XXXXXX") || return 1
}

# The same resolution CodexBar uses (CodexBarConfigStore.defaultURL): the
# override, an absolute XDG_CONFIG_HOME, the XDG file when it exists, then the
# legacy file when it exists, else the XDG path. XDG_CONFIG_HOME is read from
# launchd's environment, which CodexBar.app is started with, not this shell's:
# bin/dotfiles always exports it, and a Mac whose CodexBar reads the legacy file
# was otherwise pointed at an XDG path that does not exist.
config_path() {
  local xdg
  xdg=$(launchctl getenv XDG_CONFIG_HOME 2>/dev/null)
  if [ -n "${CODEXBAR_CONFIG:-}" ]; then
    case "$CODEXBAR_CONFIG" in "~"/*) printf '%s' "$HOME/${CODEXBAR_CONFIG#"~/"}" ;; *) printf '%s' "$CODEXBAR_CONFIG" ;; esac
    return 0
  fi
  case "$xdg" in /*)
    printf '%s' "$xdg/codexbar/config.json"
    return 0
    ;;
  esac
  if [ -f "$HOME/.config/codexbar/config.json" ]; then
    printf '%s' "$HOME/.config/codexbar/config.json"
  elif [ -f "$HOME/.codexbar/config.json" ]; then
    printf '%s' "$HOME/.codexbar/config.json"
  else
    printf '%s' "$HOME/.config/codexbar/config.json"
  fi
}

need_jq() {
  command -v jq >/dev/null 2>&1 && return 0
  error "jq is not installed (brew install jq)"
  return 1
}

# Every key in the settings file is on an allowlist and has a type it can be
# written as. Prints one line per problem.
settings_problems() {
  jq -r --argjson pf "$PROVIDER_FIELDS" --argjson dk "$DEFAULT_KEYS" --arg lre "$LAYOUT_RE" '
    def scalar: type == "boolean" or type == "string" or type == "number";
    if type != "object" then "the file is not a JSON object" else
      ((keys - ["providers", "defaults"])[] | "unknown section: \(.)"),
      ((.providers // {}) | to_entries[] | .key as $p | .value | to_entries[]
        | if (.key as $k | $pf | any(. == $k)) | not then "providers.\($p).\(.key) is not on the allowlist"
          elif (.value | scalar) | not then "providers.\($p).\(.key) must be a boolean, string or number"
          else empty end),
      ((.defaults // {}) | to_entries[]
        | if (.key | test($lre)) then
            (if (.value | type) == "object" or (.value | type) == "array" then empty
             else "defaults.\(.key) must be the layout JSON (an object)" end)
          elif (.key as $k | $dk | any(. == $k)) | not then "defaults.\(.key) is not on the allowlist"
          elif (.value | scalar) | not then "defaults.\(.key) must be a boolean, string or number"
          else empty end)
    end' "$SETTINGS" 2>/dev/null || printf 'the file is not valid JSON\n'
}

check_settings() {
  local problems
  if [ ! -f "$SETTINGS" ]; then
    error "no settings file at $SETTINGS"
    return 1
  fi
  problems=$(settings_problems)
  if [ -n "$problems" ]; then
    printf '%s\n' "$problems" | while IFS= read -r p; do error "$SETTINGS: $p"; done
    return 1
  fi
  return 0
}

# ─── preferences (defaults) ─────────────────────────────────────────────────

# export_domain <file>: this Mac's CodexBar preferences as a plist file; an
# empty plist when the domain does not exist yet.
export_domain() {
  defaults export "$DOMAIN" "$1" 2>/dev/null && return 0
  printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<plist version="1.0"><dict/></plist>' >"$1"
}

# live_value <plist> <key>: the key's value as compact JSON, or nothing when it
# is absent or of a type this command does not carry.
live_value() {
  local plist="$1" key="$2" type raw
  type=$(plutil -type "$key" "$plist" 2>/dev/null) || return 0
  raw=$(plutil -extract "$key" raw -o - "$plist" 2>/dev/null) || return 0
  case "$type" in
    bool | integer | float) printf '%s' "$raw" ;;
    string) jq -cn --arg s "$raw" '$s' ;;
    data) printf '%s' "$raw" | base64 -d 2>/dev/null | jq -c . 2>/dev/null ;;
  esac
}

newest_layout_key() { # newest_layout_key <plist>
  plutil -p "$1" 2>/dev/null | sed -n -E 's/^ *"(menuBarLayoutV[0-9]+)" =>.*/\1/p' |
    sed 's/^menuBarLayoutV//' | sort -n | tail -n 1 | sed 's/^/menuBarLayoutV/'
}

# live_defaults <plist>: every allowlisted key this Mac holds, as one object.
live_defaults() {
  local plist="$1" key value out='{}' layout
  layout=$(newest_layout_key "$plist")
  for key in $(jq -r '.[]' <<<"$DEFAULT_KEYS") $layout; do
    value=$(live_value "$plist" "$key")
    [ -n "$value" ] || continue
    out=$(jq -c --arg k "$key" --argjson v "$value" '. + {($k): $v}' <<<"$out")
  done
  printf '%s' "$out"
}

write_default() { # write_default <key> <json value>
  local key="$1" value="$2" type hex
  type=$(jq -r 'if type == "number" then (if . == floor then "int" else "float" end) else type end' <<<"$value")
  case "$type" in
    boolean) defaults write "$DOMAIN" "$key" -bool "$(jq -r . <<<"$value")" ;;
    string) defaults write "$DOMAIN" "$key" -string "$(jq -r . <<<"$value")" ;;
    int) defaults write "$DOMAIN" "$key" -int "$value" ;;
    float) defaults write "$DOMAIN" "$key" -float "$value" ;;
    object | array)
      hex=$(jq -cj . <<<"$value" | od -An -tx1 | tr -d ' \n')
      defaults write "$DOMAIN" "$key" -data "$hex"
      ;;
    *) return 1 ;;
  esac
}

app_running() { pgrep -x CodexBar >/dev/null 2>&1; }

# A polite quit first, bounded so a pending Automation prompt cannot hang it;
# after five seconds SIGTERM, as the other defaults scripts do with killall.
quit_app() {
  local n=0
  osascript -e 'with timeout of 10 seconds' -e "tell application id \"$BUNDLE_ID\" to quit" -e 'end timeout' >/dev/null 2>&1
  while app_running; do
    [ "$n" -eq 25 ] && killall CodexBar >/dev/null 2>&1
    [ "$n" -ge 50 ] && return 1
    sleep 0.2
    n=$((n + 1))
  done
  return 0
}

apply_defaults() {
  local plist want key value live pending="" was_running=0 rc=0
  tmp_dir || return 1
  plist="$TMP_DIR/live.plist"
  export_domain "$plist"
  want=$(jq -c '.defaults // {}' "$SETTINGS")

  for key in $(jq -r 'keys[]' <<<"$want"); do
    value=$(jq -c --arg k "$key" '.[$k]' <<<"$want")
    live=$(live_value "$plist" "$key")
    if [ -n "$live" ] && jq -e --argjson a "$live" --argjson b "$value" -n '$a == $b' >/dev/null; then
      continue
    fi
    pending="$pending $key"
  done

  if [ -z "$pending" ]; then
    ok "preferences already match"
    return 0
  fi

  if app_running; then
    was_running=1
    if ! quit_app; then
      error "CodexBar did not quit, so its preferences were left alone (quit it and run: dotfiles codexbar apply)"
      return 1
    fi
  fi
  for key in $pending; do
    if write_default "$key" "$(jq -c --arg k "$key" '.[$k]' <<<"$want")"; then
      ok "preference $key"
    else
      error "could not write preference $key"
      rc=1
    fi
  done
  [ "$was_running" -eq 1 ] && { open -b "$BUNDLE_ID" >/dev/null 2>&1 || warn "could not reopen CodexBar"; }
  return "$rc"
}

# ─── provider fields (config.json) ──────────────────────────────────────────

# __merge <config> <settings>: run under CodexBar's config lock (see
# apply_providers). Prints "unchanged" or "changed"; on a change the previous
# file is kept as <config>.bak.<epoch> and CodexBar's own validation, when its
# CLI is installed, must accept the result or the previous file is put back.
merge_locked() {
  local cfg="$1" settings="$2" dir new backup
  dir=$(dirname "$cfg")
  new=$(mktemp "$dir/.config.json.XXXXXX") || return 1
  if ! jq --slurpfile s "$settings" '
      ($s[0].providers // {}) as $w
      | (.providers // []) as $ps
      | ($ps | map(.id)) as $ids
      | .providers = ($ps | map(. + ($w[.id] // {})))
          + [$w | to_entries[] | select(.key as $k | $ids | any(. == $k) | not) | {id: .key} + .value]
    ' "$cfg" >"$new"; then
    rm -f "$new"
    return 1
  fi
  if jq -e --slurpfile a "$cfg" --slurpfile b "$new" -n '$a[0] == $b[0]' >/dev/null; then
    rm -f "$new"
    printf 'unchanged\n'
    return 0
  fi
  backup="$cfg.bak.$(date +%s)"
  if ! { chmod 600 "$new" && cp -p "$cfg" "$backup" && mv -f "$new" "$cfg"; }; then
    rm -f "$new"
    return 1
  fi
  if command -v codexbar >/dev/null 2>&1 && ! CODEXBAR_CONFIG="$cfg" codexbar config validate >/dev/null 2>&1; then
    mv -f "$backup" "$cfg"
    printf 'rejected\n'
    return 1
  fi
  printf 'changed\n'
}

apply_providers() {
  local cfg result
  cfg=$(config_path)
  if [ "$(jq -r '.providers // {} | length' "$SETTINGS")" -eq 0 ]; then
    return 0
  fi
  if [ ! -f "$cfg" ]; then
    warn "CodexBar has not written its config yet ($cfg); open CodexBar once, then run: dotfiles codexbar apply"
    return 2
  fi
  # CodexBar serialises its own writes with flock on <config>.lock and keeps
  # that inode (-k): unlinking it could hand two writers different locks.
  result=$(/usr/bin/lockf -k -t "$LOCK_TIMEOUT" "$cfg.lock" /bin/bash "$SELF" __merge "$cfg" "$SETTINGS")
  case "$result" in
    unchanged) ok "provider data sources already match ($cfg)" ;;
    changed) ok "provider data sources written ($cfg)" ;;
    rejected)
      error "CodexBar rejected the merged config; $cfg was put back"
      return 1
      ;;
    *)
      error "could not update $cfg (is CodexBar holding its config lock?)"
      return 1
      ;;
  esac
}

# ─── commands ───────────────────────────────────────────────────────────────

cmd_apply() {
  local prc drc
  need_jq || return 1
  check_settings || return 1
  action "CodexBar: provider data sources and preferences"
  # Preferences still apply when the config is not there yet (exit 2).
  apply_providers
  prc=$?
  apply_defaults
  drc=$?
  if [ "$prc" -eq 1 ] || [ "$drc" -ne 0 ]; then return 1; fi
  return "$prc"
}

cmd_diff() {
  local cfg plist lines drift=0 status label detail
  need_jq || return 1
  check_settings || return 1
  cfg=$(config_path)
  if [ ! -f "$cfg" ]; then
    warn "CodexBar has not written its config yet ($cfg)"
    return 2
  fi
  tmp_dir || return 1
  plist="$TMP_DIR/live.plist"
  export_domain "$plist"

  # One line per item: status<TAB>label<TAB>detail.
  lines=$(jq -r --slurpfile s "$SETTINGS" --argjson pf "$PROVIDER_FIELDS" --argjson live "$(live_defaults "$plist")" '
      def show($o; $k): if ($o | has($k)) then ($o[$k] | tojson) else "unset" end;
      def cmp($label; $o; $k; $v):
        if ($o | has($k)) and ($o[$k] == $v) then "ok\t\($label)\t"
        else "differs\t\($label)\there \(show($o; $k)), repo \($v | tojson)" end;
      ($s[0].providers // {}) as $w
      | ($s[0].defaults // {}) as $d
      | (.providers // []) as $ps
      | ($w | to_entries[] | .key as $id | .value | to_entries[]
          | cmp("providers.\($id).\(.key)"; ([$ps[] | select(.id == $id)] | first // {}); .key; .value)),
        ($ps[] | .id as $id | to_entries[]
          | select(.key as $k | $pf | any(. == $k))
          | select(.key as $k | ($w[$id] // {}) | has($k) | not)
          | "unrecorded\tproviders.\($id).\(.key)\there \(.value | tojson), not in the repo"),
        ($d | to_entries[] | cmp("defaults.\(.key)"; $live; .key; .value)),
        ($live | to_entries[] | select(.key as $k | $d | has($k) | not)
          | "unrecorded\tdefaults.\(.key)\there \(.value | tojson), not in the repo")
    ' "$cfg")

  while IFS=$'\t' read -r status label detail; do
    [ -n "$status" ] || continue
    case "$status" in
      ok) ok "$label" ;;
      *)
        error "$label: $detail"
        drift=1
        ;;
    esac
  done <<<"$lines"

  if [ "$drift" -eq 1 ]; then
    warn "repo → this Mac: dotfiles codexbar apply; this Mac → repo: dotfiles codexbar capture"
    return 1
  fi
  ok "no drift"
}

cmd_capture() {
  local cfg plist out new
  need_jq || return 1
  cfg=$(config_path)
  if [ ! -f "$cfg" ]; then
    warn "CodexBar has not written its config yet ($cfg)"
    return 2
  fi
  tmp_dir || return 1
  plist="$TMP_DIR/live.plist"
  export_domain "$plist"
  out=$(jq -S --argjson pf "$PROVIDER_FIELDS" --argjson live "$(live_defaults "$plist")" '
      { providers: ([(.providers // [])[]
                      | {key: .id, value: (with_entries(select(.key as $k | $pf | any(. == $k))))}
                      | select(.value != {})] | from_entries),
        defaults: $live }' "$cfg") || return 1
  mkdir -p "$(dirname "$SETTINGS")" || return 1
  new=$(mktemp "$(dirname "$SETTINGS")/.settings.json.XXXXXX") || return 1
  if ! { printf '%s\n' "$out" >"$new" && mv -f "$new" "$SETTINGS"; }; then
    rm -f "$new"
    return 1
  fi
  ok "recorded this Mac in $SETTINGS (review with git diff, then commit it)"
}

usage() {
  cat <<'EOF'
Usage: dotfiles codexbar <command>

  apply     write the repo's provider data sources and preferences into this Mac
  diff      compare this Mac against apps/codexbar/settings.json; exit 1 on drift
  capture   record this Mac's settings into apps/codexbar/settings.json
  check     validate apps/codexbar/settings.json against the allowlists

Everything else CodexBar syncs itself through iCloud (Settings → iCloud Sync).
EOF
}

main() {
  case "${1:-}" in
    apply) cmd_apply ;;
    diff) cmd_diff ;;
    capture) cmd_capture ;;
    check) need_jq && check_settings && ok "$SETTINGS" ;;
    __merge) merge_locked "$2" "$3" ;;
    -h | --help | help | "") usage ;;
    *)
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
