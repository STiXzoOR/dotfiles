.AppleDouble
.DS_Store
.LSOverride
._*
.git_template/hooks/disabled-pc
__pycache__/
*.py[cod]
*$py.class
.Python
node_modules
apps/gitkraken/profiles/*/**
# NOTE: the live profile holds userEmail/userName and every local repo path.
# It is seeded from apps/gitkraken/profile.template by macos/defaults-gitkraken.sh.
config/karabiner/automatic_backups
config/spicetify/*
!config/spicetify/Themes
# The live config-xpui.ini holds an absolute prefs_path and is rewritten by
# spicetify itself; seeded from config-xpui.ini.template by dotfiles link.
!config/spicetify/*.ini.template
runcom/.vim/backup/*
!runcom/.vim/backup/.gitignore
runcom/.vim/temp/*
!runcom/.vim/temp/.gitignore
runcom/.vim/.netrwhist
runcom/.vim/bundle/*
!runcom/.vim/bundle/.gitignore
!runcom/.vim/bundle/Vundle.vim

# Claude Code project config
config/.claude/

# Machine-specific profile (contains secrets/local config)
profiles/local.zsh

# Brewfile lock (optional - can be committed for reproducibility)
Brewfile.lock.json

# Private/work Claude marketplaces + plugins (repo is public)
claude/*.local.list

# Machine-local git identity (this repo is public)
config/git/config.local

# Local logs -- do not rely on the user's global gitignore for these
*.log
.claude/
