<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.stixzoor.dotfiles-sync</string>

    <!--
      Daily check that keeps this Mac in step with the other one (bin/dotfiles-sync,
      see docs/agents/two-mac-sync.md). It fast-forwards the dotfiles and the
      private repo when that is safe, and posts one notification only when
      something needs you. Heavy steps (brew, mise) stay manual.

      There is no StandardOutPath: launchd expands neither ~ nor $HOME there,
      and the script logs itself to ~/Library/Logs/dotfiles-sync.log. It also
      sets its own PATH, because launchd's is /usr/bin:/bin:/usr/sbin:/sbin.
    -->
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-c</string>
      <string>exec "$HOME/.dotfiles/bin/dotfiles-sync" --scheduled</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
  </dict>
</plist>
