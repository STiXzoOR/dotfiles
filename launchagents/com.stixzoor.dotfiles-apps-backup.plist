<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.stixzoor.dotfiles-apps-backup</string>

    <!--
      Daily copy-mode backup of app settings (bin/dotfiles-apps, see
      docs/agents/app-settings.md). There is no StandardOutPath: launchd
      expands neither ~ nor $HOME there, and the script logs itself to
      ~/Library/Logs/dotfiles-apps.log. It also sets its own PATH, because
      launchd's is /usr/bin:/bin:/usr/sbin:/sbin and mackup lives in
      /opt/homebrew/bin.
    -->
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-c</string>
      <string>exec "$HOME/.dotfiles/bin/dotfiles-apps" backup --scheduled</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
  </dict>
</plist>
