# Completion configuration
# Note: compinit is handled by Prezto's completion module
# HOMEBREW_PREFIX is set by system/.path

# Dotfiles completion. Keep in sync with sub_help in bin/dotfiles.
_dotfiles_completions() {
  compadd 'baseline' 'cheatsheet' 'clean' 'configure' 'doctor' 'edit' 'help' \
    'hooks' 'install' 'link' 'open' 'profiler' 'secrets' 'setup' 'test' \
    'unlink' 'update'
}
compdef _dotfiles_completions dotfiles

# npm completion - cached, because `npm completion` costs about 90 ms.
# Both the source and the regeneration live inside the guard: without it an
# uninstalled npm still offered completions and an upgraded one never
# refreshed them (audit shell#19).
_npm_completion_file="${XDG_CACHE_HOME:-$HOME/.cache}/npm-completion.zsh"
if (( $+commands[npm] )); then
  if [[ ! -s "$_npm_completion_file" ]] || [[ "$commands[npm]" -nt "$_npm_completion_file" ]]; then
    mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
    npm completion >| "$_npm_completion_file" 2>/dev/null
  fi
  [[ -s "$_npm_completion_file" ]] && source "$_npm_completion_file"
fi
unset _npm_completion_file

# fzf completion trigger (completions loaded via .fzf using fzf --zsh)
export FZF_COMPLETION_TRIGGER=',,'

# Git completion is handled by Prezto's git module - removed redundant loading

# pnpm completion
_pnpm_completion() {
  local reply
  local si=$IFS

  IFS=$'\n' reply=($(COMP_CWORD="$((CURRENT - 1))" COMP_LINE="$BUFFER" COMP_POINT="$CURSOR" SHELL=zsh pnpm completion-server -- "${words[@]}"))
  IFS=$si

  if [ "$reply" = "__tabtab_complete_files__" ]; then
    _files
  else
    _describe 'values' reply
  fi
}
compdef _pnpm_completion pnpm
