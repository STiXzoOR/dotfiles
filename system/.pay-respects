# pay-respects - command correction (replaces thefuck, whose upstream has been
# dormant since 2024-07 with 460 open issues; pay-respects is Rust and active).
#
# The init output is cached, like .zoxide: it is only a few milliseconds, but
# those are a fork on every login shell, and the cache is regenerated when the
# binary is newer.
_pay_respects_cache="${XDG_CACHE_HOME:-$HOME/.cache}/pay-respects-init.zsh"

if (( $+commands[pay-respects] )); then
  if [[ ! -s "$_pay_respects_cache" || "$commands[pay-respects]" -nt "$_pay_respects_cache" ]]; then
    mkdir -p "${_pay_respects_cache:h}"
    # Temp file, then mv: a truncated cache is never left in place.
    if pay-respects zsh --alias fix >| "$_pay_respects_cache.$$" 2>/dev/null && [[ -s "$_pay_respects_cache.$$" ]]; then
      command mv -f "$_pay_respects_cache.$$" "$_pay_respects_cache"
    else
      command rm -f "$_pay_respects_cache.$$" "$_pay_respects_cache"
    fi
  fi
  [[ -s "$_pay_respects_cache" ]] && source "$_pay_respects_cache"
fi
unset _pay_respects_cache
