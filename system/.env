export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_RUNTIME_DIR="${HOME}/.local/runtime"

# Prefer US English and use UTF-8.
#
# LC_ALL is deliberately not set: it overrides every LC_* category at once and
# cannot be overridden per shell or per command. LANG plus LC_CTYPE gives the
# same UTF-8 behaviour and stays overridable (audit shell, improvement 8).
export LANG="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

# EDITOR is not set here: it depends on PATH, and this file runs before
# system/.path. See system/.editor.
export VEDITOR='code'
export PAGER='less'
export DOTFILES_IDE="code"
export DOTFILES_GIT_GUI="stree"

# Enable colors
export CLICOLOR=1

# Highlight section titles in man pages
export LESS_TERMCAP_md=$'\e[1;33m'

# Keep showing man page after exit
export MANPAGER='less -X'

# Increase open file limit
ulimit -S -n 8192

# Obsidian vault path (used by QMD, Claude Code sync scripts)
export VAULT_DIR="$HOME/Vault"
