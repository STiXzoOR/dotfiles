# atuin - shell history in SQLite: searchable, deduplicated, and not capped at
# SAVEHIST. Replaces nothing; ctrl-R goes to atuin, Up stays on prezto's
# history-substring-search.
#
# Sourced from .zshrc, after prezto and after .fzf. Prezto's editor module runs
# `bindkey -d`, so anything bound earlier is discarded, and `fzf --zsh` binds
# ctrl-R to its own history widget, so atuin has to come second to take that
# key (2026-09-21 tooling research, section 2).
#
# What loads depends on the host (system/.term_host):
#   rich  everything but the up-arrow binding.
#   warp  the recording hooks alone, so commands typed in Warp reach the same
#         history as every other terminal. No bindings: ctrl-R and ? stay with
#         Warp, whose docs list custom key bindings as a source of broken
#         input. --disable-ai is what removes the ? binding.
#   dumb  nothing: a `zsh -c` shell runs no precmd or preexec to record.
#
# Speed (about 11 ms of the login shell): `atuin init zsh` is cached per host
# in $XDG_CACHE_HOME, regenerated when missing, older than the atuin binary or
# older than this file (the flags below live here). The init script forks
# `atuin uuid` for the session id whenever ATUIN_SESSION is unset or belongs to
# another shell level, so that id is minted here in zsh first: 32 hex digits, a
# millisecond-ish timestamp, the pid and two random words.
if (( $+commands[atuin] )); then
  _atuin_flags=
  case "$DOTFILES_TERM_HOST" in
    dumb) ;;
    warp) _atuin_flags='--disable-up-arrow --disable-ctrl-r --disable-ai' ;;
    *) _atuin_flags='--disable-up-arrow' ;;
  esac

  if [[ "$DOTFILES_TERM_HOST" != dumb ]]; then
    if [[ -z "$ATUIN_SESSION" || "$ATUIN_SHLVL" != "$SHLVL" ]]; then
      zmodload zsh/datetime
      printf -v ATUIN_SESSION '%013x%05x%04x%010x' $(( EPOCHREALTIME * 1000000 )) $$ $RANDOM $(( RANDOM * RANDOM ))
      export ATUIN_SESSION ATUIN_SHLVL=$SHLVL
    fi

    _atuin_cache="${XDG_CACHE_HOME:-$HOME/.cache}/atuin-init-${DOTFILES_TERM_HOST}.zsh"
    if [[ ! -s "$_atuin_cache" || "$commands[atuin]" -nt "$_atuin_cache" || "${(%):-%x}" -nt "$_atuin_cache" ]]; then
      # Generated into a temp file beside the cache and moved into place, so an
      # interrupted or concurrent first login never leaves a truncated cache.
      mkdir -p "${_atuin_cache:h}"
      if atuin init zsh ${=_atuin_flags} >| "$_atuin_cache.$$" 2>/dev/null && [[ -s "$_atuin_cache.$$" ]]; then
        command mv -f "$_atuin_cache.$$" "$_atuin_cache"
      else
        command rm -f "$_atuin_cache.$$" "$_atuin_cache"
      fi
    fi
    [[ -s "$_atuin_cache" ]] && source "$_atuin_cache"
    unset _atuin_cache
  fi
  unset _atuin_flags
fi
